# One installed archive/configuration owns one target contract. This file is
# shared by SDK production and find_package consumers; never infer an ABI from
# a prefix name, VERSION.txt host label or the build machine architecture.
include_guard(GLOBAL)

# Resolve the architecture stamped into generated COFF objects from the
# compiler target, never from CMAKE_SYSTEM_PROCESSOR.  The latter is empty for
# MSVC Hostx64/arm64 and may describe the host for Hostx64/x86.
function(_jce_msvc_coff_arch OUT_VAR)
	set(_arch "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
	if(NOT _arch)
		set(_arch "${CMAKE_C_COMPILER_ARCHITECTURE_ID}")
	endif()
	if(NOT _arch)
		set(_arch "${MSVC_CXX_ARCHITECTURE_ID}")
	endif()
	if(NOT _arch)
		set(_arch "${MSVC_C_ARCHITECTURE_ID}")
	endif()
	string(TOLOWER "${_arch}" _arch)

	if(_arch MATCHES "^(x64|amd64|x86_64)$")
		set(_coff_arch x64)
	elseif(_arch MATCHES "^(x86|i[3-6]86)$")
		set(_coff_arch x86)
	elseif(_arch MATCHES "^(arm64|aarch64)$")
		set(_coff_arch arm64)
	elseif(_arch MATCHES "^(arm|armv7.*)$")
		set(_coff_arch arm)
	else()
		message(FATAL_ERROR
			"Unsupported MSVC target architecture for COFF: '${_arch}' "
			"(CMAKE_SYSTEM_PROCESSOR='${CMAKE_SYSTEM_PROCESSOR}')")
	endif()

	set(${OUT_VAR} "${_coff_arch}" PARENT_SCOPE)
endfunction()


# A probe result is cached only for this compiler target/flags identity.
# Switching OSX_ARCHITECTURES in an existing build cannot reuse a host result.
function(_jce_sdk_compile_arch LANG OUT_ARCH)
    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
    if(LANG STREQUAL "C")
        include(CheckCSourceCompiles)
    else()
        include(CheckCXXSourceCompiles)
    endif()
    set(_identity "${CMAKE_${LANG}_COMPILER};${CMAKE_${LANG}_COMPILER_VERSION};${CMAKE_${LANG}_COMPILER_TARGET};${CMAKE_${LANG}_FLAGS};${CMAKE_${LANG}_FLAGS_DEBUG};${CMAKE_${LANG}_FLAGS_RELEASE};${CMAKE_${LANG}_FLAGS_RELWITHDEBINFO};${CMAKE_${LANG}_FLAGS_MINSIZEREL};${CMAKE_OSX_ARCHITECTURES};${CMAKE_SYSROOT};${CMAKE_SYSTEM_NAME}")
    string(SHA256 _fingerprint "${_identity}")
    set(_arch "")
    foreach(_candidate x86_64 i686 aarch64 armv7 wasm32 wasm64)
        if(_candidate STREQUAL "x86_64")
            set(_condition "defined(__x86_64__) || defined(_M_X64)")
        elseif(_candidate STREQUAL "i686")
            set(_condition "defined(__i386__) || defined(_M_IX86)")
        elseif(_candidate STREQUAL "aarch64")
            set(_condition "defined(__aarch64__) || defined(_M_ARM64)")
        elseif(_candidate STREQUAL "armv7")
            set(_condition "defined(__arm__) || defined(_M_ARM)")
        elseif(_candidate STREQUAL "wasm32")
            set(_condition "defined(__wasm32__)")
        else()
            set(_condition "defined(__wasm64__)")
        endif()
        set(_source "#if !(${_condition})\n#error target_arch_mismatch\n#endif\nint jce_target_probe(void) { return 0; }\n")
        set(_probe JCE_SDK_COMPILER_TARGET_${_fingerprint}_${LANG}_${_candidate})
        if(LANG STREQUAL "C")
            check_c_source_compiles("${_source}" ${_probe})
        else()
            check_cxx_source_compiles("${_source}" ${_probe})
        endif()
        if(${_probe})
            set(_arch "${_candidate}")
            break()
        endif()
    endforeach()
    if(NOT _arch)
        message(FATAL_ERROR "JCE SDK target: unsupported ${LANG} compiler architecture")
    endif()
    set(${OUT_ARCH} "${_arch}" PARENT_SCOPE)
endfunction()

function(jce_sdk_compiler_target OUT_SYSTEM OUT_ARCH OUT_BITS)
    if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Windows|Linux|Darwin|Android|iOS|Emscripten)$")
        message(FATAL_ERROR "JCE SDK target: unsupported target system '${CMAKE_SYSTEM_NAME}'")
    endif()
    if(MSVC)
        _jce_msvc_coff_arch(_coff)
        if(_coff STREQUAL "x64")
            set(_arch x86_64)
        elseif(_coff STREQUAL "x86")
            set(_arch i686)
        elseif(_coff STREQUAL "arm64")
            set(_arch aarch64)
        else()
            set(_arch armv7)
        endif()
        if(CMAKE_C_COMPILER_ARCHITECTURE_ID AND CMAKE_CXX_COMPILER_ARCHITECTURE_ID
           AND NOT CMAKE_C_COMPILER_ARCHITECTURE_ID STREQUAL CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
            message(FATAL_ERROR "JCE SDK target: C and C++ compilers target different architectures")
        endif()
    else()
        if(APPLE AND CMAKE_OSX_ARCHITECTURES)
            list(LENGTH CMAKE_OSX_ARCHITECTURES _count)
            if(NOT _count EQUAL 1)
                message(FATAL_ERROR "JCE SDK target: universal SDKs require an explicit supported archive contract")
            endif()
        endif()
        # Compile target macros as a static library, never execute them.
        if(CMAKE_C_COMPILER_LOADED)
            _jce_sdk_compile_arch(C _arch)
        elseif(CMAKE_CXX_COMPILER_LOADED)
            _jce_sdk_compile_arch(CXX _arch)
        endif()
        if(CMAKE_C_COMPILER_LOADED AND CMAKE_CXX_COMPILER_LOADED)
            _jce_sdk_compile_arch(CXX _cxx_arch)
            if(NOT _cxx_arch STREQUAL _arch)
                message(FATAL_ERROR "JCE SDK target: C and C++ compilers target different architectures")
            endif()
        endif()
        if(NOT _arch)
            message(FATAL_ERROR "JCE SDK target: unsupported compiler target architecture")
        endif()
    endif()
    if(_arch MATCHES "^(i686|armv7|wasm32)$")
        set(_bits 32)
    else()
        set(_bits 64)
    endif()
    if(NOT CMAKE_SIZEOF_VOID_P MATCHES "^[48]$")
        message(FATAL_ERROR "JCE SDK target: compiler pointer size unavailable; enable C/CXX first")
    endif()
    math(EXPR _compiler_bits "${CMAKE_SIZEOF_VOID_P} * 8")
    if(NOT _compiler_bits EQUAL _bits)
        message(FATAL_ERROR "JCE SDK target: compiler architecture/pointer size disagree")
    endif()
    set(${OUT_SYSTEM} "${CMAKE_SYSTEM_NAME}" PARENT_SCOPE)
    set(${OUT_ARCH} "${_arch}" PARENT_SCOPE)
    set(${OUT_BITS} "${_bits}" PARENT_SCOPE)
endfunction()

# Schema 1 Windows archives declare the MSVC ABI and CRT. CMake's MSVC flag
# includes compatible frontends such as clang-cl; compiler brand alone does not.
# A GNU Windows SDK needs its own compatible archive/runtime contract.
function(_jce_sdk_require_schema1_compiler_abi OWNER)
    if(CMAKE_SYSTEM_NAME STREQUAL "Windows" AND NOT MSVC)
        message(FATAL_ERROR
            "SDK_ABI_MISMATCH: ${OWNER}: Windows schema1 requires an MSVC-compatible "
            "frontend (cl or clang-cl); GNU/LLVM-MinGW requires a separately produced compatible SDK")
    endif()
endfunction()

function(jce_sdk_generate_target_metadata OUTPUT_DIR ARCHIVE_TARGETS OUT_FILE OUT_CHECK)
    _jce_sdk_require_schema1_compiler_abi(producer)
    jce_sdk_compiler_target(_system _arch _bits)
    if(NOT JCE_BUILD_VARIANT MATCHES "^(debug|release|dist)$" OR
       NOT JCE_DELIVERY_PROFILE MATCHES "^(embedded|authoring)$")
        message(FATAL_ERROR "JCE SDK target: unsupported variant or delivery profile")
    endif()
    set(_crt none)
    set(_checks "")
    if(MSVC)
        set(_crt "")
        foreach(_target IN LISTS ARCHIVE_TARGETS)
            get_target_property(_runtime ${_target} MSVC_RUNTIME_LIBRARY)
            if(_runtime STREQUAL "_runtime-NOTFOUND")
                set(_runtime "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
            endif()
            # Empty explicitly means no compiler runtime flag, whose MSVC
            # default is /MT. SDK owners use the actual target property.
            set(_resolved "$<TARGET_GENEX_EVAL:${_target},${_runtime}>")
            set(_resolved "$<IF:$<BOOL:${_resolved}>,${_resolved},MultiThreaded>")
            if(NOT _crt)
                set(_crt "${_resolved}")
            else()
                string(APPEND _checks "if(NOT \"${_crt}\" STREQUAL \"${_resolved}\")\n message(FATAL_ERROR \"JCE SDK target: mixed owner CRT in ${_target}; rebuild a consistent SDK\")\nendif()\n")
            endif()
        endforeach()
        if(NOT _crt)
            message(FATAL_ERROR "JCE SDK target: no archive runtime owner")
        endif()
    endif()
    set(_file "${OUTPUT_DIR}/$<CONFIG>/jce-sdk-target.json")
    set(_check "${OUTPUT_DIR}/$<CONFIG>/jce-sdk-target-check.cmake")
    set(_json "{\n  \"schema\": 1,\n  \"system\": \"${_system}\",\n  \"arch\": \"${_arch}\",\n  \"pointer_bits\": ${_bits},\n  \"config\": \"$<CONFIG>\",\n  \"variant\": \"${JCE_BUILD_VARIANT}\",\n  \"delivery\": \"${JCE_DELIVERY_PROFILE}\",\n  \"crt\": \"${_crt}\",\n  \"archive\": \"jce_engine_core${CMAKE_STATIC_LIBRARY_SUFFIX}\"\n}\n")
    file(GENERATE OUTPUT "${_file}" CONTENT "${_json}")
    string(APPEND _checks "include(\"${CMAKE_SOURCE_DIR}/cmake/JCESDKTarget.cmake\")\njce_sdk_read_target(\"${_file}\" \"${_system}\" \"${_arch}\" ${_bits} \"$<CONFIG>\" \"${JCE_BUILD_VARIANT}\" \"${JCE_DELIVERY_PROFILE}\" _crt FALSE)\n")
    file(GENERATE OUTPUT "${_check}" CONTENT "${_checks}")
    set(${OUT_FILE} "${_file}" PARENT_SCOPE)
    set(${OUT_CHECK} "${_check}" PARENT_SCOPE)
endfunction()

# Shared schema validation; production install additionally checks all archive
# owners' resolved CRT before publishing either archives or their metadata.
function(jce_sdk_read_target FILE SYSTEM ARCH BITS CONFIG VARIANT DELIVERY OUT_CRT CHECK_ARCHIVE)
    if(NOT EXISTS "${FILE}" OR IS_DIRECTORY "${FILE}")
        message(FATAL_ERROR "JCE SDK target metadata missing: ${FILE}; refresh the SDK for ${SYSTEM}/${ARCH}/${CONFIG}")
    endif()
    file(SIZE "${FILE}" _size)
    if(_size GREATER 16384)
        message(FATAL_ERROR "JCE SDK target metadata too large; refresh the SDK")
    endif()
    file(READ "${FILE}" _json LIMIT 16385)
    string(LENGTH "${_json}" _size)
    if(_size GREATER 16384)
        message(FATAL_ERROR "JCE SDK target metadata grew during read; refresh the SDK")
    endif()
    # Generator-owned schema: its keys and every permitted string value are
    # fixed ASCII scalars. Escapes have no legitimate producer use. Reject them
    # before JSON folds decoded duplicate keys (including ar\\u0063h).
    string(FIND "${_json}" "\\" _escape)
    if(NOT _escape EQUAL -1)
        message(FATAL_ERROR "JCE SDK target metadata requires unescaped ASCII scalars; refresh the SDK")
    endif()
    string(JSON _type ERROR_VARIABLE _error TYPE "${_json}")
    if(_error OR NOT _type STREQUAL "OBJECT")
        message(FATAL_ERROR "JCE SDK target metadata malformed: ${FILE}; refresh the SDK")
    endif()
    # This is a deliberately flat schema of nine scalar keys. Counting key
    # occurrences also rejects duplicates, which CMake's JSON object folds.
    string(REGEX MATCHALL "\"[A-Za-z_]+\"[ \t\r\n]*:" _keys "${_json}")
    list(LENGTH _keys _key_count)
    string(JSON _count LENGTH "${_json}")
    if(NOT _key_count EQUAL 9 OR NOT _count EQUAL 9)
        message(FATAL_ERROR "JCE SDK target metadata has duplicate/unknown fields; refresh the SDK")
    endif()
    foreach(_key schema system arch pointer_bits config variant delivery crt archive)
        string(JSON _value_${_key} ERROR_VARIABLE _error GET "${_json}" ${_key})
        string(JSON _type ERROR_VARIABLE _type_error TYPE "${_json}" ${_key})
        if(_key STREQUAL "schema" OR _key STREQUAL "pointer_bits")
            set(_expected_type NUMBER)
        else()
            set(_expected_type STRING)
        endif()
        if(_error OR _type_error OR NOT _type STREQUAL _expected_type)
            message(FATAL_ERROR "JCE SDK target metadata invalid ${_key}; refresh the SDK")
        endif()
    endforeach()
    if(NOT _value_schema STREQUAL "1" OR
       NOT _value_system MATCHES "^(Windows|Linux|Darwin|Android|iOS|Emscripten)$" OR
       NOT _value_arch MATCHES "^(x86_64|i686|aarch64|armv7|wasm32|wasm64)$" OR
       NOT _value_config MATCHES "^(Debug|Release)$" OR
       NOT _value_variant MATCHES "^(debug|release|dist)$" OR
       NOT _value_delivery MATCHES "^(embedded|authoring)$")
        message(FATAL_ERROR "JCE SDK target metadata unsupported values; refresh the SDK")
    endif()
    if(_value_arch MATCHES "^(i686|armv7|wasm32)$")
        set(_declared_bits 32)
    else()
        set(_declared_bits 64)
    endif()
    if(NOT _value_pointer_bits STREQUAL "${_declared_bits}" OR
       NOT _value_pointer_bits STREQUAL "${BITS}" OR
       NOT _value_system STREQUAL SYSTEM OR NOT _value_arch STREQUAL ARCH OR
       NOT _value_config STREQUAL CONFIG OR
       (VARIANT AND NOT _value_variant STREQUAL VARIANT) OR
       (DELIVERY AND NOT _value_delivery STREQUAL DELIVERY))
        message(FATAL_ERROR "JCE SDK target mismatch at ${FILE}: SDK=${_value_system}/${_value_arch}/${_value_config}/${_value_variant}/${_value_delivery}, requested=${SYSTEM}/${ARCH}/${CONFIG}/${VARIANT}/${DELIVERY}; refresh/select the matching SDK")
    endif()
    if((_value_config STREQUAL "Debug" AND NOT _value_variant STREQUAL "debug") OR
       (_value_config STREQUAL "Release" AND _value_variant STREQUAL "debug"))
        message(FATAL_ERROR "JCE SDK target configuration/variant disagree; refresh the SDK")
    endif()
    if(SYSTEM STREQUAL "Windows")
        set(_archive jce_engine_core.lib)
        if(CONFIG STREQUAL "Debug")
            set(_runtime_regex "^MultiThreadedDebug(DLL)?$")
        else()
            set(_runtime_regex "^MultiThreaded(DLL)?$")
        endif()
        if(NOT _value_crt MATCHES "${_runtime_regex}" OR
           (_value_delivery STREQUAL "embedded" AND _value_crt MATCHES "DLL"))
            message(FATAL_ERROR "JCE SDK target CRT incompatible with configuration/delivery; refresh the SDK")
        endif()
    else()
        set(_archive jce_engine_core.a)
        if(NOT _value_crt STREQUAL "none")
            message(FATAL_ERROR "JCE SDK target has non-native CRT declaration; refresh the SDK")
        endif()
    endif()
    if(NOT _value_archive STREQUAL _archive)
        message(FATAL_ERROR "JCE SDK target archive name invalid; refresh the SDK")
    endif()
    if(CHECK_ARCHIVE)
        get_filename_component(_dir "${FILE}" DIRECTORY)
        if(NOT EXISTS "${_dir}/${_value_archive}" OR IS_DIRECTORY "${_dir}/${_value_archive}")
            message(FATAL_ERROR "JCE SDK target archive missing next to metadata; refresh the SDK")
        endif()
    endif()
    set(${OUT_CRT} "${_value_crt}" PARENT_SCOPE)
    set(JCE_SDK_TARGET_DELIVERY "${_value_delivery}" PARENT_SCOPE)
    set(JCE_SDK_TARGET_VARIANT "${_value_variant}" PARENT_SCOPE)
endfunction()

# Consumer policy may be a normal CMake Debug/Release runtime expression.
# Resolve that small standard vocabulary before adopting the SDK CRT. Unknown
# custom expressions fail closed rather than silently overriding user intent.
function(jce_sdk_check_consumer_crt CONFIG SDK_CRT)
    if(NOT DEFINED CMAKE_MSVC_RUNTIME_LIBRARY)
        return()
    endif()
    set(_requested "${CMAKE_MSVC_RUNTIME_LIBRARY}")
    while(_requested MATCHES "\\$<\\$<CONFIG:([A-Za-z]+)>:([A-Za-z]*)>")
        set(_gate "${CMAKE_MATCH_1}")
        set(_value "${CMAKE_MATCH_2}")
        if(NOT _gate STREQUAL CONFIG)
            set(_value "")
        endif()
        string(REGEX REPLACE "\\$<\\$<CONFIG:${_gate}>:[A-Za-z]*>" "${_value}" _requested "${_requested}")
    endwhile()
    if(NOT _requested)
        set(_requested MultiThreaded)
    endif()
    if(NOT _requested STREQUAL SDK_CRT)
        message(FATAL_ERROR "JCE SDK target CRT mismatch: requested '${_requested}', SDK '${SDK_CRT}' for ${CONFIG}; select a matching SDK/runtime policy")
    endif()
endfunction()

function(jce_sdk_admit_consumer LIB_DIR)
    _jce_sdk_require_schema1_compiler_abi(consumer)
    jce_sdk_compiler_target(_system _arch _bits)
    if(CMAKE_CONFIGURATION_TYPES)
        set(_configs ${CMAKE_CONFIGURATION_TYPES})
    elseif(CMAKE_BUILD_TYPE)
        set(_configs ${CMAKE_BUILD_TYPE})
    else()
        message(FATAL_ERROR "JCE SDK target: select CMAKE_BUILD_TYPE or CMAKE_CONFIGURATION_TYPES before find_package(JCE)")
    endif()
    set(_crt_expression "")
    foreach(_consumer_config IN LISTS _configs)
        if(_consumer_config STREQUAL "Debug")
            set(_config Debug)
        elseif(_consumer_config MATCHES "^(Release|RelWithDebInfo|MinSizeRel)$")
            set(_config Release)
        else()
            message(FATAL_ERROR "JCE SDK target: unsupported consumer configuration '${_consumer_config}'")
        endif()
        jce_sdk_read_target("${LIB_DIR}/${_config}/jce-sdk-target.json"
            "${_system}" "${_arch}" "${_bits}" "${_config}"
            "${JCE_BUILD_VARIANT}" "${JCE_DELIVERY_PROFILE}" _crt TRUE)
        if(MSVC)
            jce_sdk_check_consumer_crt("${_consumer_config}" "${_crt}")
            string(APPEND _crt_expression "$<$<CONFIG:${_consumer_config}>:${_crt}>")
        endif()
        if(_profile AND NOT _profile STREQUAL JCE_SDK_TARGET_DELIVERY)
            message(FATAL_ERROR "JCE SDK target: selected configurations have mixed delivery policies; refresh the SDK")
        endif()
        set(_profile "${JCE_SDK_TARGET_DELIVERY}")
    endforeach()
    set(JCE_MSVC_RUNTIME_LIBRARY "${_crt_expression}" PARENT_SCOPE)
    set(JCE_SDK_DELIVERY_PROFILE "${_profile}" PARENT_SCOPE)
    set(JCE_SDK_TARGET_SYSTEM "${_system}" PARENT_SCOPE)
    set(JCE_SDK_TARGET_ARCH "${_arch}" PARENT_SCOPE)
endfunction()
