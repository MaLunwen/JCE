# Verify only when renderer builds; the host baker can regenerate stale stock.
file(READ "${DATA}.json" _brdf_manifest)
foreach(_field schema size samples bytes channels byte_order)
    string(JSON _value GET "${_brdf_manifest}" "${_field}")
    if(_field STREQUAL "schema")
        set(_expected "1")
    elseif(_field STREQUAL "size")
        set(_expected "256")
    elseif(_field STREQUAL "samples")
        set(_expected "1024")
    elseif(_field STREQUAL "bytes")
        set(_expected "524288")
    elseif(_field STREQUAL "channels")
        set(_expected "RGBA16F")
    else()
        set(_expected "little")
    endif()
    if(NOT _value STREQUAL _expected)
        message(FATAL_ERROR "Unsupported stock BRDF metadata: ${_field}")
    endif()
endforeach()
file(SIZE "${DATA}" _data_size)
if(NOT _data_size EQUAL 524288)
    message(FATAL_ERROR "Incomplete stock BRDF data")
endif()
string(JSON _brdf_expected GET "${_brdf_manifest}" data_sha256)
file(SHA256 "${DATA}" _brdf_actual)
if(NOT _brdf_actual STREQUAL _brdf_expected)
    message(FATAL_ERROR "Stock BRDF data does not match its provenance manifest")
endif()
foreach(_kernel jce_ibl_sampling.h jce_ibl_brdf.h)
    string(JSON _kernel_expected GET "${_brdf_manifest}" kernel_sha256 "${_kernel}")
    file(SHA256 "${KERNEL_ROOT}/${_kernel}" _kernel_actual)
    if(NOT _kernel_actual STREQUAL _kernel_expected)
        message(FATAL_ERROR "Stock BRDF kernel changed; regenerate the baked reference")
    endif()
endforeach()
