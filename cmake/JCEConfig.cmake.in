@PACKAGE_INIT@

# JCEConfig.cmake — find_package(JCE) entry for end-user projects.
#
#   find_package(JCE REQUIRED)
#   add_executable(MyGame src/main.c)
#   target_link_libraries(MyGame PRIVATE JCE::JCE)

set(JCE_VERSION "@PROJECT_VERSION@")

set(_jce_include_dir "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set(_jce_lib_dir     "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@")
set(_jce_bin_dir     "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_BINDIR@")
set(_jce_share_dir   "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATAROOTDIR@/jce")

# ---- Engine-side runtime resources shipped with the SDK. ----------- #
# jce_target_embed_pak() prepends these to every consumer PAK so the
# engine can find its built-in RML documents (HUD/settings/pause), the
# fallback font, default shaders, etc.
if(IS_DIRECTORY "${_jce_share_dir}/engine_resources")
	set(JCE_ENGINE_RESOURCES_DIR "${_jce_share_dir}/engine_resources")
endif()
if(IS_DIRECTORY "${_jce_share_dir}/engine_ui")
	set(JCE_ENGINE_UI_DIR "${_jce_share_dir}/engine_ui")
endif()
if(EXISTS "${_jce_share_dir}/THIRD_PARTY_LICENSES.md")
	set(JCE_THIRD_PARTY_LICENSES_FILE "${_jce_share_dir}/THIRD_PARTY_LICENSES.md")
endif()

# ---- Host tools (jce_pak / jce_bin2obj / jce_cook). ---------------- #
# Native SDKs ship them in bin/; cross-compiled SDKs ship BUILD-HOST
# binaries in bin/host/ (they run on the machine that builds the game,
# not on the target).  find_program appends the host suffix (.exe)
# automatically and — unlike the previous EXISTS+CACHE FORCE probes —
# never clobbers a user-provided -DJCE_*_EXECUTABLE override.
# jce_add_pak() uses jce_cook+jce_pak+jce_bin2obj to cook+pack+embed
# real assets without the editor; the packaged editor instead passes
# prebuilt artifacts through JCE_PROJECT_PREBUILT_* variables.
foreach(_jce_tool_pair "PAK;jce_pak" "BIN2OBJ;jce_bin2obj" "COOK;jce_cook")
	list(GET _jce_tool_pair 0 _jce_tool_up)
	list(GET _jce_tool_pair 1 _jce_tool_name)
	find_program(JCE_${_jce_tool_up}_EXECUTABLE
		NAMES ${_jce_tool_name}
		HINTS "${_jce_bin_dir}" "${_jce_bin_dir}/host"
		NO_DEFAULT_PATH
		DOC "Path to the JCE host tool ${_jce_tool_name}.")
endforeach()
unset(_jce_tool_pair)
unset(_jce_tool_up)
unset(_jce_tool_name)

# All three found -> jce_add_pak() can cook+pack+embed turnkey. A cross
# SDK consumed on a DIFFERENT OS than it was built on will not find the
# tools (wrong host binaries) and jce_add_pak() degrades to raw packing
# with a warning.
set(JCE_HOST_TOOLS_FOUND FALSE)
if(JCE_COOK_EXECUTABLE AND JCE_PAK_EXECUTABLE AND JCE_BIN2OBJ_EXECUTABLE)
	set(JCE_HOST_TOOLS_FOUND TRUE)
endif()

set(_jce_core_release "${_jce_lib_dir}/Release/jce_engine_core@CMAKE_STATIC_LIBRARY_SUFFIX@")
set(_jce_core_debug   "${_jce_lib_dir}/Debug/jce_engine_core@CMAKE_STATIC_LIBRARY_SUFFIX@")
set(_jce_deps_release "${_jce_lib_dir}/Release/jce_engine_deps@CMAKE_STATIC_LIBRARY_SUFFIX@")
set(_jce_deps_debug   "${_jce_lib_dir}/Debug/jce_engine_deps@CMAKE_STATIC_LIBRARY_SUFFIX@")
set(_jce_msvc_stl_shims_release "${_jce_lib_dir}/Release/jce_msvc_stl_shims@CMAKE_STATIC_LIBRARY_SUFFIX@")
set(_jce_msvc_stl_shims_debug   "${_jce_lib_dir}/Debug/jce_msvc_stl_shims@CMAKE_STATIC_LIBRARY_SUFFIX@")

if(NOT EXISTS "${_jce_core_release}" AND NOT EXISTS "${_jce_core_debug}")
	set(JCE_FOUND FALSE)
	set(JCE_NOT_FOUND_MESSAGE
		"JCE: no fat lib under ${_jce_lib_dir} (looked for Release/Debug).")
	return()
endif()

# JCE::JCE points at the *core* (first-party) fat lib; the dependency
# fat lib is exposed as INTERFACE_LINK_LIBRARIES so the linker sees
# them on the command line WITHOUT /WHOLEARCHIVE.
add_library(JCE::JCE STATIC IMPORTED)

set_target_properties(JCE::JCE PROPERTIES
	INTERFACE_INCLUDE_DIRECTORIES "${_jce_include_dir}")

if(EXISTS "${_jce_core_release}")
	set_property(TARGET JCE::JCE APPEND PROPERTY IMPORTED_CONFIGURATIONS RELEASE)
	set_target_properties(JCE::JCE PROPERTIES
		IMPORTED_LOCATION_RELEASE             "${_jce_core_release}"
		IMPORTED_LINK_INTERFACE_LANGUAGES_RELEASE "CXX")
endif()
if(EXISTS "${_jce_core_debug}")
	set_property(TARGET JCE::JCE APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
	set_target_properties(JCE::JCE PROPERTIES
		IMPORTED_LOCATION_DEBUG             "${_jce_core_debug}"
		IMPORTED_LINK_INTERFACE_LANGUAGES_DEBUG "CXX")
endif()

if(EXISTS "${_jce_core_release}")
	set_target_properties(JCE::JCE PROPERTIES
		MAP_IMPORTED_CONFIG_RELWITHDEBINFO RELEASE
		MAP_IMPORTED_CONFIG_MINSIZEREL     RELEASE)
endif()

# Emscripten ships a Release-only wasm fat lib; a Debug-config consumer
# must still resolve to it (there is no Debug wasm archive).
if(EMSCRIPTEN AND EXISTS "${_jce_core_release}")
	set_target_properties(JCE::JCE PROPERTIES MAP_IMPORTED_CONFIG_DEBUG RELEASE)
endif()

# ---- Force-link the *core* fat lib only --------------------------- #
# jce_engine_core bundles every first-party JCE TU, including ones the
# user game never *explicitly* references (RmlUI binding, SDL_main,
# the window event pump, scene-renderer registration ctors, …).
# Without /WHOLEARCHIVE the linker drops those TUs as dead code,
# producing an exe that boots but has no HUD and ignores WM_CLOSE.
#
# jce_engine_deps (3rd-party) is linked *without* whole-archive so
# unused tooling code (e.g. protoc compiler TUs that need upb_*)
# stays dead-stripped and does not produce unresolved-symbol errors.
if(WIN32 AND MSVC)
	set_property(TARGET JCE::JCE APPEND PROPERTY
		INTERFACE_LINK_OPTIONS
			"$<$<CONFIG:Release>:/WHOLEARCHIVE:${_jce_core_release}>"
			"$<$<CONFIG:RelWithDebInfo>:/WHOLEARCHIVE:${_jce_core_release}>"
			"$<$<CONFIG:MinSizeRel>:/WHOLEARCHIVE:${_jce_core_release}>"
			"$<$<CONFIG:Debug>:/WHOLEARCHIVE:${_jce_core_debug}>")

	# 32-bit consumers: link the game exe /LARGEADDRESSAWARE so the WOW64
	# process gets the full ~4 GB on a 64-bit host instead of 2 GB.  The engine
	# (D3D12 reservations + embedded PAK + ImGui font atlas) exhausts 2 GB and a
	# failed allocation crashes in VCRUNTIME140!memset — same fix as the editor's
	# own build.  Harmless on 64-bit (already large-address-aware).
	if(CMAKE_SIZEOF_VOID_P EQUAL 4)
		set_property(TARGET JCE::JCE APPEND PROPERTY
			INTERFACE_LINK_OPTIONS "/LARGEADDRESSAWARE")
	endif()
elseif(EMSCRIPTEN)
	# Use CMake's portable LINKER: prefix, NOT a hand-written -Wl,.  emcc
	# expands `-Wl,a,b,c` by splitting on commas, so the literal form
	# `-Wl,--whole-archive,<lib>,-Wl,--no-whole-archive` forwards a stray
	# `-Wl` token to wasm-ld ("unknown argument: -Wl").  `LINKER:a,b,c`
	# becomes a single `-Wl,a,b,c` — one prefix, comma-separated sub-args.
	if(EXISTS "${_jce_core_release}")
		set_property(TARGET JCE::JCE APPEND PROPERTY
			INTERFACE_LINK_OPTIONS
				"$<$<NOT:$<CONFIG:Debug>>:LINKER:--whole-archive,${_jce_core_release},--no-whole-archive>")
	endif()
	if(EXISTS "${_jce_core_debug}")
		set_property(TARGET JCE::JCE APPEND PROPERTY
			INTERFACE_LINK_OPTIONS
				"$<$<CONFIG:Debug>:LINKER:--whole-archive,${_jce_core_debug},--no-whole-archive>")
	endif()
elseif(APPLE)
	if(EXISTS "${_jce_core_release}")
		set_property(TARGET JCE::JCE APPEND PROPERTY
			INTERFACE_LINK_OPTIONS
				"$<$<NOT:$<CONFIG:Debug>>:-Wl,-force_load,${_jce_core_release}>")
	endif()
	if(EXISTS "${_jce_core_debug}")
		set_property(TARGET JCE::JCE APPEND PROPERTY
			INTERFACE_LINK_OPTIONS
				"$<$<CONFIG:Debug>:-Wl,-force_load,${_jce_core_debug}>")
	endif()
elseif(UNIX)
	if(EXISTS "${_jce_core_release}")
		set_property(TARGET JCE::JCE APPEND PROPERTY
			INTERFACE_LINK_OPTIONS
				"$<$<NOT:$<CONFIG:Debug>>:LINKER:--whole-archive,${_jce_core_release},--no-whole-archive>")
	endif()
	if(EXISTS "${_jce_core_debug}")
		set_property(TARGET JCE::JCE APPEND PROPERTY
			INTERFACE_LINK_OPTIONS
				"$<$<CONFIG:Debug>:LINKER:--whole-archive,${_jce_core_debug},--no-whole-archive>")
	endif()
endif()

# ---- The 3rd-party fat lib: link normally (no whole-archive) ------ #
set(_jce_deps_genex "")
if(EXISTS "${_jce_deps_release}" AND EXISTS "${_jce_deps_debug}")
	set(_jce_deps_genex "$<IF:$<CONFIG:Debug>,${_jce_deps_debug},${_jce_deps_release}>")
elseif(EXISTS "${_jce_deps_release}")
	set(_jce_deps_genex "${_jce_deps_release}")
elseif(EXISTS "${_jce_deps_debug}")
	set(_jce_deps_genex "${_jce_deps_debug}")
endif()
if(_jce_deps_genex)
	set_property(TARGET JCE::JCE APPEND PROPERTY
		INTERFACE_LINK_LIBRARIES "${_jce_deps_genex}")
endif()

if(WIN32)
	set_property(TARGET JCE::JCE APPEND PROPERTY
		INTERFACE_LINK_LIBRARIES
			psapi user32 gdi32 winmm imm32 ole32 oleaut32 version uuid
			advapi32 setupapi shell32 ws2_32 dbghelp bcrypt
			rpcrt4 usp10)
	# Engine bundles C++ TUs (bgfx, RmlUI, ozz, Bullet, abseil, …).
	# When the consumer target is pure C, link.exe does not auto-pull
	# the MSVC C++ runtime, so STL helper symbols
	# (e.g. __std_find_first_of_trivial_pos_1) go unresolved.  Force
	# the dynamic C++ runtime here.  CMake selects /MD by default, so
	# msvcprt.lib (DLL flavour) is the right pick; downstream targets
	# that opt into the static CRT must override at their own scope.
	if(MSVC)
		set_property(TARGET JCE::JCE APPEND PROPERTY
			INTERFACE_LINK_LIBRARIES
				"$<$<NOT:$<CONFIG:Debug>>:msvcprt>"
				"$<$<CONFIG:Debug>:msvcprtd>")

		# Some MSVC runtimes miss STL helper exports while Conan-built
		# C++ deps reference them.  Keep the fallback as a normal static
		# archive, not whole-archive: link.exe pulls it only when the
		# symbol is unresolved after the runtime import libs.
		set(_jce_msvc_stl_shims_genex "")
		if(EXISTS "${_jce_msvc_stl_shims_release}" AND EXISTS "${_jce_msvc_stl_shims_debug}")
			set(_jce_msvc_stl_shims_genex "$<IF:$<CONFIG:Debug>,${_jce_msvc_stl_shims_debug},${_jce_msvc_stl_shims_release}>")
		elseif(EXISTS "${_jce_msvc_stl_shims_release}")
			set(_jce_msvc_stl_shims_genex "${_jce_msvc_stl_shims_release}")
		elseif(EXISTS "${_jce_msvc_stl_shims_debug}")
			set(_jce_msvc_stl_shims_genex "${_jce_msvc_stl_shims_debug}")
		endif()

		if(_jce_msvc_stl_shims_genex)
			set_property(TARGET JCE::JCE APPEND PROPERTY
				INTERFACE_LINK_LIBRARIES "${_jce_msvc_stl_shims_genex}")
		else()
			message(WARNING
				"JCE: this MSVC toolchain may require jce_msvc_stl_shims, "
				"but the SDK did not install it.")
		endif()
	endif()
elseif(EMSCRIPTEN)
	# libc++/libm/pthread are emcc built-ins; do NOT find_package(Threads)
	# or link dl/m (pthread would force SharedArrayBuffer + COOP/COEP).
	# The engine's WebGL2/GLES3 ABI link flags — every find_package consumer
	# inherits these via JCE::JCE.
	set_property(TARGET JCE::JCE APPEND PROPERTY
		INTERFACE_LINK_OPTIONS
			-sWASM=1 -sALLOW_MEMORY_GROWTH=1 -sMAX_WEBGL_VERSION=2
			-sMIN_WEBGL_VERSION=2 -sFULL_ES3=1 -sSTACK_SIZE=1048576
			-sMALLOC=emmalloc -lwebsocket.js
			"$<$<CONFIG:Debug>:-sASSERTIONS=1>")
	# -lwebsocket.js: jce_net_web.c (engine networking) uses the
	# emscripten_websocket_* JS API; the JS library must be linked into
	# every consumer or wasm-ld reports undefined symbols.
elseif(APPLE)
	set_property(TARGET JCE::JCE APPEND PROPERTY
		INTERFACE_LINK_LIBRARIES
			"-framework Cocoa" "-framework Metal" "-framework QuartzCore"
			"-framework IOKit" "-framework CoreVideo" "-framework CoreAudio"
			"-framework AudioToolbox" "-framework Carbon" "-framework ForceFeedback"
			"-framework GameController" "-framework CoreHaptics")
elseif(UNIX)
	find_package(Threads REQUIRED)
	set_property(TARGET JCE::JCE APPEND PROPERTY
		INTERFACE_LINK_LIBRARIES Threads::Threads ${CMAKE_DL_LIBS} m)
endif()

set(JCE_INCLUDE_DIRS "${_jce_include_dir}")
set(JCE_LIBRARIES    JCE::JCE)
set(JCE_FOUND        TRUE)

# ---- SDK helpers (jce_target_embed_pak, …). ----------------------- #
include("${CMAKE_CURRENT_LIST_DIR}/JCESDKHelpers.cmake" OPTIONAL)

check_required_components(JCE)
