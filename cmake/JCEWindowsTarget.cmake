# Windows OS floor is a target/ABI contract, independent of C++ language level.
# The default desktop lane retains the existing Windows 7 floor.
option(JCE_WINXP_LEGACY "Target XP using the verified LLVM-MinGW-XP toolchain" OFF)
if(JCE_WINXP_LEGACY)
    if(NOT CMAKE_C_COMPILER_ID STREQUAL "Clang" OR MSVC OR NOT MINGW)
        message(FATAL_ERROR "XP requires LLVM-MinGW-XP GNU ABI, not MSVC/clang-cl")
    endif()
    if(CMAKE_SIZEOF_VOID_P EQUAL 8 AND JCE_XP_TRIPLE STREQUAL "x86_64-w64-mingw32")
        set(_jce_windows_floor 0x0502)
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 4 AND JCE_XP_TRIPLE STREQUAL "i686-w64-mingw32")
        set(_jce_windows_floor 0x0501)
    else()
        message(FATAL_ERROR "XP requires an actual x86 or x64 target matching its toolchain")
    endif()
    if(NOT JCE_XP_WINNT STREQUAL _jce_windows_floor)
        message(FATAL_ERROR "XP toolchain and target Windows floor disagree")
    endif()
    add_compile_definitions(JCE_WINXP_LEGACY=1)
else()
    set(_jce_windows_floor 0x0601)
endif()
add_compile_definitions(_WIN32_WINNT=${_jce_windows_floor} WINVER=${_jce_windows_floor})
unset(_jce_windows_floor)
