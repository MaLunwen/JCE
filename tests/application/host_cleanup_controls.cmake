set(_host_cleanup_sdl "${CMAKE_SOURCE_DIR}/engine/src/application/jce_main_sdl.c")
set(_host_cleanup_jni "${CMAKE_SOURCE_DIR}/engine/src/application/jce_jni_bridge.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_host_cleanup_sdl}" "${_host_cleanup_jni}")
file(READ "${_host_cleanup_sdl}" _host_cleanup_sdl_source)
file(READ "${_host_cleanup_jni}" _host_cleanup_jni_source)
foreach(_host_cleanup_variant IN ITEMS current old_sdl_clear old_jni_free
        old_sdl_ack old_jni_ack old_sdl_final_refusal old_sdl_ack_before_free
        old_sdl_foreign_context old_sdl_reentrant_guard)
    set(_host_cleanup_target test_jce_host_cleanup)
    set(_host_cleanup_kind unit)
    set(_host_cleanup_selected_sdl "${_host_cleanup_sdl}")
    set(_host_cleanup_selected_jni "${_host_cleanup_jni}")
    if(NOT _host_cleanup_variant STREQUAL "current")
        set(_host_cleanup_kind contract)
        string(APPEND _host_cleanup_target "_${_host_cleanup_variant}")
        if(_host_cleanup_variant STREQUAL "old_sdl_clear")
            set(_host_cleanup_owner sdl)
            set(_host_cleanup_wire "            if (!jce_engine_try_destroy(&host->engine)) return SDL_APP_CONTINUE;")
            set(_host_cleanup_old "            (void)jce_engine_try_destroy(&host->engine); host->engine = NULL;")
        elseif(_host_cleanup_variant STREQUAL "old_jni_free")
            set(_host_cleanup_owner jni)
            set(_host_cleanup_wire "    if (!jce_engine_try_destroy(&bridge->engine)) {")
            set(_host_cleanup_old "    if (!jce_engine_try_destroy(&bridge->engine) && false) {")
        elseif(_host_cleanup_variant STREQUAL "old_sdl_ack")
            set(_host_cleanup_owner sdl)
            set(_host_cleanup_wire "static void jce_sdl_terminal_ack(uint64_t session, JceAppResult result)\n{")
            set(_host_cleanup_old "static void jce_sdl_terminal_ack(uint64_t session, JceAppResult result)\n{ return; /* omitted host acknowledgement */")
        elseif(_host_cleanup_variant STREQUAL "old_jni_ack")
            set(_host_cleanup_owner jni)
            set(_host_cleanup_wire "    (void)jce_engine_terminal_emit_internal(session, \"jni\", result, owner_empty);")
            set(_host_cleanup_old "    /* omitted JNI acknowledgement after actual owner return */")
        else()
            set(_host_cleanup_owner sdl)
            if(_host_cleanup_variant STREQUAL "old_sdl_final_refusal")
                set(_host_cleanup_wire "    if (!jce_engine_try_destroy(&host->engine)) {")
                set(_host_cleanup_old "    if (!jce_engine_try_destroy(&host->engine) && false) {")
            elseif(_host_cleanup_variant STREQUAL "old_sdl_ack_before_free")
                set(_host_cleanup_wire "    JCE_FREE(host);\n    jce_sdl_terminal_ack(session, terminal_result);")
                set(_host_cleanup_old "    jce_sdl_terminal_ack(session, terminal_result);\n    JCE_FREE(host);")
            elseif(_host_cleanup_variant STREQUAL "old_sdl_foreign_context")
                set(_host_cleanup_wire "    return SDL_IsMainThread() ? (JceSdlHost *)appstate : NULL;")
                set(_host_cleanup_old "    return (JceSdlHost *)appstate;")
            else()
                set(_host_cleanup_wire "    if (host->finalizing) return;")
                set(_host_cleanup_old "    /* old: reentrant final callback releases the same context twice */")
            endif()
        endif()
        set(_host_cleanup_source "${_host_cleanup_${_host_cleanup_owner}_source}")
        string(FIND "${_host_cleanup_source}" "${_host_cleanup_wire}" _host_cleanup_first)
        string(FIND "${_host_cleanup_source}" "${_host_cleanup_wire}" _host_cleanup_last REVERSE)
        if(_host_cleanup_first LESS 0 OR NOT _host_cleanup_first EQUAL _host_cleanup_last)
            message(FATAL_ERROR "Host cleanup needs one exact ${_host_cleanup_owner} ownership wire")
        endif()
        string(REPLACE "${_host_cleanup_wire}" "${_host_cleanup_old}"
            _host_cleanup_source "${_host_cleanup_source}")
        set(_host_cleanup_output "${CMAKE_CURRENT_BINARY_DIR}/host-cleanup/${_host_cleanup_variant}.c")
        jce_test_write_if_changed("${_host_cleanup_output}" "${_host_cleanup_source}")
        set(_host_cleanup_selected_${_host_cleanup_owner} "${_host_cleanup_output}")
    endif()
    jce_add_unit_test(${_host_cleanup_target} KIND ${_host_cleanup_kind}
        SOURCES test_jce_host_cleanup.c LINK jce_core
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src")
    target_include_directories(${_host_cleanup_target} BEFORE PRIVATE
        "${CMAKE_CURRENT_SOURCE_DIR}/host_cleanup_ports")
    target_compile_definitions(${_host_cleanup_target} PRIVATE
        JCE_TEST_SDL_HOST_OWNER="${_host_cleanup_selected_sdl}"
        JCE_TEST_JNI_HOST_OWNER="${_host_cleanup_selected_jni}")
    if(_host_cleanup_kind STREQUAL "contract")
        set_tests_properties(${_host_cleanup_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_host_cleanup_key IN ITEMS sdl jni sdl_source jni_source variant target kind
    selected_sdl selected_jni owner wire old source first last output)
    unset(_host_cleanup_${_host_cleanup_key})
endforeach()
unset(_host_cleanup_key)

# This is a Java host control, not the optional in-engine Java scripting VM.
# Reuse its already selected JDK when available; otherwise the runner reports
# unavailable explicitly when no paired javac/java is present on PATH.
find_package(Python3 COMPONENTS Interpreter QUIET)
if(Python3_Interpreter_FOUND)
    set(_host_java_home_args)
    if(JCE_JNI_INCLUDE_DIR)
        get_filename_component(_host_java_home "${JCE_JNI_INCLUDE_DIR}" DIRECTORY)
        set(_host_java_home_args --java-home "${_host_java_home}")
    endif()
    foreach(_host_java_variant IN ITEMS current old_java_clear old_main_abandon)
        set(_host_java_name test_jce_java_host_cleanup)
        set(_host_java_args)
        set(_host_java_kind unit)
        if(NOT _host_java_variant STREQUAL "current")
            string(APPEND _host_java_name "_${_host_java_variant}")
            set(_host_java_args --expect-assertion-failure)
            set(_host_java_kind contract)
        endif()
        add_test(NAME ${_host_java_name}
            COMMAND "${Python3_EXECUTABLE}"
                "${CMAKE_CURRENT_SOURCE_DIR}/test_jce_java_host_cleanup.py"
                --work-dir "${CMAKE_CURRENT_BINARY_DIR}/java-host-cleanup"
                --variant "${_host_java_variant}" ${_host_java_home_args} ${_host_java_args})
        set_tests_properties(${_host_java_name} PROPERTIES TIMEOUT 120 SKIP_RETURN_CODE 77
            ENVIRONMENT "${JCE_TEST_ENVIRONMENT}")
        set_property(GLOBAL APPEND PROPERTY JCE_TESTS_WITH_ENV ${_host_java_name})
        jce_set_test_kind("${_host_java_name}" "${_host_java_kind}")
    endforeach()
else()
    jce_test_suite_skipped("java-host-cleanup"
        "3 host ownership controls require Python3 to compile transformed full Java sources")
endif()
foreach(_host_java_key IN ITEMS home_args home variant name args kind)
    unset(_host_java_${_host_java_key})
endforeach()
unset(_host_java_key)
