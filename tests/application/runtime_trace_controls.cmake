# Complete shipping TU, actual Runtime/Scene, one allocator forwarding port.
set(_runtime_trace_owner "${CMAKE_SOURCE_DIR}/engine/src/application/jce_runtime.c")
set(_runtime_trace_helper "${CMAKE_SOURCE_DIR}/engine/src/application/jce_runtime_trace_internal.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_runtime_trace_owner}" "${_runtime_trace_helper}")
file(READ "${_runtime_trace_owner}" _runtime_trace_source)
file(READ "${_runtime_trace_helper}" _runtime_trace_current)
set(_runtime_trace_wire "return jce_trace_scope_begin(name);")
# Do not include the trailing C semicolon in a CMake list-valued match.
string(REGEX MATCHALL "return jce_trace_scope_begin[(]name[)]" _runtime_trace_wires "${_runtime_trace_current}")
list(LENGTH _runtime_trace_wires _runtime_trace_count)
if(NOT _runtime_trace_count EQUAL 1)
    message(FATAL_ERROR "Runtime trace control needs one actual scope admission wire")
endif()
string(REPLACE "${_runtime_trace_wire}"
    "JceTraceScope scope = {0}; (void)name; return scope;"
    _runtime_trace_old "${_runtime_trace_current}")
if(_runtime_trace_old STREQUAL _runtime_trace_current)
    message(FATAL_ERROR "Runtime trace control must replace its exact admission statement")
endif()
set(_runtime_trace_dir "${CMAKE_CURRENT_BINARY_DIR}/runtime-trace-mutation")
file(MAKE_DIRECTORY "${_runtime_trace_dir}")
set(_runtime_trace_old_helper "${_runtime_trace_dir}/jce_runtime_trace_old_missing_wire.h")
set(_runtime_trace_old_owner "${_runtime_trace_dir}/jce_runtime_old_missing_wire.c")
string(REPLACE "#include \"jce_runtime_trace_internal.h\""
    "#include \"${_runtime_trace_old_helper}\"" _runtime_trace_old_source "${_runtime_trace_source}")
if(_runtime_trace_old_source STREQUAL _runtime_trace_source)
    message(FATAL_ERROR "Runtime trace control must replace the actual helper include")
endif()
foreach(_runtime_trace_part IN ITEMS helper owner)
    set(_runtime_trace_content "${_runtime_trace_old}")
    if(_runtime_trace_part STREQUAL "owner")
        set(_runtime_trace_content "${_runtime_trace_old_source}")
    endif()
    set(_runtime_trace_output "${_runtime_trace_old_${_runtime_trace_part}}")
    unset(_runtime_trace_previous)
    if(EXISTS "${_runtime_trace_output}")
        file(READ "${_runtime_trace_output}" _runtime_trace_previous)
    endif()
    if(NOT _runtime_trace_previous STREQUAL _runtime_trace_content)
        file(WRITE "${_runtime_trace_output}" "${_runtime_trace_content}")
    endif()
endforeach()
foreach(_runtime_trace_variant IN ITEMS current old_missing_wire)
    set(_runtime_trace_target test_jce_runtime_trace)
    set(_runtime_trace_kind unit)
    set(_runtime_trace_selected "${_runtime_trace_owner}")
    if(_runtime_trace_variant STREQUAL "old_missing_wire")
        string(APPEND _runtime_trace_target "_old_missing_wire")
        set(_runtime_trace_kind contract)
        set(_runtime_trace_selected "${_runtime_trace_old_owner}")
    endif()
    jce_add_unit_test(${_runtime_trace_target} KIND ${_runtime_trace_kind}
        SOURCES test_jce_runtime_trace.c LINK JCE
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src" "${CMAKE_SOURCE_DIR}/engine/src/application")
    target_compile_definitions(${_runtime_trace_target} PRIVATE
        JCE_TEST_RUNTIME_TRACE_OWNER="${_runtime_trace_selected}")
    if(_runtime_trace_variant STREQUAL "old_missing_wire")
        set_tests_properties(${_runtime_trace_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_runtime_trace_variable IN ITEMS owner helper source current wire wires count old dir
    old_helper old_owner old_source part content output previous variant target kind selected)
    unset(_runtime_trace_${_runtime_trace_variable})
endforeach()
unset(_runtime_trace_variable)
