    target_compile_definitions(${_launch_fps_target} PRIVATE JCE_TEST_LAUNCH_FPS_OWNER="${_launch_fps_selected}")
    if(_launch_fps_kind STREQUAL "contract")
        set_tests_properties(${_launch_fps_target} PROPERTIES WILL_FAIL TRUE)
