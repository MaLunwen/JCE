foreach(_launch_boot_cleanup IN ITEMS owner source previous part begin end first first_last last last_last length create fallback join bind_begin bind_end anchor begin_first begin_last end_first end_last bind old_create current old variant path target kind)
    unset(_launch_boot_${_launch_boot_cleanup})
