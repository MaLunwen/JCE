foreach(_launch_fps_cleanup IN ITEMS owner source wire first last old old_path variant target kind selected)
    unset(_launch_fps_${_launch_fps_cleanup})
endforeach()
unset(_launch_fps_cleanup)

# Preserve the actual bootstrap ordering around the fallback early return.
# Shader/input/audio bodies are outside this CPU control's admission boundary.
set(_launch_boot_owner "${CMAKE_SOURCE_DIR}/engine/src/application/jce_engine.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_launch_boot_owner}")
file(READ "${_launch_boot_owner}" _launch_boot_source)
set(_launch_boot_previous -1)
foreach(_launch_boot_part IN ITEMS create fallback join)
    if(_launch_boot_part STREQUAL "create")
        set(_launch_boot_begin "    /* -- Renderer ------------------------------------------------- */")
        set(_launch_boot_end "    /* Record what the LADDER chose, so the next launch starts there.")
    elseif(_launch_boot_part STREQUAL "fallback")
        set(_launch_boot_begin "\n\n    if (jce_renderer_is_fallback(e->renderer)) {")
        set(_launch_boot_end "    /* -- Remaining subsystems ------------------------------------- */")
    else()
        set(_launch_boot_begin "headless_after_renderer:;")
        set(_launch_boot_end "    /* -- Asset manager -------------------------------------------- */")
    endif()
    string(FIND "${_launch_boot_source}" "${_launch_boot_begin}" _launch_boot_first)
    string(FIND "${_launch_boot_source}" "${_launch_boot_begin}" _launch_boot_first_last REVERSE)
    string(FIND "${_launch_boot_source}" "${_launch_boot_end}" _launch_boot_last)
    string(FIND "${_launch_boot_source}" "${_launch_boot_end}" _launch_boot_last_last REVERSE)
    if(_launch_boot_first LESS_EQUAL _launch_boot_previous OR
       NOT _launch_boot_first EQUAL _launch_boot_first_last OR
       _launch_boot_last LESS_EQUAL _launch_boot_first OR
       NOT _launch_boot_last EQUAL _launch_boot_last_last)
        message(FATAL_ERROR "Launch bootstrap requires unique actual ${_launch_boot_part} blocks in source order")
    endif()
    math(EXPR _launch_boot_length "${_launch_boot_last} - ${_launch_boot_first}")
    string(SUBSTRING "${_launch_boot_source}" ${_launch_boot_first} ${_launch_boot_length} _launch_boot_${_launch_boot_part})
    set(_launch_boot_previous ${_launch_boot_last})
endforeach()
set(_launch_boot_bind_begin "    if (e->launch_policy.vsync_present || e->launch_policy.fps_present) {")
set(_launch_boot_bind_end "    if (e->headless) goto headless_after_renderer;")
foreach(_launch_boot_anchor IN ITEMS begin end)
    string(FIND "${_launch_boot_create}" "${_launch_boot_bind_${_launch_boot_anchor}}" _launch_boot_${_launch_boot_anchor}_first)
    string(FIND "${_launch_boot_create}" "${_launch_boot_bind_${_launch_boot_anchor}}" _launch_boot_${_launch_boot_anchor}_last REVERSE)
    if(_launch_boot_${_launch_boot_anchor}_first LESS 0 OR
       NOT _launch_boot_${_launch_boot_anchor}_first EQUAL _launch_boot_${_launch_boot_anchor}_last)
        message(FATAL_ERROR "Launch bootstrap requires one actual common bind ${_launch_boot_anchor}")
    endif()
endforeach()
if(_launch_boot_end_first LESS_EQUAL _launch_boot_begin_first)
    message(FATAL_ERROR "Launch bootstrap bind/join order changed")
endif()
math(EXPR _launch_boot_length "${_launch_boot_end_first} - ${_launch_boot_begin_first}")
string(SUBSTRING "${_launch_boot_create}" ${_launch_boot_begin_first} ${_launch_boot_length} _launch_boot_bind)
string(REPLACE "${_launch_boot_bind}" "" _launch_boot_old_create "${_launch_boot_create}")
# Full actual scalar parsers and UI-resolution call, not a copied policy.
function(_jce_launch_boot_body begin end out)
    string(FIND "${_launch_boot_source}" "${begin}" first)
    string(FIND "${_launch_boot_source}" "${begin}" last REVERSE)
    string(FIND "${_launch_boot_source}" "${end}" finish)
    if(first LESS 0 OR NOT first EQUAL last OR finish LESS_EQUAL first)
        message(FATAL_ERROR "Launch bootstrap requires one complete owner body: ${begin}")
    endif()
    math(EXPR length "${finish} - ${first}")
    string(SUBSTRING "${_launch_boot_source}" ${first} ${length} body)
    set(${out} "${body}" PARENT_SCOPE)
endfunction()
_jce_launch_boot_body("static uint32_t read_positive_u32_env("
    "/* -- Fatal error dialog" _launch_boot_uint)
set(_launch_boot_ui "    const bool allow_error_dialog = jce_engine_window_policy_error_dialog(\n        e->headless, e->hidden_window, not_focusable);\n")
string(FIND "${_launch_boot_source}" "${_launch_boot_ui}" _launch_boot_ui_at)
if(_launch_boot_ui_at LESS 0)
    message(FATAL_ERROR "Launch bootstrap requires actual resolved UI policy")
endif()
set(_launch_boot_clock "    e->run_start_counter = jce_time_perf_counter();")
string(FIND "${_launch_boot_source}" "${_launch_boot_clock}" _launch_boot_clock_at)
string(FIND "${_launch_boot_source}" "${_launch_boot_clock}" _launch_boot_clock_last REVERSE)
string(FIND "${_launch_boot_source}" "    /* -- Asset manager" _launch_boot_assets_at)
if(_launch_boot_clock_at LESS_EQUAL _launch_boot_assets_at OR
   NOT _launch_boot_clock_at EQUAL _launch_boot_clock_last)
    message(FATAL_ERROR "Normal timed origin must remain after resource initialization")
endif()
set(_launch_boot_helpers "${CMAKE_CURRENT_BINARY_DIR}/launch-policy/bootstrap_helpers.inc.h")
jce_test_write_if_changed("${_launch_boot_helpers}"
    "${_launch_boot_uint}\nstatic void actual_late_run_clock(JceEngine *e)\n{\n${_launch_boot_clock}\n}\n")
set(_launch_boot_current "${_launch_boot_ui}\n${_launch_boot_create}\n${_launch_boot_fallback}\n${_launch_boot_join}")
# Reproduce the old omission by moving the same bind after fallback's return.
set(_launch_boot_old "${_launch_boot_ui}\n${_launch_boot_old_create}\n${_launch_boot_fallback}\n${_launch_boot_join}\n${_launch_boot_bind}")
set(_launch_boot_no_modal "${_launch_boot_current}")
string(REPLACE "if (allow_error_dialog)" "if (true)" _launch_boot_no_modal "${_launch_boot_no_modal}")
string(REPLACE "        LOG_WARN(LOG_TAG, \"%s\", warning);" "" _launch_boot_no_warning "${_launch_boot_current}")
if(_launch_boot_no_modal STREQUAL _launch_boot_current OR _launch_boot_no_warning STREQUAL _launch_boot_current)
    message(FATAL_ERROR "Bootstrap modal/log controls require actual changed wires")
endif()
string(FIND "${_launch_boot_create}" "    /* Finite budgets apply before any ready fallback or headless early return. */" _launch_boot_budget_at)
string(FIND "${_launch_boot_create}" "    if (e->headless) {" _launch_boot_headless_at)
if(_launch_boot_budget_at LESS 0 OR _launch_boot_headless_at LESS_EQUAL _launch_boot_budget_at)
    message(FATAL_ERROR "Common run budget must precede all Renderer ready paths")
endif()
math(EXPR _launch_boot_budget_len "${_launch_boot_headless_at} - ${_launch_boot_budget_at}")
string(SUBSTRING "${_launch_boot_create}" ${_launch_boot_budget_at} ${_launch_boot_budget_len} _launch_boot_budget)
string(REPLACE "${_launch_boot_budget}" "" _launch_boot_late_create "${_launch_boot_create}")
set(_launch_boot_late_budget "${_launch_boot_ui}\n${_launch_boot_late_create}\n${_launch_boot_fallback}\n${_launch_boot_join}\n${_launch_boot_budget}")
foreach(_launch_boot_variant IN ITEMS current old no_modal no_warning late_budget)
    set(_launch_boot_path "${CMAKE_CURRENT_BINARY_DIR}/launch-policy/bootstrap_${_launch_boot_variant}.inc.h")
    jce_test_write_if_changed("${_launch_boot_path}" "${_launch_boot_${_launch_boot_variant}}")
    set(_launch_boot_target test_jce_engine_launch_bootstrap)
    set(_launch_boot_kind unit)
    if(_launch_boot_variant STREQUAL "old")
        string(APPEND _launch_boot_target "_old_fallback_bind")
