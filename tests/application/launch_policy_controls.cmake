set(_launch_fps_wire "        if (s_frame_cap.launch_present) fps = s_frame_cap.launch_fps;")
string(FIND "${_launch_fps_source}" "${_launch_fps_wire}" _launch_fps_first)
string(FIND "${_launch_fps_source}" "${_launch_fps_wire}" _launch_fps_last REVERSE)
if(_launch_fps_first LESS 0 OR NOT _launch_fps_first EQUAL _launch_fps_last)
    message(FATAL_ERROR "Launch FPS control requires one actual sticky resolution wire")
