    elseif(NOT _launch_boot_variant STREQUAL "current")
        string(APPEND _launch_boot_target "_missing_${_launch_boot_variant}")
        set(_launch_boot_kind contract)
    endif()
    jce_add_unit_test(${_launch_boot_target} KIND ${_launch_boot_kind}
        SOURCES test_jce_engine_launch_bootstrap.c LINK jce_core
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src" "${CMAKE_SOURCE_DIR}/engine/src/application")
    target_compile_definitions(${_launch_boot_target} PRIVATE
        JCE_TEST_LAUNCH_BOOTSTRAP_OWNER="${_launch_boot_path}"
        JCE_TEST_LAUNCH_BOOTSTRAP_HELPERS="${_launch_boot_helpers}" JCE_DIST=1)
    if(_launch_boot_kind STREQUAL "contract")
        set_tests_properties(${_launch_boot_target} PROPERTIES WILL_FAIL TRUE)
    endif()
