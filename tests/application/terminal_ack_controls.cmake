# Actual headless Engine, complete terminal observer, real logger and capture.
if(EMSCRIPTEN)
    jce_test_suite_skipped("terminal-ack" "requires native headless Engine/capture")
    return()
endif()
set(_terminal_owner "${CMAKE_SOURCE_DIR}/engine/src/application/jce_engine.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_terminal_owner}")
file(READ "${_terminal_owner}" _terminal_source)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/terminal-ack")
foreach(_terminal_variant IN ITEMS current missing_tail missing_trace_session)
    set(_terminal_name test_jce_engine_terminal)
    set(_terminal_kind integration)
    set(_terminal_selected "${_terminal_owner}")
    if(NOT _terminal_variant STREQUAL "current")
        string(APPEND _terminal_name "_${_terminal_variant}")
        set(_terminal_kind contract)
        if(_terminal_variant STREQUAL "missing_tail")
            set(_terminal_wire "    jce_engine_terminal_finish_internal();")
        else()
            set(_terminal_wire "    jce_engine_terminal_trace_internal(cleanup_trace.id);")
        endif()
        string(FIND "${_terminal_source}" "${_terminal_wire}" _terminal_first)
        string(FIND "${_terminal_source}" "${_terminal_wire}" _terminal_last REVERSE)
        if(_terminal_first LESS 0 OR NOT _terminal_first EQUAL _terminal_last)
            message(FATAL_ERROR "Terminal ack needs one actual ${_terminal_variant} wire")
        endif()
        string(REPLACE "${_terminal_wire}" "    /* omitted terminal observation */"
            _terminal_mutated "${_terminal_source}")
        set(_terminal_selected "${CMAKE_CURRENT_BINARY_DIR}/terminal-ack/${_terminal_variant}.c")
        jce_test_write_if_changed("${_terminal_selected}" "${_terminal_mutated}")
    endif()
    jce_add_unit_test(${_terminal_name} KIND ${_terminal_kind}
        SOURCES test_jce_engine_terminal.c LINK JCE sdl::sdl bgfx::bgfx
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src" "${CMAKE_SOURCE_DIR}/engine/src/application"
            "${CMAKE_SOURCE_DIR}/tests/os/core/stubs")
    target_compile_definitions(${_terminal_name} PRIVATE JCE_BUILDING_ENGINE=1
        JCE_TEST_TERMINAL_ENGINE="${_terminal_selected}"
        JCE_TEST_TERMINAL_PREFIX="${CMAKE_CURRENT_BINARY_DIR}/terminal-ack/${_terminal_variant}")
    if(MSVC)
        target_compile_options(${_terminal_name} PRIVATE /Zc:preprocessor)
    endif()
    set_tests_properties(${_terminal_name} PROPERTIES
        ENVIRONMENT "${JCE_TEST_ENVIRONMENT};SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy;JCE_HEADLESS=1;JCE_BACKEND=noop;JCE_TRACE=1;JCE_TRACE_STREAM_MODE=threaded;JCE_TRACE_EXPORT=;JCE_PERF_LOG=0;JCE_MAX_FRAMES=;JCE_MAX_SECONDS=;JCE_KPI_FRAME_LOG=;JCE_KPI_ASSET_LOG=;JCE_SAMPLER=;JCE_KPI_FRAME_COUNT=0;JCE_LAUNCH_VSYNC=0;JCE_LAUNCH_TARGET_FPS=0")
    if(_terminal_kind STREQUAL "contract")
        set_tests_properties(${_terminal_name} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_terminal_key IN ITEMS owner source variant name kind selected wire first last mutated)
    unset(_terminal_${_terminal_key})
endforeach()
unset(_terminal_key)
