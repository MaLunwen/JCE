# Complete normal Editor exit body; the missing recorder call is a runtime control.
function(jce_editor_exit_recorder_controls)
    set(owner "${CMAKE_SOURCE_DIR}/editor/src/jce_editor_main.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${owner}")
    file(READ "${owner}" source)
    set(begin_marker "static void editor_app_exit(void *ud)\n")
    set(end_marker "\nstatic void editor_app_update(float dt, void *ud)")
    foreach(marker IN ITEMS begin_marker end_marker)
        string(FIND "${source}" "${${marker}}" first)
        string(FIND "${source}" "${${marker}}" last REVERSE)
        if(first LESS 0 OR NOT first EQUAL last)
            message(FATAL_ERROR "Editor exit actual-body ${marker} must be unique")
        endif()
    endforeach()
    string(FIND "${source}" "${begin_marker}" begin)
    string(FIND "${source}" "${end_marker}" end)
    if(end LESS_EQUAL begin)
        message(FATAL_ERROR "Editor exit actual-body extraction bounds invalid")
    endif()
    math(EXPR length "${end} - ${begin}")
    string(SUBSTRING "${source}" ${begin} ${length} body)
    set(wire "    jce_editor_recorder_stop();\n")
    string(FIND "${body}" "${wire}" first)
    string(FIND "${body}" "${wire}" last REVERSE)
    if(first LESS 0 OR NOT first EQUAL last)
        message(FATAL_ERROR "Editor exit requires one actual recorder-stop wire")
    endif()
    set(dir "${CMAKE_CURRENT_BINARY_DIR}/editor-exit-recorder")
    file(MAKE_DIRECTORY "${dir}")
    foreach(variant IN ITEMS current missing_wire)
        set(content "${body}")
        if(variant STREQUAL "missing_wire")
            string(REPLACE "${wire}"
                "    (void)0; /* Omitted recorder-stop contract control. */\n" content "${body}")
            if(content STREQUAL body)
                message(FATAL_ERROR "Editor exit missing-wire mutation did not change owner")
            endif()
        endif()
        set(path "${dir}/${variant}.inc.h")
        jce_test_write_if_changed("${path}" "${content}")
        file(READ "${path}" written)
        if(NOT written STREQUAL content)
            message(FATAL_ERROR "Editor exit compiler input differs from selected owner")
        endif()
        string(FIND "${written}" "${wire}" written_wire)
        if((variant STREQUAL "current" AND written_wire LESS 0) OR
           (variant STREQUAL "missing_wire" AND NOT written_wire LESS 0))
            message(FATAL_ERROR "Editor exit compiler input has wrong recorder-stop wire")
        endif()
        if(variant STREQUAL "current")
            set(target test_jce_editor_play_transaction)
        else()
            set(target test_jce_editor_exit_recorder_missing_wire)
            jce_add_cxx_test(${target} KIND contract
                SOURCES test_jce_editor_play_transaction.cpp)
            set_tests_properties(${target} PROPERTIES WILL_FAIL TRUE)
        endif()
        target_compile_features(${target} PRIVATE cxx_std_20)
        target_compile_definitions(${target} PRIVATE JCE_TEST_EDITOR_EXIT_BODY="${path}")
    endforeach()
endfunction()
jce_editor_exit_recorder_controls()
