# Actual shared decision, screenshot helper and complete Scene/Game Canvas tails.
# No renderer, window, GPU execution or image/performance evidence.
set(_vp_comp_common "${CMAKE_SOURCE_DIR}/editor/src/scene/jce_editor_viewport_common.h")
set(_vp_comp_scene "${CMAKE_SOURCE_DIR}/editor/src/scene/jce_editor_scene_render.cpp")
set(_vp_comp_game "${CMAKE_SOURCE_DIR}/editor/src/scene/jce_editor_game_render.cpp")
set(_vp_comp_sr "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene/jce_scene_renderer.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_vp_comp_common}" "${_vp_comp_scene}" "${_vp_comp_game}" "${_vp_comp_sr}")
file(READ "${_vp_comp_common}" _vp_comp_common_source)
file(READ "${_vp_comp_scene}" _vp_comp_scene_source)
file(READ "${_vp_comp_game}" _vp_comp_game_source)
file(READ "${_vp_comp_sr}" _vp_comp_sr_source)

function(_jce_vp_composite_slice OUTPUT INPUT START END)
    string(FIND "${INPUT}" "${START}" _first)
    string(FIND "${INPUT}" "${START}" _last REVERSE)
    string(FIND "${INPUT}" "${END}" _end)
    string(FIND "${INPUT}" "${END}" _end_last REVERSE)
    if(_first LESS 0 OR NOT _first EQUAL _last OR
       _end LESS_EQUAL _first OR NOT _end EQUAL _end_last)
        message(FATAL_ERROR "Viewport composite needs unique ordered actual bounds: ${START}")
    endif()
    math(EXPR _size "${_end} - ${_first}")
    string(SUBSTRING "${INPUT}" ${_first} ${_size} _body)
    set(${OUTPUT} "${_body}" PARENT_SCOPE)
endfunction()
_jce_vp_composite_slice(_vp_comp_helper "${_vp_comp_common_source}"
    "inline bool jce_editor_viewport_composite_postfx(" "/* Submit a headless read-back capture")
_jce_vp_composite_slice(_vp_comp_capture "${_vp_comp_common_source}"
    "inline bool jce_editor_viewport_screenshot_submit(" "/* Per-entity hardware-query occlusion culling")
_jce_vp_composite_slice(_vp_comp_game_tail "${_vp_comp_game_source}"
    "    uint16_t postfx_ui_fb = UINT16_MAX;" "    /* Physics debug wireframes")
_jce_vp_composite_slice(_vp_comp_scene_tail "${_vp_comp_scene_source}"
    "    const bool postfx_composited = jce_editor_viewport_composite_postfx(" "    ed_vp_mark(\"evp_uicanvas\"")
_jce_vp_composite_slice(_vp_comp_game_create "${_vp_comp_game_source}"
    "    g.postfx = jce_postfx_create(" "    /* Occlusion culler (Play / game-view)")
_jce_vp_composite_slice(_vp_comp_scene_create "${_vp_comp_sr_source}"
    "    sr->postfx_pipeline = jce_postfx_create(" "    LOG_INFO(LOG_TAG, \"[init] render queue\");")
set(_vp_comp_constants "")
foreach(_vp_comp_constant IN ITEMS POSTFX_BASE POSTFX_COMPOSITE UI SCREENSHOT)
    string(REGEX MATCHALL "JCE_EDITOR_VP_${_vp_comp_constant}_OFFSET[ ]*=[ ]*[0-9]+"
        _vp_comp_matches "${_vp_comp_common_source}")
    list(LENGTH _vp_comp_matches _vp_comp_count)
    if(NOT _vp_comp_count EQUAL 1)
        message(FATAL_ERROR "Viewport composite needs the actual ${_vp_comp_constant} offset")
    endif()
    string(APPEND _vp_comp_constants "enum { ${_vp_comp_matches} };\n")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_SOURCE_DIR}/engine/include/jce/renderer/jce_views.h")
file(READ "${CMAKE_SOURCE_DIR}/engine/include/jce/renderer/jce_views.h" _vp_comp_views)
string(REGEX MATCHALL "#define JCE_VIEW_EDITOR_GAME[ ]+[0-9]+" _vp_comp_bases "${_vp_comp_views}")
list(LENGTH _vp_comp_bases _vp_comp_base_count)
if(NOT _vp_comp_base_count EQUAL 1)
    message(FATAL_ERROR "Viewport composite needs the actual Game view base")
endif()
string(APPEND _vp_comp_constants "${_vp_comp_bases}\nconstexpr uint16_t GAME_VIEW_BASE = JCE_VIEW_EDITOR_GAME;\n")
set(_vp_comp_dir "${CMAKE_CURRENT_BINARY_DIR}/viewport-composite-controls")
file(MAKE_DIRECTORY "${_vp_comp_dir}")
foreach(_vp_comp_variant IN ITEMS current old_copy missing_canvas_guard missing_tail_guard old_direct_flip
        old_game_copy missing_overlay_wire missing_physics_guard missing_alias_guard
        missing_format_guard missing_extent_guard reject_zero_target bridge_capture_source)
    set(_vp_comp_body "${_vp_comp_helper}")
    set(_vp_comp_capture_body "${_vp_comp_capture}")
    set(_vp_comp_game_body "${_vp_comp_game_tail}")
    set(_vp_comp_target test_jce_editor_viewport_composite)
    set(_vp_comp_kind unit)
    if(NOT _vp_comp_variant STREQUAL "current")
        string(APPEND _vp_comp_target "_${_vp_comp_variant}")
        set(_vp_comp_kind contract)
        if(_vp_comp_variant STREQUAL "old_game_copy")
            set(_vp_comp_from "    const bool postfx_overlay = g.ui_canvas &&")
            set(_vp_comp_to "    const bool postfx_overlay = false && g.ui_canvas &&")
            set(_vp_comp_mutation_body "${_vp_comp_game_body}")
        elseif(_vp_comp_variant STREQUAL "missing_overlay_wire")
            set(_vp_comp_from "uint16_t ui_fb = postfx_overlay ? postfx_ui_fb\n            : jce_offscreen_target_get_frame_buffer(g.bridge);")
            set(_vp_comp_to "uint16_t ui_fb = jce_offscreen_target_get_frame_buffer(g.bridge);")
            set(_vp_comp_mutation_body "${_vp_comp_game_body}")
        elseif(_vp_comp_variant STREQUAL "missing_physics_guard")
            set(_vp_comp_from "    if (bridge_tail || !bridge || !renderer || !scene || !overlay_fb ||")
            set(_vp_comp_to "    if (!bridge || !renderer || !scene || !overlay_fb ||")
        elseif(_vp_comp_variant STREQUAL "missing_alias_guard")
            set(_vp_comp_from "    if (output.texture.idx == jce_offscreen_target_get_color_texture(bridge) ||\n        output.framebuffer == jce_offscreen_target_get_frame_buffer(bridge)) return false;")
            set(_vp_comp_to "    /* Ordinary control: omit actual bridge alias guard. */")
        elseif(_vp_comp_variant STREQUAL "missing_format_guard")
            set(_vp_comp_from "    if (output.format != bridge_format) return false;")
            set(_vp_comp_to "    (void)bridge_format;")
        elseif(_vp_comp_variant STREQUAL "missing_extent_guard")
            set(_vp_comp_from "!width || !height || output.width != width || output.height != height ||\n        bridge_width != width || bridge_height != height")
            set(_vp_comp_to "!width || !height || output.width != bridge_width || output.height != bridge_height")
        elseif(_vp_comp_variant STREQUAL "reject_zero_target")
            set(_vp_comp_from "        postfx_tex == UINT16_MAX || jce_renderer_origin_bottom_left() ||")
            set(_vp_comp_to "        postfx_tex == 0 || postfx_tex == UINT16_MAX || jce_renderer_origin_bottom_left() ||")
        elseif(_vp_comp_variant STREQUAL "bridge_capture_source")
            set(_vp_comp_from "    uint16_t source = postfx_tex;")
            set(_vp_comp_to "    uint16_t source = UINT16_MAX;")
            set(_vp_comp_mutation_body "${_vp_comp_capture_body}")
        elseif(_vp_comp_variant STREQUAL "old_direct_flip")
            set(_vp_comp_from "    const int yflip = jce_renderer_origin_bottom_left() ? 1 : 0;")
            set(_vp_comp_to "    const int yflip = postfx_tex != UINT16_MAX ? 1 : (jce_renderer_origin_bottom_left() ? 1 : 0);")
            set(_vp_comp_mutation_body "${_vp_comp_capture_body}")
        elseif(_vp_comp_variant STREQUAL "old_copy")
            set(_vp_comp_from "        if (!canvas_enabled || (scene && !has_canvas)) return false;")
            set(_vp_comp_to "        (void)has_canvas; /* Original unconditional bridge copy. */")
        elseif(_vp_comp_variant STREQUAL "missing_canvas_guard")
            set(_vp_comp_from "        if (canvas_enabled && scene)")
            set(_vp_comp_to "        if (false && canvas_enabled && scene)")
        else()
            set(_vp_comp_from "    if (!bridge_tail && renderer && !origin_bottom_left &&")
            set(_vp_comp_to "    (void)bridge_tail;\n    if (renderer && !origin_bottom_left &&")
        endif()
        if(NOT _vp_comp_variant STREQUAL "old_direct_flip" AND
           NOT _vp_comp_variant STREQUAL "bridge_capture_source" AND
           NOT _vp_comp_variant STREQUAL "old_game_copy" AND
           NOT _vp_comp_variant STREQUAL "missing_overlay_wire")
            set(_vp_comp_mutation_body "${_vp_comp_body}")
        endif()
        string(FIND "${_vp_comp_mutation_body}" "${_vp_comp_from}" _vp_comp_first)
        string(FIND "${_vp_comp_mutation_body}" "${_vp_comp_from}" _vp_comp_last REVERSE)
        if(_vp_comp_first LESS 0 OR NOT _vp_comp_first EQUAL _vp_comp_last)
            message(FATAL_ERROR "Viewport composite negative needs one actual ${_vp_comp_variant} wire")
        endif()
        string(REPLACE "${_vp_comp_from}" "${_vp_comp_to}" _vp_comp_mutation_body "${_vp_comp_mutation_body}")
        if(_vp_comp_variant STREQUAL "old_direct_flip" OR _vp_comp_variant STREQUAL "bridge_capture_source")
            set(_vp_comp_capture_body "${_vp_comp_mutation_body}")
        elseif(_vp_comp_variant STREQUAL "old_game_copy" OR _vp_comp_variant STREQUAL "missing_overlay_wire")
            set(_vp_comp_game_body "${_vp_comp_mutation_body}")
        else()
            set(_vp_comp_body "${_vp_comp_mutation_body}")
        endif()
    endif()
    set(_vp_comp_content "${_vp_comp_constants}${_vp_comp_body}\n${_vp_comp_capture_body}\nstatic void test_create_scene_postfx(ScenePipelineOwner *sr, const JcePakArchive *pak)\n{\n${_vp_comp_scene_create}}\nstatic void test_create_game_postfx(const JcePakArchive *pak)\n{\n${_vp_comp_game_create}}\nstatic void test_game_composite(JceScene *scene, uint32_t render_w, uint32_t render_h)\n{\n    const uint16_t base = GAME_VIEW_BASE;\n    const float render_dt = 0.0f;\n${_vp_comp_game_body}}\nstatic void test_scene_composite(JceScene *scene, uint32_t width, uint32_t height, uint32_t disp_w, uint32_t disp_h, bool tsr_active, int upscaler)\n{\n    const float dt_sec = 0.0f;\n    const float content_dt_sec = dt_sec;\n${_vp_comp_scene_tail}}\n")
    set(_vp_comp_output "${_vp_comp_dir}/${_vp_comp_variant}.inc.h")
    unset(_vp_comp_previous)
    if(EXISTS "${_vp_comp_output}")
        file(READ "${_vp_comp_output}" _vp_comp_previous)
    endif()
    if(NOT _vp_comp_previous STREQUAL _vp_comp_content)
        file(WRITE "${_vp_comp_output}" "${_vp_comp_content}")
    endif()
    jce_add_cxx_test(${_vp_comp_target} KIND ${_vp_comp_kind}
        SOURCES test_jce_editor_viewport_composite.cpp)
    target_compile_definitions(${_vp_comp_target} PRIVATE
        JCE_TEST_VIEWPORT_COMPOSITE_OWNER="${_vp_comp_output}")
    if(_vp_comp_kind STREQUAL "contract")
        set_tests_properties(${_vp_comp_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_vp_comp_var IN ITEMS common scene game sr common_source scene_source game_source sr_source
        helper capture capture_body game_tail game_body scene_tail game_create scene_create constants constant bases views base_count
        matches count from to first last dir variant body mutation_body target kind content output previous)
    unset(_vp_comp_${_vp_comp_var})
endforeach()
unset(_vp_comp_var)
