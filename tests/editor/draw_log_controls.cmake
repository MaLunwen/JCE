# Complete actual editor DrawLog init and row writer blocks, with real filesystem IO.
set(_draw_log_owner "${CMAKE_SOURCE_DIR}/editor/src/core/jce_editor.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_draw_log_owner}")
file(READ "${_draw_log_owner}" _draw_log_source)
function(_jce_draw_log_unique source needle output)
    string(FIND "${source}" "${needle}" first)
    string(FIND "${source}" "${needle}" last REVERSE)
    if(first LESS 0 OR NOT first EQUAL last)
        message(FATAL_ERROR "DrawLog fixture requires one actual source boundary: ${needle}")
    endif()
    set(${output} ${first} PARENT_SCOPE)
endfunction()
function(_jce_draw_log_block source first last output)
    _jce_draw_log_unique("${source}" "${first}" start)
    _jce_draw_log_unique("${source}" "${last}" end)
    math(EXPR length "${end} - ${start}")
    if(length LESS 1)
        message(FATAL_ERROR "DrawLog actual owner block is incomplete")
    endif()
    string(SUBSTRING "${source}" ${start} ${length} body)
    set(${output} "${body}" PARENT_SCOPE)
endfunction()
_jce_draw_log_block("${_draw_log_source}" "    const char *frame_kpi_path = getenv(\"JCE_KPI_DRAW_LOG\");" "    s_editor.active      = true;" _draw_log_init)
_jce_draw_log_block("${_draw_log_source}" "    if (s_editor.frame_kpi_path[0]) {" "    /* The renderer owns one asynchronous readback slot." _draw_log_update)
set(_draw_log_actual "void test_actual_draw_log_init()\n{\n${_draw_log_init}\n}\nvoid test_actual_draw_log_update(float dt)\n{\n${_draw_log_update}\n}\n")
set(_draw_log_dir "${CMAKE_CURRENT_BINARY_DIR}/draw-log-availability")
file(MAKE_DIRECTORY "${_draw_log_dir}")
foreach(_draw_log_variant IN ITEMS current missing_availability assume_available duplicate_gpu_query)
    set(_draw_log_content "${_draw_log_actual}")
    set(_draw_log_target test_jce_editor_draw_log)
    set(_draw_log_kind unit)
    if(NOT _draw_log_variant STREQUAL "current")
        set(_draw_log_target "test_jce_editor_draw_log_${_draw_log_variant}")
        set(_draw_log_kind contract)
        if(_draw_log_variant STREQUAL "duplicate_gpu_query")
            set(_draw_log_needle "const bool gpu_stats_available = jce_renderer_get_gpu_stats(&gpu_stats);")
            set(_draw_log_replacement "${_draw_log_needle}\n            (void)jce_renderer_get_gpu_stats(&gpu_stats);")
        else()
            set(_draw_log_needle "gpu_stats_available ? 1 : 0")
            if(_draw_log_variant STREQUAL "missing_availability")
                set(_draw_log_replacement "0")
            else()
                set(_draw_log_replacement "1")
            endif()
        endif()
        _jce_draw_log_unique("${_draw_log_content}" "${_draw_log_needle}" _draw_log_position)
        string(REPLACE "${_draw_log_needle}" "${_draw_log_replacement}" _draw_log_content "${_draw_log_content}")
    endif()
    set(_draw_log_path "${_draw_log_dir}/${_draw_log_variant}.inc.h")
    unset(_draw_log_previous)
    if(EXISTS "${_draw_log_path}")
        file(READ "${_draw_log_path}" _draw_log_previous)
    endif()
    if(NOT _draw_log_previous STREQUAL _draw_log_content)
        file(WRITE "${_draw_log_path}" "${_draw_log_content}")
    endif()
    jce_add_cxx_test(${_draw_log_target} KIND ${_draw_log_kind} SOURCES test_jce_editor_draw_log.cpp LINK jce_core)
    if(_draw_log_kind STREQUAL "contract")
        set_tests_properties(${_draw_log_target} PROPERTIES WILL_FAIL TRUE)
    endif()
    target_compile_features(${_draw_log_target} PRIVATE cxx_std_20)
    target_compile_definitions(${_draw_log_target} PRIVATE JCE_EDITOR_DRAW_LOG_OWNER="${_draw_log_path}")
endforeach()
foreach(_draw_log_var IN ITEMS owner source init update actual dir variant content target kind needle replacement position path previous)
    unset(_draw_log_${_draw_log_var})
endforeach()
unset(_draw_log_var)
