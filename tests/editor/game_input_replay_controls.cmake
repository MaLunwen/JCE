# Actual JIRC owner -> complete Editor bridge -> real Runtime/Lua pointer host.
set(_replay_bridge "${CMAKE_SOURCE_DIR}/editor/src/core/jce_editor_game_input_bridge.cpp")
file(READ "${_replay_bridge}" _replay_source)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_replay_bridge}")
set(_replay_wire "    if (!jce_input_snapshot_was_replayed(input)) {")
string(FIND "${_replay_source}" "${_replay_wire}" _replay_first)
string(FIND "${_replay_source}" "${_replay_wire}" _replay_last REVERSE)
if(_replay_first LESS 0 OR NOT _replay_first EQUAL _replay_last)
    message(FATAL_ERROR "Replay control requires the complete bridge's unique origin gate")
endif()
foreach(_replay_case IN ITEMS current old_replay_source)
    set(_replay_path "${_replay_bridge}")
    set(_replay_target test_jce_editor_game_input_replay)
    set(_replay_kind unit)
    if(_replay_case STREQUAL "old_replay_source")
        string(REPLACE "${_replay_wire}" "    if (true) { /* old bridge ignored applied replay */" _replay_old "${_replay_source}")
        set(_replay_path "${CMAKE_CURRENT_BINARY_DIR}/game-input-mutation/old_replay_source.cpp")
        jce_test_write_if_changed("${_replay_path}" "${_replay_old}")
        set(_replay_target test_jce_editor_game_input_replay_old_source)
        set(_replay_kind contract)
    endif()
    jce_add_cxx_test(${_replay_target} KIND ${_replay_kind}
        SOURCES test_jce_editor_game_input_replay.cpp "${_replay_path}"
        LINK JCE)
    # Isolate host files when positive and ordinary negative controls run together.
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/${_replay_target}-files")
    set_tests_properties(${_replay_target} PROPERTIES
        WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/${_replay_target}-files")
    if(_replay_case STREQUAL "old_replay_source")
        set_tests_properties(${_replay_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_replay_cleanup IN ITEMS bridge source wire first last case path target kind old)
    unset(_replay_${_replay_cleanup})
endforeach()
unset(_replay_cleanup)
