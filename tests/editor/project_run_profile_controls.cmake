# Complete profile owner plus exact Run gatherer and shared naming/layout bodies.
set(_profile_core "${CMAKE_SOURCE_DIR}/editor/src/core")
set(_profile_owner "${_profile_core}/jce_editor_build_profile.cpp")
set(_profile_gather_owner "${_profile_core}/jce_run_manager.cpp")
set(_profile_layout_owner "${_profile_core}/jce_project_build_target.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_profile_owner}" "${_profile_gather_owner}" "${_profile_layout_owner}")
file(READ "${_profile_owner}" _profile_source)
file(READ "${_profile_gather_owner}" _profile_gather_source)
file(READ "${_profile_layout_owner}" _profile_layout_source)
function(_jce_profile_between input begin end output)
    string(FIND "${input}" "${begin}" _begin)
    string(FIND "${input}" "${end}" _end)
    if(_begin LESS 0 OR _end LESS_EQUAL _begin)
        message(FATAL_ERROR "Project Run profile fixture source marker missing")
    endif()
    string(LENGTH "${begin}" _begin_length)
    math(EXPR _next "${_begin} + ${_begin_length}")
    string(SUBSTRING "${input}" ${_next} -1 _tail)
    string(FIND "${_tail}" "${begin}" _duplicate)
    if(NOT _duplicate EQUAL -1)
        message(FATAL_ERROR "Project Run profile fixture source marker ambiguous")
    endif()
    math(EXPR _length "${_end} - ${_begin}")
    string(SUBSTRING "${input}" ${_begin} ${_length} _body)
    set(${output} "${_body}" PARENT_SCOPE)
endfunction()
_jce_profile_between("${_profile_gather_source}" "static std::string resolve_executable("
    "\n/* 2-second graceful-stop window" _profile_gather)
_jce_profile_between("${_profile_layout_source}" "static bool has_exe_suffix("
    "\nconst char *jce_project_build_delivery(" _profile_layout)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/project-run-profile-controls")
foreach(_variant IN ITEMS normal old_seed missing_layout old_name)
    set(_owner "${_profile_owner}")
    set(_gather "${_profile_gather}")
    set(_kind integration)
    set(_target test_jce_project_run_profile)
    if(_variant STREQUAL "old_seed")
        string(REPLACE "if (!jce_editor_project_is_engine_workspace()) {" "if (false) {"
            _owner_source "${_profile_source}")
        if(_owner_source STREQUAL _profile_source)
            message(FATAL_ERROR "Project profile old-seed mutation disconnected")
        endif()
        set(_owner "${CMAKE_CURRENT_BINARY_DIR}/project-run-profile-controls/old_seed.cpp")
        file(CONFIGURE OUTPUT "${_owner}" CONTENT "${_owner_source}" @ONLY)
    elseif(_variant STREQUAL "missing_layout")
        string(REPLACE "if (project_mode && arch && project->project_root && project->project_root[0])"
            "if (false)" _gather "${_profile_gather}")
        if(_gather STREQUAL _profile_gather)
            message(FATAL_ERROR "Project Run layout mutation disconnected")
        endif()
    elseif(_variant STREQUAL "old_name")
        string(REPLACE "manifest_name ? project->output_exe : nullptr" "manifest_name ? nullptr : nullptr"
            _gather "${_profile_gather}")
        if(_gather STREQUAL _profile_gather)
            message(FATAL_ERROR "Project Run manifest-name mutation disconnected")
        endif()
    endif()
    if(NOT _variant STREQUAL "normal")
        set(_target "${_target}_${_variant}")
        set(_kind contract)
    endif()
    set(_gather_path "${CMAKE_CURRENT_BINARY_DIR}/project-run-profile-controls/${_variant}_gather.inc")
    set(_layout_path "${CMAKE_CURRENT_BINARY_DIR}/project-run-profile-controls/layout.inc")
    file(CONFIGURE OUTPUT "${_gather_path}" CONTENT "${_gather}" @ONLY)
    file(CONFIGURE OUTPUT "${_layout_path}" CONTENT "${_profile_layout}" @ONLY)
    jce_add_cxx_test(${_target}
        KIND ${_kind}
        SOURCES test_jce_project_run_profile.cpp "${_owner}"
            "${_profile_core}/jce_run_manager_resolve.cpp"
        INCLUDES "${_profile_core}")
    set_target_properties(${_target} PROPERTIES CXX_STANDARD 20)
    target_compile_definitions(${_target} PRIVATE
        JCE_TEST_PROJECT_RUN_GATHER="${_gather_path}"
        JCE_TEST_PROJECT_RUN_LAYOUT="${_layout_path}")
    if(NOT _variant STREQUAL "normal")
        set_tests_properties(${_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
