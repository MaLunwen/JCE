# Full Console implementation plus the actual shared log-ring owner. Widget
# observers still invoke the real ImGui CPU implementation. No renderer/window.
function(_jce_editor_register_console_viewport_controls)
    set(_owner "${CMAKE_SOURCE_DIR}/editor/src/panels/jce_panel_console.cpp")
    set(_panels_owner "${CMAKE_SOURCE_DIR}/editor/src/ui/jce_editor_panels.cpp")
    set(_host_owner "${CMAKE_SOURCE_DIR}/editor/src/core/jce_editor_host_services.h")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${_owner}" "${_panels_owner}" "${_host_owner}")
    file(READ "${_owner}" _source)
    file(READ "${_panels_owner}" _panels_source)
    file(READ "${_host_owner}" _host_source)
    set(_variants current)
    string(FIND "${_source}" "if (ImGui::IsRectVisible(row_start," _text_only)
    string(FIND "${_source}" "static void console_visible_range(" _optimized)
    if(NOT _text_only LESS 0)
        list(APPEND _variants old_full_text old_child_body old_clear_snapshot missing_shutdown)
    elseif(NOT _optimized LESS 0)
        list(APPEND _variants old_full_range old_child_body old_clear_snapshot)
    else()
        # This is the actual old owner used for the first ordinary RED. Once
        # clipping exists, every individually restored old wire is required.
        set(_old_loop "for (size_t vi = 0; vi < visible_idx.size(); ++vi)")
        string(FIND "${_source}" "${_old_loop}" _old_first)
        string(FIND "${_source}" "${_old_loop}" _old_last REVERSE)
        if(_old_first LESS 0 OR NOT _old_first EQUAL _old_last)
            message(FATAL_ERROR "Console initial ordinary RED requires its unique actual all-row loop")
        endif()
    endif()
    list(APPEND _variants missing_startup missing_hidden_drain old_presentation_gate)
    foreach(_variant IN LISTS _variants)
        set(_body "${_source}")
        set(_panels_body "${_panels_source}")
        set(_host_body "${_host_source}")
        set(_target test_jce_editor_console_viewport)
        set(_kind integration)
        if(_variant STREQUAL "old_full_text")
            set(_before "if (ImGui::IsRectVisible(row_start,\n                ImVec2(row_start.x + bounds.width, row_start.y + bounds.height))) {")
            set(_after "if (true) { /* ordinary original full-Text submission */")
        elseif(_variant STREQUAL "old_full_range")
            set(_before "for (size_t vi = first; vi < last; ++vi)")
            set(_after "for (size_t vi = 0; vi < visible_idx.size(); ++vi)")
        elseif(_variant STREQUAL "old_child_body")
            set(_before "if (ImGui::BeginChild(\"ConsoleScroll\", ImVec2(0, -cmd_h), ImGuiChildFlags_None,\n                       ImGuiWindowFlags_HorizontalScrollbar)) {")
            set(_after "{ ImGui::BeginChild(\"ConsoleScroll\", ImVec2(0, -cmd_h), ImGuiChildFlags_None,\n                       ImGuiWindowFlags_HorizontalScrollbar);")
        elseif(_variant STREQUAL "old_clear_snapshot")
            set(_before "    s_ui.layout_font = ConsoleLayoutFont{};\n}")
            set(_after "    s_ui.layout_font = ConsoleLayoutFont{};\n    s_ui.rows.clear();\n    s_ui.visible_idx.clear();\n    s_ui.layout.clear();\n}")
        elseif(_variant STREQUAL "old_presentation_gate")
            set(_before "    if (!presentation_admitted) return;")
            set(_after "    (void)presentation_admitted; /* ordinary covered-content old owner */")
        elseif(_variant STREQUAL "missing_startup")
            set(_before "    jce_editor_panel_console_init();")
            set(_after "    /* ordinary old lazy-only Console startup */")
        elseif(_variant STREQUAL "missing_hidden_drain")
            set(_before "    JCE_EDITOR_HOST_SERVICE_CALL(\"editor.cpu_services.console\", jce_editor_panel_console_poll());")
            set(_after "    /* ordinary old hidden Console without CPU drain */")
        elseif(_variant STREQUAL "missing_shutdown")
            set(_before "    jce_editor_panel_console_shutdown();")
            set(_after "    /* ordinary missing Console owner shutdown wire */")
        endif()
        if(NOT _variant STREQUAL "current")
            set(_mutation_input "${_body}")
            if(_variant STREQUAL "missing_shutdown" OR _variant STREQUAL "missing_startup")
                set(_mutation_input "${_panels_body}")
            elseif(_variant STREQUAL "missing_hidden_drain")
                set(_mutation_input "${_host_body}")
            endif()
            string(FIND "${_mutation_input}" "${_before}" _first)
            string(FIND "${_mutation_input}" "${_before}" _last REVERSE)
            if(_first LESS 0 OR NOT _first EQUAL _last)
                message(FATAL_ERROR "Console ${_variant} mutation wire must be unique")
            endif()
            string(REPLACE "${_before}" "${_after}" _mutation_output "${_mutation_input}")
            if(_mutation_output STREQUAL _mutation_input)
                message(FATAL_ERROR "Console ${_variant} mutation did not change its actual owner")
            endif()
            if(_variant STREQUAL "missing_shutdown" OR _variant STREQUAL "missing_startup")
                set(_panels_body "${_mutation_output}")
            elseif(_variant STREQUAL "missing_hidden_drain")
                set(_host_body "${_mutation_output}")
            else()
                set(_body "${_mutation_output}")
            endif()
            set(_target "test_jce_editor_console_viewport_${_variant}")
            set(_kind contract)
        endif()
        set(_path "${CMAKE_CURRENT_BINARY_DIR}/console-viewport/${_variant}.inc.cpp")
        jce_test_write_if_changed("${_path}" "${_body}")
        file(READ "${_path}" _written)
        if(NOT _written STREQUAL _body)
            message(FATAL_ERROR "Console compiler input differs from the selected complete owner")
        endif()
        set(_panels_path "${CMAKE_CURRENT_BINARY_DIR}/console-viewport/${_variant}-panels.cpp")
        jce_test_write_if_changed("${_panels_path}" "${_panels_body}")
        file(READ "${_panels_path}" _written)
        if(NOT _written STREQUAL _panels_body)
            message(FATAL_ERROR "Console shared owner compiler input differs from selected complete owner")
        endif()
        set(_host_path "${CMAKE_CURRENT_BINARY_DIR}/console-viewport/${_variant}-host.h")
        jce_test_write_if_changed("${_host_path}" "${_host_body}")
        file(READ "${_host_path}" _written)
        if(NOT _written STREQUAL _host_body)
            message(FATAL_ERROR "Console host compiler input differs from selected complete owner")
        endif()
        jce_add_cxx_test(${_target} KIND ${_kind}
            SOURCES test_jce_editor_console_viewport.cpp
                "${_panels_path}"
            INCLUDES "${CMAKE_SOURCE_DIR}/editor/src" "${CMAKE_SOURCE_DIR}/editor/src/ui"
                "${CMAKE_SOURCE_DIR}/editor/src/core"
            LINK jce_core jce_tools_imgui)
        target_compile_features(${_target} PRIVATE cxx_std_20)
        target_compile_definitions(${_target} PRIVATE
            JCE_TEST_CONSOLE_OWNER="${_path}" JCE_TEST_CONSOLE_HOST_OWNER="${_host_path}")
        if(_kind STREQUAL "contract")
            set_tests_properties(${_target} PROPERTIES WILL_FAIL TRUE)
        endif()
    endforeach()
endfunction()
_jce_editor_register_console_viewport_controls()
