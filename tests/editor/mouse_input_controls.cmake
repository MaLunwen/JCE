# Complete actual event consumer; ImGui queue and SmallButton are linked, not ports.
function(jce_editor_mouse_input_controls)
    set(owner "${CMAKE_SOURCE_DIR}/editor/src/core/jce_editor.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${owner}")
    file(READ "${owner}" source)
    set(start_marker "bool jce_editor_process_event(const JceEvent *event)")
    set(end_marker "/* CPU-only host maintenance; independent of ImGui/render frame admission. */")
    foreach(boundary IN ITEMS start end)
        string(FIND "${source}" "${${boundary}_marker}" first)
        string(FIND "${source}" "${${boundary}_marker}" last REVERSE)
        if(first LESS 0 OR NOT first EQUAL last)
            message(FATAL_ERROR "Mouse event ${boundary} owner boundary must be unique")
        endif()
        set(${boundary} ${first})
    endforeach()
    if(end LESS_EQUAL start)
        message(FATAL_ERROR "Mouse event actual owner boundaries are reversed")
    endif()
    math(EXPR length "${end} - ${start}")
    string(SUBSTRING "${source}" ${start} ${length} actual)
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/mouse-input-control")
    file(MAKE_DIRECTORY "${directory}")
    set(path "${directory}/jce_editor_mouse_input_actual.h")
    if(EXISTS "${path}")
        file(READ "${path}" previous)
    endif()
    if(NOT previous STREQUAL actual)
        file(WRITE "${path}" "${actual}")
    endif()
    file(READ "${path}" written)
    if(NOT written STREQUAL actual)
        message(FATAL_ERROR "Mouse event actual compiler input differs from source")
    endif()
    jce_add_cxx_test(test_jce_editor_mouse_input KIND integration
        SOURCES test_jce_editor_mouse_input.cpp LINK jce_core jce_tools_imgui)
    target_compile_features(test_jce_editor_mouse_input PRIVATE cxx_std_20)
    target_compile_definitions(test_jce_editor_mouse_input PRIVATE
        JCE_EDITOR_MOUSE_INPUT_OWNER="${path}")
    # The complete same consumer, restoring only its former absent button position.
    set(position_wire "            io.AddMousePosEvent(event->button.x, event->button.y);")
    string(FIND "${actual}" "${position_wire}" first)
    string(FIND "${actual}" "${position_wire}" last REVERSE)
    if(first LESS 0 OR NOT first EQUAL last)
        message(FATAL_ERROR "Mouse old-position mutation needs one actual position wire")
    endif()
    string(REPLACE "${position_wire}\n" "" old_button_position "${actual}")
    if(old_button_position STREQUAL actual)
        message(FATAL_ERROR "Mouse old-position mutation did not change the actual owner")
    endif()
    set(path "${directory}/jce_editor_mouse_input_old_button_position.h")
    unset(previous)
    if(EXISTS "${path}")
        file(READ "${path}" previous)
    endif()
    if(NOT previous STREQUAL old_button_position)
        file(WRITE "${path}" "${old_button_position}")
    endif()
    file(READ "${path}" written)
    if(NOT written STREQUAL old_button_position)
        message(FATAL_ERROR "Mouse old-position compiler input differs from its mutation")
    endif()
    jce_add_cxx_test(test_jce_editor_mouse_input_old_button_position KIND contract
        SOURCES test_jce_editor_mouse_input.cpp LINK jce_core jce_tools_imgui)
    target_compile_features(test_jce_editor_mouse_input_old_button_position PRIVATE cxx_std_20)
    target_compile_definitions(test_jce_editor_mouse_input_old_button_position PRIVATE
        JCE_EDITOR_MOUSE_INPUT_OWNER="${path}")
    set_tests_properties(test_jce_editor_mouse_input_old_button_position PROPERTIES WILL_FAIL TRUE)
endfunction()
jce_editor_mouse_input_controls()
