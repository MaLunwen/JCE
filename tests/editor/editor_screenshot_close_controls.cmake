# Actual Core poll and complete shutdown-observer operation; no UI/window.
function(jce_editor_screenshot_close_controls)
    set(owner "${CMAKE_SOURCE_DIR}/editor/src/core/jce_editor.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${owner}")
    file(READ "${owner}" source)
    set(poll_begin "static void screenshot_poll_()\n")
    set(poll_end "\nbool jce_editor_request_screenshot(")
    set(close_begin "    /* Closing the observer does not certify an unfinished backend write. */")
    set(close_end "    if (s_editor.text_input_active && s_editor.window) {")
    foreach(part IN ITEMS poll close)
        foreach(boundary IN ITEMS begin end)
            string(FIND "${source}" "${${part}_${boundary}}" first)
            string(FIND "${source}" "${${part}_${boundary}}" last REVERSE)
            if(first LESS 0 OR NOT first EQUAL last)
                message(FATAL_ERROR "Screenshot close ${part}/${boundary} must be unique")
            endif()
            set(${part}_${boundary}_offset "${first}")
        endforeach()
        if(${part}_end_offset LESS_EQUAL ${part}_begin_offset)
            message(FATAL_ERROR "Screenshot close ${part} bounds are invalid")
        endif()
        math(EXPR length "${${part}_end_offset} - ${${part}_begin_offset}")
        string(SUBSTRING "${source}" ${${part}_begin_offset} ${length} ${part})
    endforeach()
    set(dir "${CMAKE_CURRENT_BINARY_DIR}/editor-screenshot-close")
    file(MAKE_DIRECTORY "${dir}")
    set(wire "    jce_renderer_readback_capture_flush();\n")
    string(FIND "${close}" "${wire}" first)
    string(FIND "${close}" "${wire}" last REVERSE)
    if(first LESS 0 OR NOT first EQUAL last)
        message(FATAL_ERROR "Screenshot close requires one actual CPU flush wire")
    endif()
    foreach(variant IN ITEMS current missing_flush late_flush)
        set(selected "${close}")
        if(variant STREQUAL "missing_flush" OR variant STREQUAL "late_flush")
            string(REPLACE "${wire}" "" selected "${close}")
            if(variant STREQUAL "late_flush")
                string(REPLACE "    screenshot_poll_();\n"
                    "    screenshot_poll_();\n${wire}" selected "${selected}")
            endif()
        endif()
        set(path "${dir}/${variant}.inc.h")
        set(content "${poll}\nstatic void test_actual_screenshot_close()\n{\n${selected}}\n")
        jce_test_write_if_changed("${path}" "${content}")
        if(variant STREQUAL "current")
            set(target test_jce_editor_screenshot_completion)
        else()
            set(target test_jce_editor_screenshot_${variant})
            jce_add_cxx_test(${target} KIND contract
                SOURCES test_jce_editor_screenshot_completion.cpp)
            set_tests_properties(${target} PROPERTIES WILL_FAIL TRUE)
        endif()
        target_compile_definitions(${target} PRIVATE
            JCE_TEST_EDITOR_SCREENSHOT_CLOSE_BODY="${path}")
    endforeach()
endfunction()
jce_editor_screenshot_close_controls()
