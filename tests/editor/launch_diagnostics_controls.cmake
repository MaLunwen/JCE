# Private launch selectors: actual helpers/branches with counted process-environment ports.
function(jce_editor_launch_diagnostics_controls)
    foreach(name IN ITEMS core metrics state main internal)
        if("${name}" STREQUAL "core")
            set(owner "editor/src/core/jce_editor.cpp")
        elseif("${name}" STREQUAL "metrics")
            set(owner "editor/src/core/jce_editor_operation_metrics.cpp")
        elseif("${name}" STREQUAL "state")
            set(owner "editor/src/core/jce_editor_state.cpp")
        elseif("${name}" STREQUAL "main")
            set(owner "editor/src/jce_editor_main.cpp")
        else()
            set(owner "editor/src/core/jce_editor_state_internal.h")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/${owner}")
        file(READ "${CMAKE_SOURCE_DIR}/${owner}" ${name})
    endforeach()
    function(_jce_editor_launch_extract output source begin end)
        foreach(boundary IN ITEMS begin end)
            string(FIND "${source}" "${${boundary}}" first)
            string(FIND "${source}" "${${boundary}}" last REVERSE)
            if(first LESS 0 OR NOT first EQUAL last)
                message(FATAL_ERROR "Launch diagnostic ${output} ${boundary} boundary must be unique")
            endif()
            set(${boundary}_offset ${first})
        endforeach()
        if(end_offset LESS_EQUAL begin_offset)
            message(FATAL_ERROR "Launch diagnostic ${output} owner boundaries are reversed")
        endif()
        math(EXPR length "${end_offset} - ${begin_offset}")
        string(SUBSTRING "${source}" ${begin_offset} ${length} body)
        set(${output} "${body}" PARENT_SCOPE)
    endfunction()
    function(_jce_editor_launch_require_wire source wire count)
        string(REPLACE "${wire}" "" without "${source}")
        string(LENGTH "${source}" before)
        string(LENGTH "${without}" after)
        string(LENGTH "${wire}" size)
        math(EXPR expected "${size} * ${count}")
        math(EXPR actual "${before} - ${after}")
        if(NOT actual EQUAL expected)
            message(FATAL_ERROR "Launch diagnostics require ${count} actual lifecycle wire(s), found bytes ${actual}/${expected}: ${wire}")
        endif()
    endfunction()
    _jce_editor_launch_extract(core_begin "${core}" "static void editor_launch_diagnostics_begin(void)" "static void screenshot_poll_()")
    _jce_editor_launch_extract(core_init "${core}" "bool jce_editor_init(const JcePakArchive *pak, JceWindow *window)" "    /* Create ImGui context.")
    string(APPEND core_init "    return true;\n}\n")
    _jce_editor_launch_extract(core_tick "${core}" "
    if (s_editor.overview_diagnostics) {" "
    if (s_editor.frame_kpi_path[0]) {")
    set(core_reset "    memset(&s_editor, 0, sizeof(s_editor));")
    _jce_editor_launch_extract(core_shutdown "${core}" "void jce_editor_shutdown(void)" "bool jce_editor_process_event(const JceEvent *event)")
    _jce_editor_launch_require_wire("${core_shutdown}" "${core_reset}" 1)
    _jce_editor_launch_require_wire("${core_init}" "    editor_launch_diagnostics_begin();" 1)
    _jce_editor_launch_extract(metrics_state "${internal}" "struct JceEditorOperationMetricsState {" "struct EditorInternalState {")
    _jce_editor_launch_extract(metrics_observe "${metrics}" "static bool observe(void)" "void jce_editor_inspector_metric_request(uint32_t focused)")
    _jce_editor_launch_extract(metrics_tick "${metrics}" "void jce_editor_hierarchy_metric(int loaded, int roots, int rows, int capacity)" "static uint32_t named_entity(const char *name)")
    set(metrics_reset "    memset(&s, 0, sizeof(s));")
    _jce_editor_launch_extract(state_init "${state}" "void jce_editor_state_init(bool with_demo_scene)" "void jce_editor_state_shutdown(void)")
    _jce_editor_launch_extract(state_shutdown "${state}" "void jce_editor_state_shutdown(void)" "void jce_state_select_entity(uint32_t id, bool add_to_selection)")
    _jce_editor_launch_require_wire("${state_init}" "${metrics_reset}" 1)
    _jce_editor_launch_require_wire("${state_shutdown}" "${metrics_reset}" 1)
    _jce_editor_launch_extract(main_state "${main}" "struct EditorState {" "static uint64_t g_startup_t0;")
    _jce_editor_launch_extract(main_begin "${main}" "static void editor_cadence_diagnostics_begin(EditorState &state)" "static void editor_cadence_refresh(EditorState &state)")
    _jce_editor_launch_extract(main_tick "${main}" "static void editor_cadence_update(EditorState &state, uint64_t now)" "static bool editor_app_init(const JceServices *svc, void *ud)")
    set(main_init "    st->svc = svc;\n    editor_cadence_diagnostics_begin(*st);")
    set(main_reset "    g_state.cadence_diagnostics_enabled = false;")
    _jce_editor_launch_extract(main_init_body "${main}" "static bool editor_app_init(const JceServices *svc, void *ud)" "static void editor_app_exit(void *ud)")
    _jce_editor_launch_extract(main_exit_body "${main}" "static void editor_app_exit(void *ud)" "static void editor_app_update(float dt, void *ud)")
    _jce_editor_launch_require_wire("${main_init_body}" "${main_init}" 1)
    _jce_editor_launch_require_wire("${main_exit_body}" "${main_reset}" 1)
    string(CONCAT normal "${metrics_state}\nstatic struct { JceEditorOperationMetricsState operation_metrics; } s;\n"
        "${main_state}\n${core_begin}\n${core_init}\n"
        "static void actual_editor_reset() {\n${core_reset}\n}\n"
        "static void actual_metrics_reset() {\n${metrics_reset}\n}\n"
        "static void actual_launch_tick() {\n${core_tick}\n}\n"
        "${metrics_observe}\n${metrics_tick}\n${main_begin}\n${main_tick}\n"
        "static void actual_host_init(const JceServices *svc) {\n    EditorState *st = &g_state;\n${main_init}\n}\n"
        "static void actual_host_reset() {\n${main_reset}\n}\n")
    set(old_scans "${normal}")
    foreach(pair IN ITEMS overview bake metrics cadence)
        if("${pair}" STREQUAL "overview")
            set(before "if (s_editor.overview_diagnostics)")
            set(after "if (getenv(\"JCE_DBG_OVERVIEW\"))")
            set(count 2)
        elseif("${pair}" STREQUAL "bake")
            set(before "if (s_editor.static_batch_bake_requested)")
            set(after "if (getenv(\"JCE_STATIC_BATCH_BAKE\"))")
            set(count 1)
        elseif("${pair}" STREQUAL "metrics")
            set(before "return s.operation_metrics.enabled;")
            set(after "return getenv(\"JCE_EDITOR_OPERATION_METRICS\") != nullptr;")
            set(count 1)
        else()
            set(before "if (state.cadence_diagnostics_enabled &&")
            set(after "if (jce_env_flag_enabled(getenv(\"JCE_EDITOR_CADENCE_DIAG\")) &&")
            set(count 1)
        endif()
        _jce_editor_launch_require_wire("${old_scans}" "${before}" ${count})
        string(REPLACE "${before}" "${after}" old_scans "${old_scans}")
    endforeach()
    if(old_scans STREQUAL normal)
        message(FATAL_ERROR "Launch old-scans control did not change actual consumers")
    endif()
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/launch-diagnostics-control")
    file(MAKE_DIRECTORY "${directory}")
    foreach(variant IN ITEMS normal old_scans)
        set(path "${directory}/jce_editor_launch_${variant}.h")
        jce_test_write_if_changed("${path}" "${${variant}}")
        file(READ "${path}" written)
        if(NOT written STREQUAL ${variant})
            message(FATAL_ERROR "Launch diagnostic compiler input differs from selected actual source")
        endif()
        if("${variant}" STREQUAL "normal")
            set(target test_jce_editor_launch_diagnostics)
            set(kind integration)
        else()
            set(target test_jce_editor_launch_diagnostics_old_scans)
            set(kind contract)
        endif()
        jce_add_cxx_test(${target} KIND ${kind}
            SOURCES test_jce_editor_launch_diagnostics.cpp LINK jce_core)
        target_compile_features(${target} PRIVATE cxx_std_20)
        target_compile_definitions(${target} PRIVATE JCE_EDITOR_LAUNCH_DIAGNOSTICS_OWNER="${path}")
    endforeach()
    set_tests_properties(test_jce_editor_launch_diagnostics_old_scans PROPERTIES WILL_FAIL TRUE)
endfunction()
jce_editor_launch_diagnostics_controls()
