# Actual panel Canvas pointer block, real complete bridge, typed UI/setter ports.
set(_canvas_pointer_path "${CMAKE_SOURCE_DIR}/editor/src/panels/jce_panel_game_view.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_canvas_pointer_path}")
file(READ "${_canvas_pointer_path}" _canvas_pointer_source)
set(_canvas_pointer_begin "    {\n        const ImGuiIO &io = ImGui::GetIO();\n        JcePlayState ui_ps = jce_state_get_play_state();")
set(_canvas_pointer_end "\n    jce_editor_game_render_observation_request(canvas_w, canvas_h);")
foreach(_canvas_pointer_boundary IN ITEMS begin end)
    string(FIND "${_canvas_pointer_source}" "${_canvas_pointer_${_canvas_pointer_boundary}}" _canvas_pointer_${_canvas_pointer_boundary}_first)
    string(FIND "${_canvas_pointer_source}" "${_canvas_pointer_${_canvas_pointer_boundary}}" _canvas_pointer_${_canvas_pointer_boundary}_last REVERSE)
    if(_canvas_pointer_${_canvas_pointer_boundary}_first LESS 0 OR
       NOT _canvas_pointer_${_canvas_pointer_boundary}_first EQUAL _canvas_pointer_${_canvas_pointer_boundary}_last)
        message(FATAL_ERROR "Game Canvas pointer requires one actual ${_canvas_pointer_boundary} boundary")
    endif()
endforeach()
if(NOT _canvas_pointer_end_first GREATER _canvas_pointer_begin_first)
    message(FATAL_ERROR "Game Canvas pointer extraction bounds are not ordered")
endif()
math(EXPR _canvas_pointer_length "${_canvas_pointer_end_first} - ${_canvas_pointer_begin_first}")
string(SUBSTRING "${_canvas_pointer_source}" ${_canvas_pointer_begin_first} ${_canvas_pointer_length} _canvas_pointer_owner)
set(_canvas_pointer_wire "if (jce_editor_game_input_bridge_peek_virtual(\n                jce_editor_game_input_bridge_shared(), &ui_viewport, &virtual_pointer))")
string(FIND "${_canvas_pointer_owner}" "${_canvas_pointer_wire}" _canvas_pointer_first)
string(FIND "${_canvas_pointer_owner}" "${_canvas_pointer_wire}" _canvas_pointer_last REVERSE)
if(_canvas_pointer_first LESS 0 OR NOT _canvas_pointer_first EQUAL _canvas_pointer_last)
    message(FATAL_ERROR "Game Canvas pointer requires one actual virtual admission wire")
endif()
foreach(_canvas_pointer_variant IN ITEMS current old_virtual)
    set(_canvas_pointer_body "${_canvas_pointer_owner}")
    set(_canvas_pointer_target test_jce_editor_game_canvas_pointer)
    set(_canvas_pointer_kind unit)
    if(_canvas_pointer_variant STREQUAL "old_virtual")
        string(REPLACE "${_canvas_pointer_wire}" "if (false)" _canvas_pointer_body "${_canvas_pointer_body}")
        string(APPEND _canvas_pointer_target "_old_virtual")
        set(_canvas_pointer_kind contract)
    endif()
    set(_canvas_pointer_output "${CMAKE_CURRENT_BINARY_DIR}/game-canvas-pointer/${_canvas_pointer_variant}.inc.h")
    jce_test_write_if_changed("${_canvas_pointer_output}" "${_canvas_pointer_body}")
    jce_add_cxx_test(${_canvas_pointer_target} KIND ${_canvas_pointer_kind}
        SOURCES test_jce_editor_game_canvas_pointer.cpp
            "${CMAKE_SOURCE_DIR}/editor/src/core/jce_editor_game_input_bridge.cpp"
        LINK jce_core jce_platform)
    target_compile_definitions(${_canvas_pointer_target} PRIVATE
        JCE_TEST_GAME_CANVAS_POINTER_OWNER="${_canvas_pointer_output}")
    if(_canvas_pointer_kind STREQUAL "contract")
        set_tests_properties(${_canvas_pointer_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_canvas_pointer_cleanup IN ITEMS path source begin end boundary begin_first begin_last end_first end_last
        length owner wire first last variant body target kind output)
    unset(_canvas_pointer_${_canvas_pointer_cleanup})
endforeach()
unset(_canvas_pointer_cleanup)
