# Actual private scan owner and complete caller bodies. Public SDK types,
# real headless ImGui, counted async/filesystem boundaries; no native FPS claim.
function(_jce_editor_register_asset_directory_controls)
    set(_panel "${CMAKE_SOURCE_DIR}/editor/src/panels")
    set(_ui "${CMAKE_SOURCE_DIR}/editor/src/ui")
    set(_fixture "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    foreach(_file jce_panel_assets_directory.h jce_panel_assets_internal.h
            jce_panel_assets.cpp jce_panel_assets_nav.cpp)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_panel}/${_file}")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${_ui}/jce_editor_panels.cpp" "${_ui}/jce_editor_panels.h")
    file(READ "${_panel}/jce_panel_assets_directory.h" _owner)
    file(READ "${_panel}/jce_panel_assets_internal.h" _state_source)
    file(READ "${_panel}/jce_panel_assets.cpp" _assets)
    file(READ "${_panel}/jce_panel_assets_nav.cpp" _nav)
    file(READ "${_ui}/jce_editor_panels.cpp" _panels)
    file(READ "${_ui}/jce_editor_panels.h" _panel_header)

    function(_jce_asset_directory_slice source start end result)
        string(FIND "${source}" "${start}" _first)
        string(FIND "${source}" "${end}" _last)
        if(_first LESS 0 OR _last LESS _first)
            message(FATAL_ERROR "Asset directory controls require complete actual ${start} body")
        endif()
        math(EXPR _length "${_last} - ${_first}")
        string(SUBSTRING "${source}" ${_first} ${_length} _body)
        set(${result} "${_body}" PARENT_SCOPE)
    endfunction()
    _jce_asset_directory_slice("${_state_source}" "struct FileEntry {" "/* ── Shared helpers" _state)
    _jce_asset_directory_slice("${_panel_header}" "typedef enum {" "/* Lifecycle. */" _panel_enum)
    _jce_asset_directory_slice("${_assets}" "static void reset_asset_browser_view_to_root(" "bool asset_browser_can_use_root(" _reset)
    _jce_asset_directory_slice("${_assets}" "void request_asset_resource_refresh(void)" "void collect_search_results(" _refresh)
    _jce_asset_directory_slice("${_assets}" "    if (!s_assets.pending_navigation_path.empty()) {" "    float tree_w =" _frame)
    _jce_asset_directory_slice("${_nav}" "const DirListing &listing_for(" "} /* namespace */" _listing)
    _jce_asset_directory_slice("${_nav}" "void jce_editor_assets_tree_cache_invalidate(void)" "static void draw_dir_tree(" _nav_lifecycle)
    _jce_asset_directory_slice("${_nav}" "static void draw_dir_tree(" "/* ── Path helpers" _recursive)
    _jce_asset_directory_slice("${_nav}" "void draw_asset_directory_tree(" "/* ── B. Breadcrumb bar" _tree)
    _jce_asset_directory_slice("${_panels}" "void jce_editor_panels_init(void)" "/* ══════════════════════════════════════════════════════════════════════\n *  FILE VIEWER" _lifecycle)

    set(_dir "${CMAKE_CURRENT_BINARY_DIR}/asset-directory")
    foreach(_variant current old_ui_scan stale_current failed_tree_empty
            missing_poll missing_tree_publication missing_shutdown late_cancel)
        set(_body "${_owner}")
        set(_frame_body "${_frame}")
        set(_tree_body "${_tree}")
        set(_lifecycle_body "${_lifecycle}")
        set(_input "${_body}")
        set(_which body)
        set(_kind integration)
        set(_target test_jce_editor_asset_directory)
        if(_variant STREQUAL "old_ui_scan")
            set(_before "task_ = jce_async_submit(executor, &desc);")
            set(_after "jce_fs_host_list_dir(dir.c_str(), [](const char *, bool, void *) { return true; }, nullptr);\n        task_ = jce_async_submit(executor, &desc);")
        elseif(_variant STREQUAL "stale_current")
            set(_before "++current_generation_;\n        current_.cancel();")
            set(_after "/* Missing current-folder generation/cancel wire. */")
        elseif(_variant STREQUAL "failed_tree_empty")
            set(_before "if (!available || !enabled_ || !snapshot.request.tree ||")
            set(_after "entry.listing = {};\n        if (!available || !enabled_ || !snapshot.request.tree ||")
        elseif(_variant STREQUAL "missing_poll")
            set(_which frame_body)
            set(_input "${_frame_body}")
            set(_before "jce_asset_directory::owner().poll_current(s_assets.current_path);")
            set(_after "(void)s_assets.current_path;")
        elseif(_variant STREQUAL "missing_tree_publication")
            set(_which tree_body)
            set(_input "${_tree_body}")
            set(_before "jce_asset_directory::owner().begin_tree(asset_tree_now());")
            set(_after "/* Missing frame-boundary publication wire. */")
        elseif(_variant STREQUAL "missing_shutdown")
            set(_which lifecycle_body)
            set(_input "${_lifecycle_body}")
            set(_before "jce_editor_assets_directory_shutdown();")
            set(_after "/* Missing shared-panel shutdown wire. */")
        elseif(_variant STREQUAL "late_cancel")
            set(_before "    if (jce_async_context_cancel_requested(ctx)) return JCE_ASYNC_RUN_CANCELLED;\n    const Request &request")
            set(_after "    const Request &request")
        endif()
        if(NOT _variant STREQUAL "current")
            string(FIND "${_input}" "${_before}" _first)
            string(FIND "${_input}" "${_before}" _last REVERSE)
            if(_first LESS 0 OR NOT _first EQUAL _last)
                message(FATAL_ERROR "Asset directory ${_variant} requires one exact mutation wire")
            endif()
            string(REPLACE "${_before}" "${_after}" _${_which} "${_input}")
            set(_target "${_target}_${_variant}")
            set(_kind contract)
        endif()
        set(_owner_path "${_dir}/${_variant}.h")
        set(_state_path "${_dir}/${_variant}-state.h")
        set(_wire_path "${_dir}/${_variant}-wiring.h")
        set(_peer_path "${_dir}/${_variant}-peer.cpp")
        set(_wires "${_reset}\n${_refresh}\nvoid asset_directory_frame(void)\n{\n${_frame_body}\n}\nusing DirListing = jce_asset_directory::Listing;\n${_listing}\n${_nav_lifecycle}\n${_recursive}\n${_tree_body}\n${_lifecycle_body}\n")
        jce_test_write_if_changed("${_owner_path}" "${_body}")
        jce_test_write_if_changed("${_state_path}" "${_state}\n${_panel_enum}")
        jce_test_write_if_changed("${_wire_path}" "${_wires}")
        jce_test_write_if_changed("${_peer_path}"
            "#include \"${_owner_path}\"\nvoid *asset_directory_peer_owner() { return &jce_asset_directory::owner(); }\n")
        file(READ "${_owner_path}" _written)
        if(NOT _written STREQUAL _body)
            message(FATAL_ERROR "Asset directory compiled owner differs from selected bytes")
        endif()
        file(READ "${_wire_path}" _written)
        if(NOT _written STREQUAL _wires)
            message(FATAL_ERROR "Asset directory compiled wiring differs from selected bytes")
        endif()
        jce_add_cxx_test(${_target} KIND ${_kind}
            SOURCES "${_fixture}/test_jce_editor_asset_directory.cpp" "${_peer_path}"
            LINK jce_tools_imgui)
        target_compile_features(${_target} PRIVATE cxx_std_20)
        target_compile_definitions(${_target} PRIVATE
            JCE_TEST_ASSET_DIRECTORY_OWNER="${_owner_path}"
            JCE_TEST_ASSET_DIRECTORY_STATE="${_state_path}"
            JCE_TEST_ASSET_DIRECTORY_WIRING="${_wire_path}")
        if(_kind STREQUAL "contract")
            set_tests_properties(${_target} PROPERTIES WILL_FAIL TRUE)
        endif()
    endforeach()
endfunction()
_jce_editor_register_asset_directory_controls()
