# Private caption owner with real ImGui and actual FileEntry/filter-copy wires.
function(_jce_editor_register_asset_caption_controls)
    set(_panel "${CMAKE_SOURCE_DIR}/editor/src/panels")
    set(_fixture "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${_panel}/jce_panel_assets_caption.h" "${_panel}/jce_panel_assets_internal.h"
        "${_panel}/jce_panel_assets.cpp" "${_panel}/jce_panel_assets_grid.cpp")
    file(READ "${_panel}/jce_panel_assets_caption.h" _caption)
    file(READ "${_panel}/jce_panel_assets_internal.h" _state_source)
    file(READ "${_panel}/jce_panel_assets.cpp" _panel_source)
    file(READ "${_panel}/jce_panel_assets_grid.cpp" _grid_source)
    string(FIND "${_state_source}" "struct FileEntry {" _start)
    string(FIND "${_state_source}" "/* ── Shared helpers" _end)
    if(_start LESS 0 OR _end LESS _start)
        message(FATAL_ERROR "Asset caption controls require actual FileEntry/state declarations")
    endif()
    math(EXPR _length "${_end} - ${_start}")
    string(SUBSTRING "${_state_source}" ${_start} ${_length} _state)
    string(FIND "${_grid_source}" "void prepare_asset_grid_caption(" _start)
    string(FIND "${_grid_source}" "void draw_asset_grid_item(" _end)
    if(_start LESS 0 OR _end LESS _start)
        message(FATAL_ERROR "Asset caption controls require complete actual prepare owner")
    endif()
    math(EXPR _length "${_end} - ${_start}")
    string(SUBSTRING "${_grid_source}" ${_start} ${_length} _prepare)
    string(FIND "${_panel_source}" "                auto append_filtered =" _start)
    string(FIND "${_panel_source}" "                for (const auto &fe : raw_entries) {" _end)
    if(_start LESS 0 OR _end LESS _start)
        message(FATAL_ERROR "Asset caption controls require complete actual filtered-copy owner")
    endif()
    math(EXPR _length "${_end} - ${_start}")
    string(SUBSTRING "${_panel_source}" ${_start} ${_length} _append)
    set(_draw_wire "draw_asset_grid_caption(fe.grid_caption, fe.name,\n        s_assets.selected_set.count(index) != 0, (float)JCE_THUMBNAIL_SIZE,")
    string(FIND "${_grid_source}" "${_draw_wire}" _draw_first)
    string(FIND "${_grid_source}" "${_draw_wire}" _draw_last REVERSE)
    if(_draw_first LESS 0 OR NOT _draw_first EQUAL _draw_last)
        message(FATAL_ERROR "Asset grid must consume its one actual caption owner")
    endif()

    foreach(_variant current old_remeasure stale_metrics stale_name missing_filtered_warmup)
        set(_body "${_caption}")
        set(_copy "${_append}")
        set(_kind integration)
        set(_target test_jce_editor_asset_caption)
        if(_variant STREQUAL "old_remeasure")
            set(_before "if (cache.ready && cache.metrics == metrics && cache.source_name == name)")
            set(_after "if (false && cache.ready && cache.metrics == metrics && cache.source_name == name)")
        elseif(_variant STREQUAL "stale_metrics")
            set(_before "cache.metrics == metrics && ")
            set(_after "")
        elseif(_variant STREQUAL "stale_name")
            set(_before "cache.source_name == name)")
            set(_after "true)")
        elseif(_variant STREQUAL "missing_filtered_warmup")
            set(_before "prepare_asset_grid_caption(fe);")
            set(_after "(void)fe; /* ordinary missing original-entry warmup */")
        endif()
        if(NOT _variant STREQUAL "current")
            set(_input "${_body}")
            if(_variant STREQUAL "missing_filtered_warmup")
                set(_input "${_copy}")
            endif()
            string(FIND "${_input}" "${_before}" _first)
            string(FIND "${_input}" "${_before}" _last REVERSE)
            if(_first LESS 0 OR NOT _first EQUAL _last)
                message(FATAL_ERROR "Asset caption ${_variant} mutation must be unique")
            endif()
            string(REPLACE "${_before}" "${_after}" _output "${_input}")
            if(_variant STREQUAL "missing_filtered_warmup")
                set(_copy "${_output}")
            else()
                set(_body "${_output}")
            endif()
            set(_kind contract)
            set(_target "${_target}_${_variant}")
        endif()
        set(_dir "${CMAKE_CURRENT_BINARY_DIR}/asset-caption")
        set(_owner "${_dir}/${_variant}.h")
        set(_wiring "${_dir}/${_variant}-wiring.h")
        jce_test_write_if_changed("${_owner}" "${_body}")
        set(_wires "#include \"core/jce_editor_defaults.h\"\n${_state}\n${_prepare}\nstd::vector<FileEntry> asset_caption_filtered_copy(const std::vector<FileEntry> &source)\n{\n    std::vector<FileEntry> filtered;\n${_copy}\n    for (const auto &fe : source) append_filtered(fe);\n    return filtered;\n}\n")
        jce_test_write_if_changed("${_wiring}" "${_wires}")
        file(READ "${_owner}" _written)
        if(NOT _written STREQUAL _body)
            message(FATAL_ERROR "Asset caption compiler input differs from selected owner")
        endif()
        file(READ "${_wiring}" _written)
        if(NOT _written STREQUAL _wires)
            message(FATAL_ERROR "Asset caption compiler input differs from selected wiring")
        endif()
        jce_add_cxx_test(${_target} KIND ${_kind}
            SOURCES "${_fixture}/test_jce_editor_asset_caption.cpp"
            LINK jce_tools_imgui)
        target_compile_features(${_target} PRIVATE cxx_std_20)
        target_compile_definitions(${_target} PRIVATE
            JCE_TEST_ASSET_CAPTION_OWNER="${_owner}"
            JCE_TEST_ASSET_CAPTION_WIRING="${_wiring}")
        if(_kind STREQUAL "contract")
            set_tests_properties(${_target} PROPERTIES WILL_FAIL TRUE)
        endif()
    endforeach()
endfunction()
_jce_editor_register_asset_caption_controls()
