# Complete private owner + strict actual Game/panel/core call-site slices.
set(_frame_obs_dir "${CMAKE_CURRENT_BINARY_DIR}/frame-observation-controls")
file(MAKE_DIRECTORY "${_frame_obs_dir}")
foreach(_frame_obs_owner IN ITEMS core/jce_editor.cpp scene/jce_editor_game_render.cpp panels/jce_panel_game_view.cpp)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/editor/src/${_frame_obs_owner}")
endforeach()
file(READ "${CMAKE_SOURCE_DIR}/editor/src/scene/jce_editor_game_render.cpp" _frame_obs_game)
file(READ "${CMAKE_SOURCE_DIR}/editor/src/panels/jce_panel_game_view.cpp" _frame_obs_panel)
file(READ "${CMAKE_SOURCE_DIR}/editor/src/core/jce_editor.cpp" _frame_obs_core)
function(_jce_frame_obs_extract OUTPUT INPUT START END)
    string(FIND "${INPUT}" "${START}" _first)
    string(FIND "${INPUT}" "${START}" _last REVERSE)
    string(FIND "${INPUT}" "${END}" _end)
    string(FIND "${INPUT}" "${END}" _end_last REVERSE)
    if(_first LESS 0 OR NOT _first EQUAL _last OR NOT _end EQUAL _end_last OR _end LESS_EQUAL _first)
        message(FATAL_ERROR "Frame observation actual-owner bounds must be unique: ${START} -> ${END}")
    endif()
    math(EXPR _length "${_end} - ${_first}")
    string(SUBSTRING "${INPUT}" ${_first} ${_length} _body)
    set(${OUTPUT} "${_body}" PARENT_SCOPE)
endfunction()
_jce_frame_obs_extract(_frame_obs_wire "${_frame_obs_game}"
    "void jce_editor_game_render_observation_begin(" "void jce_editor_game_render_resolve_extent(")
_jce_frame_obs_extract(_frame_obs_admission "${_frame_obs_game}"
    "void jce_editor_game_render_frame(" "    const float frame_dt =")
string(REPLACE "void jce_editor_game_render_frame(" "static void actual_admission(" _frame_obs_admission "${_frame_obs_admission}")
string(APPEND _frame_obs_wire "${_frame_obs_admission}    ++ports.admitted;\n}\n")
_jce_frame_obs_extract(_frame_obs_prepare "${_frame_obs_game}"
    "    if (!jce_offscreen_target_prepare_keep(" "    /* GPU-upload any completed async mesh/texture loads before the engine")
string(APPEND _frame_obs_wire "static void actual_prepare(uint32_t render_w, uint32_t render_h) {\n    jce_mat4 view{}, color_proj{}; bool base_keep_color=false, base_keep_depth=false;\n    JceEditorViewportRenderTrace render_trace(\"editor.game.render\", \"editor.game.render.reason\", \"editor.game.render.admitted\");\n${_frame_obs_prepare}}\n")
_jce_frame_obs_extract(_frame_obs_resources "${_frame_obs_game}"
    "    if (!jce_scene_renderer_prepare_resources(engine_sr, scene))" "    /* Same story, one step further along:")
string(APPEND _frame_obs_wire "static void actual_resources() {\n    JceSceneRenderer *engine_sr=jce_editor_get_scene_renderer(); JceScene *scene=jce_state_get_scene();\n    JceEditorViewportRenderTrace render_trace(\"editor.game.render\", \"editor.game.render.reason\", \"editor.game.render.admitted\");\n${_frame_obs_resources}}\n")
_jce_frame_obs_extract(_frame_obs_tail "${_frame_obs_game}"
    "    jce_scene_renderer_set_taa_velocity_enabled(engine_sr, false);" "\n}\n\nvoid jce_editor_game_render_set_module")
string(APPEND _frame_obs_wire "static void actual_tail() { JceSceneRenderer *engine_sr=jce_editor_get_scene_renderer();\n${_frame_obs_tail}\n}\n")
_jce_frame_obs_extract(_frame_obs_request "${_frame_obs_panel}"
    "    jce_editor_game_render_observation_request(canvas_w, canvas_h);" "    uint16_t tex_idx = viewport_work ?")
string(APPEND _frame_obs_wire "static void actual_request(bool viewport_work) { uint32_t canvas_w=1000, canvas_h=700;\n${_frame_obs_request}}\n")
_jce_frame_obs_extract(_frame_obs_image "${_frame_obs_panel}"
    "        ImGui::Image(tid, view_size, uv0, uv1);" "    } else {\n        ImGui::Dummy(view_size);")
string(APPEND _frame_obs_wire "static void actual_image(uint16_t tex_idx) { ImTextureID tid=tex_idx+1u; ImVec2 view_size{1000,700}, uv0{0,0}, uv1{1,1};\n${_frame_obs_image}}\n")
_jce_frame_obs_extract(_frame_obs_stats "${_frame_obs_panel}"
    "    if (s_show_stats) {" "\n}\n\n/* ── Standalone wrapper")
string(APPEND _frame_obs_wire "static void actual_stats(bool viewport_work, uint32_t render_vw=1000, uint32_t render_vh=700) {\n    ImVec2 image_min{0,0}, image_max{1000,700}; ImDrawList draw_list; ImDrawList *dl=&draw_list;\n${_frame_obs_stats}}\n")
_jce_frame_obs_extract(_frame_obs_begin "${_frame_obs_core}"
    "    jce_editor_game_render_observation_begin(jce_engine_frame_observation_enabled());" "    uint64_t _t0_layout =")
string(APPEND _frame_obs_wire "static void actual_begin() {\n${_frame_obs_begin}}\n")
_jce_frame_obs_extract(_frame_obs_submit "${_frame_obs_core}"
    "    JceFrameViewportObservation game_observation{};" "    jce_perf_phase_add(\"ed_submit\"")
string(APPEND _frame_obs_wire "static void actual_submit() {\n${_frame_obs_submit}}\n")
set(_frame_obs_variants normal missing_begin missing_completed missing_postfx_display_query)
if(_frame_obs_game MATCHES "bool[ ]+stats_frame_completed")
    list(APPEND _frame_obs_variants missing_stats_reset missing_stats_completed requested_stats_extent)
endif()
foreach(_frame_obs_variant IN LISTS _frame_obs_variants)
    set(_frame_obs_source "${_frame_obs_wire}")
    if(_frame_obs_variant STREQUAL "missing_begin")
        string(REPLACE "jce_editor_game_render_observation_begin(jce_engine_frame_observation_enabled());"
            "/* ordinary omitted reset wire */" _frame_obs_source "${_frame_obs_source}")
    elseif(_frame_obs_variant STREQUAL "missing_completed")
        string(REPLACE "s_game_frame_observation.completed();" "/* ordinary omitted CPU-tail wire */"
            _frame_obs_source "${_frame_obs_source}")
    elseif(_frame_obs_variant STREQUAL "missing_postfx_display_query")
        set(_frame_obs_needle "if (jce_postfx_get_output_target(g.postfx, &output) &&")
        string(FIND "${_frame_obs_source}" "${_frame_obs_needle}" _frame_obs_first)
        string(FIND "${_frame_obs_source}" "${_frame_obs_needle}" _frame_obs_last REVERSE)
        if(_frame_obs_first LESS 0 OR NOT _frame_obs_first EQUAL _frame_obs_last)
            message(FATAL_ERROR "PostFX display control requires one actual SDK query wire")
        endif()
        string(REPLACE "${_frame_obs_needle}"
            "if (false && jce_postfx_get_output_target(g.postfx, &output) &&"
            _frame_obs_source "${_frame_obs_source}")
    elseif(_frame_obs_variant STREQUAL "missing_stats_reset" OR
           _frame_obs_variant STREQUAL "missing_stats_completed" OR
           _frame_obs_variant STREQUAL "requested_stats_extent")
        if(_frame_obs_variant STREQUAL "missing_stats_reset")
            set(_frame_obs_needle "    g.stats_frame_completed = false;")
            set(_frame_obs_replacement "    /* ordinary omitted HUD reset */")
        elseif(_frame_obs_variant STREQUAL "missing_stats_completed")
            set(_frame_obs_needle "    g.stats_frame_completed = true;")
            set(_frame_obs_replacement "    /* ordinary omitted HUD completion */")
        else()
            set(_frame_obs_needle "    return jce_offscreen_target_get_extent(g.bridge, width, height);")
            set(_frame_obs_replacement "    *width=g.render_width; *height=g.render_height; return true;")
        endif()
        string(FIND "${_frame_obs_source}" "${_frame_obs_needle}" _frame_obs_first)
        string(FIND "${_frame_obs_source}" "${_frame_obs_needle}" _frame_obs_last REVERSE)
        if(_frame_obs_first LESS 0 OR NOT _frame_obs_first EQUAL _frame_obs_last)
            message(FATAL_ERROR "Stats ordinary control requires one actual wire: ${_frame_obs_variant}")
        endif()
        string(REPLACE "${_frame_obs_needle}" "${_frame_obs_replacement}"
            _frame_obs_source "${_frame_obs_source}")
    endif()
    set(_frame_obs_path "${_frame_obs_dir}/${_frame_obs_variant}.inc.h")
    jce_test_write_if_changed("${_frame_obs_path}" "${_frame_obs_source}")
    set(_frame_obs_target "test_jce_editor_frame_observation")
    set(_frame_obs_kind unit)
    if(NOT _frame_obs_variant STREQUAL "normal")
        string(APPEND _frame_obs_target "_${_frame_obs_variant}")
        set(_frame_obs_kind contract)
    endif()
    jce_add_cxx_test(${_frame_obs_target} KIND ${_frame_obs_kind}
        SOURCES test_jce_editor_frame_observation.cpp LINK jce_core)
    target_compile_features(${_frame_obs_target} PRIVATE cxx_std_20)
    target_compile_definitions(${_frame_obs_target} PRIVATE JCE_TEST_EDITOR_FRAME_OBSERVATION_WIRES="${_frame_obs_path}")
    if(NOT _frame_obs_variant STREQUAL "normal")
        set_tests_properties(${_frame_obs_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
