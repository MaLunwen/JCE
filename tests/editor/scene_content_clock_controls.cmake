# Actual Scene content clock, navigation call and four simulation sink statements.
set(_scene_clock_owner "${CMAKE_SOURCE_DIR}/editor/src/scene/jce_editor_scene_render.cpp")
set(_scene_clock_game_owner "${CMAKE_SOURCE_DIR}/editor/src/scene/jce_editor_game_render.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_scene_clock_owner}" "${_scene_clock_game_owner}")
file(READ "${_scene_clock_owner}" _scene_clock_source)
file(READ "${_scene_clock_game_owner}" _scene_clock_game_source)
function(_jce_scene_clock_unique source needle output)
    string(FIND "${source}" "${needle}" first)
    string(FIND "${source}" "${needle}" last REVERSE)
    if(first LESS 0 OR NOT first EQUAL last)
        message(FATAL_ERROR "Scene content clock requires one actual source boundary: ${needle}")
    endif()
    set(${output} ${first} PARENT_SCOPE)
endfunction()
function(_jce_scene_clock_statement source needle output)
    _jce_scene_clock_unique("${source}" "${needle}" start)
    string(SUBSTRING "${source}" ${start} -1 rest)
    string(FIND "${rest}" ";" end)
    if(end LESS 0)
        message(FATAL_ERROR "Scene content clock actual statement is incomplete")
    endif()
    math(EXPR length "${end} + 1")
    string(SUBSTRING "${rest}" 0 ${length} statement)
    set(${output} "${statement}" PARENT_SCOPE)
endfunction()
_jce_scene_clock_unique("${_scene_clock_source}" "    uint64_t now_ticks = jce_time_perf_counter();" _scene_clock_start)
_jce_scene_clock_unique("${_scene_clock_source}" "    /* Headless overview-capture hook:" _scene_clock_end)
math(EXPR _scene_clock_length "${_scene_clock_end} - ${_scene_clock_start}")
string(SUBSTRING "${_scene_clock_source}" ${_scene_clock_start} ${_scene_clock_length} _scene_clock_body)
_jce_scene_clock_statement("${_scene_clock_source}" "jce_editor_scene_camera_update(dt_sec)" _scene_clock_navigation)
_jce_scene_clock_statement("${_scene_clock_source}" "jce_scene_renderer_render_planar_reflection(s_sr.scene_renderer" _scene_clock_reflection)
_jce_scene_clock_statement("${_scene_clock_source}" "jce_scene_renderer_render(s_sr.scene_renderer" _scene_clock_render)
_jce_scene_clock_statement("${_scene_clock_source}" "jce_editor_viewport_apply_fullscreen_effects(\n            s_sr.scene_renderer" _scene_clock_fullscreen)
_jce_scene_clock_statement("${_scene_clock_source}" "jce_ui_canvas_render(s_sr.ui_canvas" _scene_clock_canvas)
_jce_scene_clock_statement("${_scene_clock_game_source}" "const int play_state = (int)jce_state_get_play_state()" _scene_clock_game_state)
_jce_scene_clock_statement("${_scene_clock_game_source}" "const float frame_dt = jce_editor_play_render_delta()" _scene_clock_game_delta)
_jce_scene_clock_statement("${_scene_clock_game_source}" "float render_dt = (play_state == 1) ? frame_dt : 0.0f" _scene_clock_game_content)
set(_scene_clock_actual "void test_actual_scene_content_frame(uint32_t width,uint32_t height)\n{\nJceScene *scene=token<JceScene>(); JceScene *ui_scene=scene; JceSceneRenderConfig cfg{}; uint16_t ui_view=20,ui_fb=9;\n${_scene_clock_body}\n${_scene_clock_navigation}\n${_scene_clock_reflection}\n${_scene_clock_render}\n${_scene_clock_fullscreen}\n${_scene_clock_canvas}\n}\nfloat test_actual_game_content_delta()\n{\n${_scene_clock_game_state}\n${_scene_clock_game_delta}\n${_scene_clock_game_content}\nreturn render_dt;\n}\n")
set(_scene_clock_dir "${CMAKE_CURRENT_BINARY_DIR}/scene-content-clock")
file(MAKE_DIRECTORY "${_scene_clock_dir}")
foreach(_scene_clock_variant IN ITEMS current old_wall_sinks old_navigation_clock old_stopped_preview)
    set(_scene_clock_content "${_scene_clock_actual}")
    set(_scene_clock_target test_jce_editor_scene_content_clock)
    set(_scene_clock_kind unit)
    if(NOT _scene_clock_variant STREQUAL "current")
        set(_scene_clock_target "test_jce_editor_scene_content_clock_${_scene_clock_variant}")
        set(_scene_clock_kind contract)
        if(_scene_clock_variant STREQUAL "old_wall_sinks")
            foreach(_scene_clock_sink IN ITEMS reflection render fullscreen canvas)
                set(_scene_clock_needle "${_scene_clock_${_scene_clock_sink}}")
                string(REPLACE "content_dt_sec" "dt_sec" _scene_clock_replacement "${_scene_clock_needle}")
                if(_scene_clock_needle STREQUAL _scene_clock_replacement)
                    message(FATAL_ERROR "Scene content control requires the actual content argument")
                endif()
                _jce_scene_clock_unique("${_scene_clock_content}" "${_scene_clock_needle}" _scene_clock_position)
                string(REPLACE "${_scene_clock_needle}" "${_scene_clock_replacement}" _scene_clock_content "${_scene_clock_content}")
            endforeach()
        elseif(_scene_clock_variant STREQUAL "old_navigation_clock")
            string(REPLACE "dt_sec" "content_dt_sec" _scene_clock_replacement "${_scene_clock_navigation}")
            _jce_scene_clock_unique("${_scene_clock_content}" "${_scene_clock_navigation}" _scene_clock_position)
            string(REPLACE "${_scene_clock_navigation}" "${_scene_clock_replacement}" _scene_clock_content "${_scene_clock_content}")
        elseif(_scene_clock_variant STREQUAL "old_stopped_preview")
            set(_scene_clock_needle "        ? dt_sec : jce_editor_play_render_delta();")
            _jce_scene_clock_unique("${_scene_clock_content}" "${_scene_clock_needle}" _scene_clock_position)
            string(REPLACE "${_scene_clock_needle}" "        ? 0.0f : jce_editor_play_render_delta();" _scene_clock_content "${_scene_clock_content}")
        endif()
    endif()
    set(_scene_clock_path "${_scene_clock_dir}/${_scene_clock_variant}.inc.h")
    unset(_scene_clock_previous)
    if(EXISTS "${_scene_clock_path}")
        file(READ "${_scene_clock_path}" _scene_clock_previous)
    endif()
    if(NOT _scene_clock_previous STREQUAL _scene_clock_content)
        file(WRITE "${_scene_clock_path}" "${_scene_clock_content}")
    endif()
    jce_add_cxx_test(${_scene_clock_target} KIND ${_scene_clock_kind} SOURCES test_jce_editor_scene_content_clock.cpp LINK jce_core)
    if(_scene_clock_kind STREQUAL "contract")
        set_tests_properties(${_scene_clock_target} PROPERTIES WILL_FAIL TRUE)
    endif()
    target_compile_features(${_scene_clock_target} PRIVATE cxx_std_20)
    target_compile_definitions(${_scene_clock_target} PRIVATE JCE_EDITOR_SCENE_CONTENT_CLOCK_OWNER="${_scene_clock_path}")
endforeach()
foreach(_scene_clock_var IN ITEMS owner game_owner source game_source start end length body navigation reflection render fullscreen canvas game_state game_delta game_content actual dir variant content target kind path previous sink needle replacement position)
    unset(_scene_clock_${_scene_clock_var})
endforeach()
unset(_scene_clock_var)
