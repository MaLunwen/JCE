# Complete actual once-only startup admission and pure policy, without ImGui.
function(_jce_editor_register_welcome_startup_controls)
    set(_owner "${CMAKE_SOURCE_DIR}/editor/src/ui/jce_editor_layout.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_owner}")
    file(READ "${_owner}" _source)
    set(_begin "static bool has_known_startup_project(void)")
    set(_end "\nstatic void draw_dialog_dimmer(void)")
    foreach(_boundary IN ITEMS begin end)
        string(FIND "${_source}" "${_${_boundary}}" _${_boundary}_first)
        string(FIND "${_source}" "${_${_boundary}}" _${_boundary}_last REVERSE)
        if(_${_boundary}_first LESS 0 OR NOT _${_boundary}_first EQUAL _${_boundary}_last)
            message(FATAL_ERROR "Welcome startup ${_boundary} boundary must be unique")
        endif()
    endforeach()
    if(NOT _end_first GREATER _begin_first)
        message(FATAL_ERROR "Welcome startup extraction boundaries must be ordered")
    endif()
    math(EXPR _length "${_end_first} - ${_begin_first}")
    string(SUBSTRING "${_source}" ${_begin_first} ${_length} _actual)
    set(_wire "        has_current_content,\n")
    string(FIND "${_actual}" "${_wire}" _wire_first)
    string(FIND "${_actual}" "${_wire}" _wire_last REVERSE)
    if(_wire_first LESS 0 OR NOT _wire_first EQUAL _wire_last)
        message(FATAL_ERROR "Welcome startup content-admission wire must be unique")
    endif()
    foreach(_variant IN ITEMS actual old_project_only)
        set(_body "${_actual}")
        set(_target test_jce_editor_welcome_startup)
        set(_kind unit)
        if(_variant STREQUAL "old_project_only")
            string(REPLACE "${_wire}" "        has_project,\n" _body "${_body}")
            string(APPEND _target "_old_project_only")
            set(_kind contract)
        endif()
        set(_output "${CMAKE_CURRENT_BINARY_DIR}/welcome-startup/${_variant}.inc.h")
        jce_test_write_if_changed("${_output}" "${_body}")
        file(READ "${_output}" _written)
        if(NOT _written STREQUAL _body)
            message(FATAL_ERROR "Welcome startup compiler input differs from selected owner")
        endif()
        jce_add_cxx_test(${_target} KIND ${_kind}
            SOURCES test_jce_editor_welcome_startup.cpp
                "${CMAKE_SOURCE_DIR}/editor/src/ui/jce_editor_welcome_policy.cpp")
        target_compile_definitions(${_target} PRIVATE
            JCE_TEST_EDITOR_WELCOME_STARTUP_OWNER="${_output}")
        if(_kind STREQUAL "contract")
            set_tests_properties(${_target} PROPERTIES WILL_FAIL TRUE)
        endif()
    endforeach()
endfunction()
_jce_editor_register_welcome_startup_controls()
