# Ordinary failures preserve the entire real bridge and all assertion groups.
file(READ "${CMAKE_SOURCE_DIR}/editor/src/core/jce_editor_game_input_bridge.cpp" _virtual_bridge_source)
foreach(_virtual_mode IN ITEMS old_virtual_commit old_commit_order)
    if(_virtual_mode STREQUAL "old_virtual_commit")
        set(_virtual_marker "    const bool virtual_source = bridge->virtual_pointer.active && virtual_viewport_admitted(bridge->viewport);")
        set(_virtual_replacement "    const bool virtual_source = false; /* old consume: explicit virtual source ignored */")
    else()
        set(_virtual_marker "    ops->step(ud, dt);")
        set(_virtual_replacement "    /* old order: runtime already stepped before position publication */")
    endif()
    string(FIND "${_virtual_bridge_source}" "${_virtual_marker}" _virtual_first)
    string(FIND "${_virtual_bridge_source}" "${_virtual_marker}" _virtual_last REVERSE)
    if(_virtual_first LESS 0 OR NOT _virtual_first EQUAL _virtual_last)
        message(FATAL_ERROR "Game virtual control requires one actual owner wire: ${_virtual_mode}")
    endif()
    string(REPLACE "${_virtual_marker}" "${_virtual_replacement}" _virtual_mutant "${_virtual_bridge_source}")
    if(_virtual_mode STREQUAL "old_commit_order")
        set(_virtual_pointer_wire "    ops->set_pointer(ud, sample.dx, sample.dy, sample.wheel, sample.buttons);")
        string(FIND "${_virtual_mutant}" "${_virtual_pointer_wire}" _virtual_first)
        string(FIND "${_virtual_mutant}" "${_virtual_pointer_wire}" _virtual_last REVERSE)
        if(_virtual_first LESS 0 OR NOT _virtual_first EQUAL _virtual_last)
            message(FATAL_ERROR "Game virtual order control requires one pointer commit wire")
        endif()
        string(REPLACE "${_virtual_pointer_wire}" "${_virtual_pointer_wire}\n    ops->step(ud, dt);" _virtual_mutant "${_virtual_mutant}")
    endif()
    set(_virtual_path "${CMAKE_CURRENT_BINARY_DIR}/game-input-mutation/jce_editor_game_input_${_virtual_mode}.cpp")
    jce_test_write_if_changed("${_virtual_path}" "${_virtual_mutant}")
    jce_add_cxx_test(test_jce_editor_game_input_bridge_${_virtual_mode}
        KIND contract
        SOURCES test_jce_editor_game_input_bridge.cpp "${_virtual_path}"
        LINK jce_core jce_platform)
    set_tests_properties(test_jce_editor_game_input_bridge_${_virtual_mode} PROPERTIES WILL_FAIL TRUE)
endforeach()
foreach(_virtual_cleanup IN ITEMS bridge_source mode marker replacement mutant pointer_wire first last path)
    unset(_virtual_${_virtual_cleanup})
endforeach()
unset(_virtual_cleanup)
