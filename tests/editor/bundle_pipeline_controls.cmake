set(_bundle_rp_owner "${CMAKE_SOURCE_DIR}/editor/src/io/jce_editor_bundle_render_pipeline.cpp")
set(_bundle_rp_scene "${CMAKE_SOURCE_DIR}/editor/src/io/jce_editor_scene_serial.cpp")
set(_bundle_rp_engine "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_render_pipeline.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_bundle_rp_owner}" "${_bundle_rp_scene}" "${_bundle_rp_engine}")
file(READ "${_bundle_rp_owner}" _bundle_rp_source)
file(READ "${_bundle_rp_scene}" _bundle_rp_scene_source)
# Retain prior project-context extraction contracts; inspect only our new wires.
foreach(_entry IN ITEMS jbundle catalog)
    string(FIND "${_bundle_rp_scene_source}" "bool jce_state_load_scene_from_${_entry}(" _begin)
    if(_begin LESS 0)
        message(FATAL_ERROR "Bundle RP requires actual ${_entry} loader")
    endif()
    string(SUBSTRING "${_bundle_rp_scene_source}" ${_begin} -1 _body)
    string(FIND "${_body}" "\nbool jce_state_load_scene_from_catalog(" _next)
    if(_next GREATER 0)
        string(SUBSTRING "${_body}" 0 ${_next} _body)
    endif()
    string(FIND "${_body}" "jce_editor_bundle_pipeline_prepare(&g_bm.pipeline, g_bm.fs)" _prepare)
    string(FIND "${_body}" "jce_fs_set_active_policy(g_bm.fs, JCE_FS_ACTIVE_ISOLATED)" _isolate)
    string(FIND "${_body}" "jce_editor_bundle_pipeline_apply(&g_bm.pipeline)" _apply)
    string(FIND "${_body}" "apply_scene_bytes(display," _consume)
    if(_prepare LESS 0 OR _isolate LESS _prepare OR _apply LESS _isolate OR _consume LESS _apply)
        message(FATAL_ERROR "${_entry} must validate, isolate and apply RP before deserialize")
    endif()
endforeach()
string(FIND "${_bundle_rp_scene_source}" "    g_bm.active_bundle_id.clear();\n    jce_editor_bundle_pipeline_close(&g_bm.pipeline);" _restore)
if(_restore LESS 0)
    message(FATAL_ERROR "Bundle release must restore its saved project pipeline")
endif()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/bundle-pipeline")
foreach(_case IN ITEMS current missing_apply old_active_snapshot)
    set(_source "${_bundle_rp_source}")
    set(_target test_jce_editor_bundle_pipeline)
    set(_kind integration)
    if(_case STREQUAL "missing_apply")
        set(_wire "    jce_render_pipeline_apply(&state->prepared);")
        set(_replacement "    /* ordinary control: omitted actual Bundle publication */")
    elseif(_case STREQUAL "old_active_snapshot")
        set(_wire "jce_render_pipeline_get_requested(&state->previous);")
        set(_replacement "jce_render_pipeline_get(&state->previous);")
    endif()
    if(NOT _case STREQUAL "current")
        string(FIND "${_source}" "${_wire}" _first)
        string(FIND "${_source}" "${_wire}" _last REVERSE)
        if(_first LESS 0 OR NOT _first EQUAL _last)
            message(FATAL_ERROR "Bundle RP ${_case} requires exactly one actual owner wire")
        endif()
        string(REPLACE "${_wire}" "${_replacement}" _source "${_source}")
        if(_source STREQUAL _bundle_rp_source)
            message(FATAL_ERROR "Bundle RP ${_case} requires its actual owner wire")
        endif()
        string(APPEND _target "_${_case}")
        set(_kind contract)
    endif()
    set(_path "${CMAKE_CURRENT_BINARY_DIR}/bundle-pipeline/${_case}.cpp")
    jce_test_write_if_changed("${_path}" "${_source}")
    file(READ "${_path}" _written)
    if(NOT "${_written}" STREQUAL "${_source}")
        message(FATAL_ERROR "Bundle RP ${_case} compiler input differs from its selected owner")
    endif()
    # missing_apply also removes the actual publication child of the new owner
    # scope. Its ordinary fixture assertion is the trace wiring negative.
    jce_add_cxx_test(${_target} KIND ${_kind}
        SOURCES test_jce_editor_bundle_pipeline.cpp "${_path}" "${_bundle_rp_engine}"
        LINK jce_core jce_resource
        INCLUDES "${CMAKE_SOURCE_DIR}/editor/src" "${CMAKE_SOURCE_DIR}/editor/src/io"
            "${CMAKE_SOURCE_DIR}/engine/src")
    target_compile_features(${_target} PRIVATE cxx_std_20)
    set_tests_properties(${_target} PROPERTIES ENVIRONMENT "${JCE_TEST_ENVIRONMENT};JCE_RP_FORCE=")
    if(NOT _case STREQUAL "current")
        set_tests_properties(${_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
