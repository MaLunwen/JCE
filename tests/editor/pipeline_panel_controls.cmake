# Complete actual panel state, init, content and tick; only UI observations use
# typed ports. Real RP and temporary Bundle owners retain policy semantics.
function(_jce_editor_register_pipeline_panel_controls)
    set(_owner "${CMAKE_SOURCE_DIR}/editor/src/panels/jce_panel_render_pipeline.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_owner}")
    file(READ "${_owner}" _source)
    set(_begin "static struct {\n    JceRenderPipelineDesc desc;")
    set(_end "\n/* Shim: Render Pipeline has been merged")
    foreach(_boundary IN ITEMS begin end)
        string(FIND "${_source}" "${_${_boundary}}" _${_boundary}_first)
        string(FIND "${_source}" "${_${_boundary}}" _${_boundary}_last REVERSE)
        if(_${_boundary}_first LESS 0 OR NOT _${_boundary}_first EQUAL _${_boundary}_last)
            message(FATAL_ERROR "Pipeline panel ${_boundary} extraction boundary must be unique")
        endif()
    endforeach()
    if(NOT _end_first GREATER _begin_first)
        message(FATAL_ERROR "Pipeline panel source boundaries must be ordered")
    endif()
    math(EXPR _length "${_end_first} - ${_begin_first}")
    string(SUBSTRING "${_source}" ${_begin_first} ${_length} _actual)
    set(_sync "    jce_render_pipeline_get_requested(&s_rp.desc);\n    if (s_rp.initialized) return;")
    set(_requested "jce_render_pipeline_get_requested(&s_rp.desc);")
    set(_effective "jce_render_pipeline_get(&effective);")
    set(_readout "ImGui::Text(jce_editor_i18n(\"panel.render_pipeline.effective.values\"),")
    foreach(_wire IN ITEMS sync requested effective readout)
        string(FIND "${_actual}" "${_${_wire}}" _first)
        string(FIND "${_actual}" "${_${_wire}}" _last REVERSE)
        if(_first LESS 0 OR NOT _first EQUAL _last)
            message(FATAL_ERROR "Pipeline panel ${_wire} mutation wire must be unique")
        endif()
    endforeach()
    foreach(_variant IN ITEMS current old_cached old_effective old_readout old_dim_readout)
        set(_body "${_actual}")
        set(_target test_jce_editor_pipeline_panel)
        set(_kind integration)
        if(_variant STREQUAL "old_cached")
            string(REPLACE "${_sync}"
                "    if (s_rp.initialized) return;\n    jce_render_pipeline_get_requested(&s_rp.desc);"
                _body "${_body}")
        elseif(_variant STREQUAL "old_effective")
            string(REPLACE "${_requested}" "jce_render_pipeline_get(&s_rp.desc);" _body "${_body}")
        elseif(_variant STREQUAL "old_readout")
            string(REPLACE "${_effective}" "effective = s_rp.desc;" _body "${_body}")
        elseif(_variant STREQUAL "old_dim_readout")
            string(REPLACE "${_readout}"
                "ImGui::TextDisabled(jce_editor_i18n(\"panel.render_pipeline.effective.values\"),"
                _body "${_body}")
        endif()
        if(NOT _variant STREQUAL "current")
            if(_body STREQUAL _actual)
                message(FATAL_ERROR "Pipeline panel ${_variant} must mutate its actual owner")
            endif()
            string(APPEND _target "_${_variant}")
            set(_kind contract)
        endif()
        set(_path "${CMAKE_CURRENT_BINARY_DIR}/pipeline-panel/${_variant}.inc.h")
        jce_test_write_if_changed("${_path}" "${_body}")
        file(READ "${_path}" _written)
        if(NOT _written STREQUAL _body)
            message(FATAL_ERROR "Pipeline panel generated compiler input differs from selected owner")
        endif()
        jce_add_cxx_test(${_target} KIND ${_kind}
            SOURCES test_jce_editor_pipeline_panel.cpp
                "${CMAKE_SOURCE_DIR}/editor/src/io/jce_editor_bundle_render_pipeline.cpp"
                "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_render_pipeline.c"
            LINK jce_core jce_resource
            INCLUDES "${CMAKE_SOURCE_DIR}/editor/src" "${CMAKE_SOURCE_DIR}/engine/src")
        target_compile_features(${_target} PRIVATE cxx_std_20)
        target_compile_definitions(${_target} PRIVATE
            JCE_TEST_EDITOR_PIPELINE_PANEL_OWNER="${_path}")
        set_tests_properties(${_target} PROPERTIES ENVIRONMENT "${JCE_TEST_ENVIRONMENT};JCE_RP_FORCE=")
        if(_kind STREQUAL "contract")
            set_tests_properties(${_target} PROPERTIES WILL_FAIL TRUE)
        endif()
    endforeach()
endfunction()
_jce_editor_register_pipeline_panel_controls()
