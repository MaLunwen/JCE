# Complete actual Recorder owner, typed external providers, real SDK threading.
# Old partition admits the structural 25-frame schedule and must fail ordinary
# runtime budget assertions; it keeps the safety fence so the control never UAFs.
function(jce_editor_recorder_controls)
    if(EMSCRIPTEN)
        message(STATUS "Recorder native-thread ownership controls unavailable on Web")
        return()
    endif()
    set(owner "${CMAKE_SOURCE_DIR}/editor/src/core/jce_editor_recorder.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${owner}")
    file(READ "${owner}" source)
    set(guard "const bool full = g.vinflight >= VID_INFLIGHT_MAX;")
    string(FIND "${source}" "${guard}" first)
    string(FIND "${source}" "${guard}" last REVERSE)
    if(first LESS 0 OR NOT first EQUAL last)
        message(FATAL_ERROR "Recorder whole-owner budget guard must be unique")
    endif()
    set(dir "${CMAKE_CURRENT_BINARY_DIR}/recorder-ownership")
    file(MAKE_DIRECTORY "${dir}")
    foreach(variant IN ITEMS current old_partition old_shared_format)
        set(content "${source}")
        if(variant STREQUAL "old_partition")
            string(REPLACE "${guard}" "const bool full = g.vdepth >= VID_INFLIGHT_MAX;"
                content "${source}")
        elseif(variant STREQUAL "old_shared_format")
            # Restore only mutable shared geometry, retaining extent/borrow
            # fences. The typed codec rejects unsafe extents before reading.
            foreach(field IN ITEMS admission encode format)
                if(field STREQUAL "admission")
                    set(needle "if (why == VideoReject::none && g.format_locked && !same_format(format, g.record_format))")
                elseif(field STREQUAL "encode")
                    set(needle "if (why == VideoReject::none && !same_format(frame->format, g.record_format))")
                else()
                    set(needle "return frame->format;")
                endif()
                string(FIND "${content}" "${needle}" first)
                string(FIND "${content}" "${needle}" last REVERSE)
                if(first LESS 0 OR NOT first EQUAL last)
                    message(FATAL_ERROR "Recorder shared-format control requires unique actual owners")
                endif()
                if(field STREQUAL "format")
                    string(REPLACE "${needle}"
                        "jce_mutex_lock(g.mtx); const CaptureFormat format = {g.width, g.height, g.pitch, g.yflip}; jce_mutex_unlock(g.mtx); return format;"
                        content "${content}")
                else()
                    string(REPLACE "${needle}" "if (false)" content "${content}")
                endif()
            endforeach()
        endif()
        set(path "${dir}/${variant}.inc.cpp")
        jce_test_write_if_changed("${path}" "${content}")
        file(READ "${path}" written)
        if(NOT written STREQUAL content)
            message(FATAL_ERROR "Recorder compiler input differs from selected whole owner")
        endif()
        if(variant STREQUAL "current")
            set(target test_jce_editor_recorder_ownership)
        elseif(variant STREQUAL "old_partition")
            set(target test_jce_editor_recorder_old_partition)
        else()
            set(target test_jce_editor_recorder_old_shared_format)
        endif()
        jce_add_cxx_test(${target} KIND contract
            SOURCES test_jce_editor_recorder_ownership.cpp LINK jce_core)
        target_compile_features(${target} PRIVATE cxx_std_20)
        target_compile_definitions(${target} PRIVATE JCE_TEST_RECORDER_BODY="${path}")
        if(NOT variant STREQUAL "current")
            set_tests_properties(${target} PROPERTIES WILL_FAIL TRUE)
        endif()
    endforeach()
endfunction()
jce_editor_recorder_controls()

# Called after the existing complete host bodies have been selected. Keep the
# shared CMake file below its hard cap; the existing actual-body fixture is reused.
function(jce_editor_recorder_host_control source)
    set(wire "JCE_EDITOR_HOST_SERVICE_CALL(\"editor.cpu_services.recorder\", jce_editor_recorder_update());")
    string(FIND "${source}" "${wire}" first)
    string(FIND "${source}" "${wire}" last REVERSE)
    if(first LESS 0 OR NOT first EQUAL last)
        message(FATAL_ERROR "Recorder main-service control requires its unique actual wire")
    endif()
    # Audit the complete actual main input for a second direct app-update wire.
    # The negative restores only that old line; no app loop is mirrored/executed.
    set(main_owner "${CMAKE_SOURCE_DIR}/editor/src/jce_editor_main.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${main_owner}")
    file(READ "${main_owner}" main_source)
    set(call "jce_editor_recorder_update[ \t\r\n]*[(][ \t\r\n]*[)]")
    string(REGEX MATCHALL "${call}" main_calls "${main_source}")
    list(LENGTH main_calls direct_calls)
    foreach(target IN ITEMS test_jce_editor_host_services test_jce_editor_host_services_missing_wire
            test_jce_editor_host_services_old_quit_only)
        target_compile_definitions(${target} PRIVATE JCE_TEST_RECORDER_MAIN_DIRECT_CALLS=${direct_calls})
    endforeach()
    if(EMSCRIPTEN)
        return()
    endif()
    set(marker "    /* The pre-render poll measured this same host interval once. */")
    string(FIND "${main_source}" "${marker}" first)
    string(FIND "${main_source}" "${marker}" last REVERSE)
    if(first LESS 0 OR NOT first EQUAL last)
        message(FATAL_ERROR "Recorder duplicate-main control requires its unique actual insertion site")
    endif()
    string(REPLACE "${marker}"
        "    jce_editor_recorder_update(); /* Retire a rejected capture format on the main owner. */\n${marker}"
        duplicate_main "${main_source}")
    string(REGEX MATCHALL "${call}" duplicate_calls "${duplicate_main}")
    list(LENGTH duplicate_calls duplicate_count)
    jce_test_write_if_changed(
        "${CMAKE_CURRENT_BINARY_DIR}/host-services-mutation/jce_editor_main_old_duplicate_wire.cpp"
        "${duplicate_main}")
    foreach(variant IN ITEMS no_recorder old_duplicate_main_wire)
        set(content "${source}")
        set(count ${direct_calls})
        if(variant STREQUAL "no_recorder")
            string(REPLACE "${wire}" "(void)&jce_editor_recorder_update;" content "${source}")
        else()
            set(count ${duplicate_count})
        endif()
        set(path "${CMAKE_CURRENT_BINARY_DIR}/host-services-mutation/jce_editor_host_${variant}.h")
        jce_test_write_if_changed("${path}" "${content}")
        set(target test_jce_editor_host_services_${variant})
        jce_add_cxx_test(${target} KIND contract
            SOURCES test_jce_editor_host_services.cpp
                "${CMAKE_SOURCE_DIR}/editor/src/core/jce_editor_test_run.cpp" LINK jce_core)
        target_compile_features(${target} PRIVATE cxx_std_20)
        target_compile_definitions(${target} PRIVATE JCE_TEST_EDITOR_HOST_BODIES="${path}"
            JCE_TEST_RECORDER_MAIN_DIRECT_CALLS=${count}
            JCE_TEST_RUNNER_CHILD_EXE="$<TARGET_FILE:test_jce_editor_test_runner>")
        add_dependencies(${target} test_jce_editor_test_runner)
        set_tests_properties(${target} PROPERTIES WILL_FAIL TRUE)
    endforeach()
endfunction()
