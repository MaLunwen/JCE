# The complete lazy Editor service + actual caller-driven Engine transport.
# Typed ENet/clock ports perform no real network operation.
if(JCE_PLATFORM_WEB)
    message(STATUS "Editor LAN lifecycle native transport fixture unavailable on Web")
    return()
endif()
if(TARGET enet::enet)
    set(_editor_lan_enet enet::enet)
elseif(TARGET enet)
    set(_editor_lan_enet enet)
else()
    message(FATAL_ERROR "Editor LAN fixture requires the configured ENet header target")
endif()
set(_editor_lan_core "${CMAKE_SOURCE_DIR}/editor/src/core/jce_editor.cpp")
set(_editor_lan_panels "${CMAKE_SOURCE_DIR}/editor/src/ui/jce_editor_panels.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_editor_lan_core}" "${_editor_lan_panels}")
function(_jce_editor_lan_body path signature output)
    file(READ "${path}" source)
    string(FIND "${source}" "${signature}" first)
    string(FIND "${source}" "${signature}" last REVERSE)
    if(first LESS 0 OR NOT first EQUAL last)
        message(FATAL_ERROR "Editor LAN fixture requires unique actual body: ${signature}")
    endif()
    string(SUBSTRING "${source}" ${first} -1 tail)
    string(FIND "${tail}" "\n}\n" end)
    if(end LESS 0)
        message(FATAL_ERROR "Editor LAN fixture actual function end unavailable")
    endif()
    math(EXPR length "${end} + 3")
    string(SUBSTRING "${tail}" 0 ${length} body)
    set(${output} "${body}" PARENT_SCOPE)
endfunction()
_jce_editor_lan_body("${_editor_lan_core}"
    "void jce_editor_tick_cpu_services(float dt, bool refresh_ui_clock)" _editor_lan_update)
_jce_editor_lan_body("${_editor_lan_panels}"
    "void jce_editor_panels_shutdown(void)" _editor_lan_shutdown)
set(_editor_lan_normal "${_editor_lan_update}\n${_editor_lan_shutdown}")
set(_editor_lan_update_wire "JCE_EDITOR_HOST_SERVICE_CALL(\"editor.cpu_services.lan_discovery\", jce_editor_lan_discovery_update());")
set(_editor_lan_shutdown_wire "jce_editor_lan_discovery_shutdown();")
foreach(_editor_lan_variant IN ITEMS normal missing_update missing_shutdown)
    set(_editor_lan_body "${_editor_lan_normal}")
    if(_editor_lan_variant STREQUAL "missing_update")
        set(_editor_lan_wire "${_editor_lan_update_wire}")
    elseif(_editor_lan_variant STREQUAL "missing_shutdown")
        set(_editor_lan_wire "${_editor_lan_shutdown_wire}")
    endif()
    if(NOT _editor_lan_variant STREQUAL "normal")
        string(FIND "${_editor_lan_body}" "${_editor_lan_wire}" first)
        string(FIND "${_editor_lan_body}" "${_editor_lan_wire}" last REVERSE)
        if(first LESS 0 OR NOT first EQUAL last)
            message(FATAL_ERROR "Editor LAN mutation requires one actual lifecycle wire")
        endif()
        string(REPLACE "${_editor_lan_wire}" "(void)0;" _editor_lan_body "${_editor_lan_body}")
    endif()
    set(_editor_lan_path "${CMAKE_CURRENT_BINARY_DIR}/lan-discovery/jce_editor_lan_${_editor_lan_variant}.h")
    jce_test_write_if_changed("${_editor_lan_path}" "${_editor_lan_body}")
    set(_editor_lan_target test_jce_editor_lan_discovery)
    set(_editor_lan_kind integration)
    if(NOT _editor_lan_variant STREQUAL "normal")
        string(APPEND _editor_lan_target "_${_editor_lan_variant}")
        set(_editor_lan_kind contract)
    endif()
    jce_add_cxx_test(${_editor_lan_target} KIND ${_editor_lan_kind}
        SOURCES test_jce_editor_lan_discovery.cpp
            "${CMAKE_SOURCE_DIR}/editor/src/core/jce_editor_lan_discovery.cpp"
        LINK jce_core ${_editor_lan_enet}
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src")
    target_compile_features(${_editor_lan_target} PRIVATE cxx_std_20)
    target_compile_definitions(${_editor_lan_target} PRIVATE
        JCE_TEST_LAN_TRANSPORT_OWNER="${CMAKE_SOURCE_DIR}/engine/src/middleware/net/jce_lan_discovery.c"
        JCE_TEST_LAN_HOST_BODIES="${_editor_lan_path}")
    if(NOT _editor_lan_variant STREQUAL "normal")
        set_tests_properties(${_editor_lan_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
