# Single classification authority for registered JCE tests (CMake >= 3.20).
# Domains describe source ownership, never the assertion language. Kinds describe
# evidence scope; a Noop/stub test is not a graphical test. Real graphical tests
# must be registered by their explicit opt-in fixture, not by this classifier.
include_guard(GLOBAL)
get_filename_component(_JCE_TEST_REPOSITORY_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

function(_jce_test_owner_domain DIRECTORY_PATH OUT)
    file(RELATIVE_PATH _relative "${_JCE_TEST_REPOSITORY_ROOT}" "${DIRECTORY_PATH}")
    if(_relative MATCHES "^tests/editor(/|$)")
        set(_domain editor)
    elseif(_relative MATCHES "^tests/(consumers|sdk_smoke|sdk_smoke_scripting)(/|$)"
           OR _relative MATCHES "^examples/[^/]+(/|$)")
        set(_domain consumer)
    elseif(_relative STREQUAL "tests"
           OR _relative MATCHES "^tests/(os|application|renderer|middleware|scripting)(/|$)"
           OR _relative MATCHES "^private/tests(/|$)")
        set(_domain engine)
    else()
        message(FATAL_ERROR "JCE test directory has no domain owner: ${_relative}")
    endif()
    set(${OUT} "${_domain}" PARENT_SCOPE)
endfunction()

# Build inputs follow the registering call site's same source-domain authority.
# A tool/script provider may live outside tests or serve multiple domains; its
# target SOURCE_DIR does not determine which suite needs it.
function(jce_create_test_domain_targets)
    if(NOT TARGET jce_tests)
        message(FATAL_ERROR "Create the all-suite jce_tests target before its domains")
    endif()
    foreach(_domain IN ITEMS engine editor consumer)
        add_custom_target(jce_tests_${_domain})
    endforeach()
endfunction()

function(jce_test_build_dependencies)
    if(NOT ARGN)
        message(FATAL_ERROR "JCE test build inputs must not be empty")
    endif()
    _jce_test_owner_domain("${CMAKE_CURRENT_SOURCE_DIR}" _domain)
    if(NOT TARGET jce_tests OR NOT TARGET jce_tests_${_domain})
        message(FATAL_ERROR "JCE test build aggregates have not been created")
    endif()
    foreach(_input IN LISTS ARGN)
        if(NOT TARGET ${_input})
            message(FATAL_ERROR "JCE ${_domain} test build input is not a target: ${_input}")
        endif()
    endforeach()
    # A witness from this single call site lets the final audit detect a removed
    # all/domain wire or a manual unclassified dependency, without another catalog.
    set_property(TARGET jce_tests_${_domain} APPEND PROPERTY JCE_TEST_BUILD_INPUTS ${ARGN})
    add_dependencies(jce_tests ${ARGN})
    add_dependencies(jce_tests_${_domain} ${ARGN})
endfunction()

function(_jce_assert_test_build_closure)
    if(NOT TARGET jce_tests)
        return() # Metadata-only standalone registrations need no native inputs.
    endif()
    set(_union "")
    foreach(_domain IN ITEMS engine editor consumer)
        if(NOT TARGET jce_tests_${_domain})
            message(FATAL_ERROR "JCE tests are missing their ${_domain} build aggregate")
        endif()
        get_property(_required TARGET jce_tests_${_domain} PROPERTY JCE_TEST_BUILD_INPUTS)
        get_property(_wired TARGET jce_tests_${_domain} PROPERTY MANUALLY_ADDED_DEPENDENCIES)
        list(REMOVE_DUPLICATES _required)
        list(REMOVE_DUPLICATES _wired)
        list(SORT _required)
        list(SORT _wired)
        if(NOT "${_required}" STREQUAL "${_wired}")
            message(FATAL_ERROR "JCE ${_domain} test build inputs are not wired: required=${_required}, wired=${_wired}")
        endif()
        list(APPEND _union ${_required})
    endforeach()
    get_property(_all TARGET jce_tests PROPERTY MANUALLY_ADDED_DEPENDENCIES)
    list(REMOVE_DUPLICATES _union)
    list(REMOVE_DUPLICATES _all)
    list(SORT _union)
    list(SORT _all)
    if(NOT "${_union}" STREQUAL "${_all}")
        message(FATAL_ERROR "JCE all-test closure differs from its domain build inputs: domains=${_union}, all=${_all}")
    endif()
endfunction()

function(jce_set_test_kind NAME KIND)
    if(NOT KIND MATCHES "^(unit|integration|graphical|contract)$")
        message(FATAL_ERROR "JCE test ${NAME} has invalid kind: ${KIND}")
    endif()
    set_tests_properties("${NAME}" PROPERTIES JCE_TEST_KIND "${KIND}")
endfunction()

function(_jce_finalize_test_directory)
    get_property(_tests DIRECTORY PROPERTY TESTS)
    if(NOT _tests)
        return()
    endif()
    _jce_test_owner_domain("${CMAKE_CURRENT_SOURCE_DIR}" _domain)
    foreach(_name IN LISTS _tests)
        get_test_property("${_name}" JCE_TEST_KIND _kind)
        if(NOT _kind MATCHES "^(unit|integration|graphical|contract)$")
            message(FATAL_ERROR "JCE test ${_name} is missing a valid JCE_TEST_KIND")
        endif()
        get_test_property("${_name}" JCE_TEST_DOMAIN _declared_domain)
        if(NOT _declared_domain STREQUAL "NOTFOUND" AND NOT _declared_domain STREQUAL _domain)
            message(FATAL_ERROR "JCE test ${_name} has wrong domain ${_declared_domain}, expected ${_domain}")
        endif()
        get_test_property("${_name}" LABELS _labels)
        if(_labels STREQUAL "NOTFOUND")
            set(_labels "")
        endif()
        foreach(_label IN LISTS _labels)
            if((_label MATCHES "^domain:" AND NOT _label STREQUAL "domain:${_domain}")
               OR (_label MATCHES "^(engine|editor|consumer)$" AND NOT _label STREQUAL _domain))
                message(FATAL_ERROR "JCE test ${_name} has wrong domain label: ${_label}")
            endif()
            if(_label MATCHES "^kind:" AND NOT _label STREQUAL "kind:${_kind}")
                message(FATAL_ERROR "JCE test ${_name} has wrong kind label: ${_label}")
            endif()
        endforeach()
        list(APPEND _labels "domain:${_domain}" "${_domain}" "kind:${_kind}")
        list(REMOVE_DUPLICATES _labels)
        set_tests_properties("${_name}" PROPERTIES
            JCE_TEST_DOMAIN "${_domain}" LABELS "${_labels}")
        set_property(DIRECTORY APPEND PROPERTY JCE_TESTS_CLASSIFIED "${_name}")
    endforeach()
endfunction()

# DEFER runs in the registering directory, including return()/optional-backend
# branches. Parent-directory test-property access requires newer CMake; do not
# silently lose raw add_test(), script tests or same-executable variants.
function(jce_register_test_directory)
    get_property(_registered DIRECTORY PROPERTY JCE_TEST_METADATA_REGISTERED)
    if(NOT _registered)
        set_property(DIRECTORY PROPERTY JCE_TEST_METADATA_REGISTERED TRUE)
        cmake_language(DEFER CALL _jce_finalize_test_directory)
    endif()
endfunction()

function(_jce_assert_test_metadata_directory DIRECTORY_PATH)
    get_property(_tests DIRECTORY "${DIRECTORY_PATH}" PROPERTY TESTS)
    get_property(_classified DIRECTORY "${DIRECTORY_PATH}" PROPERTY JCE_TESTS_CLASSIFIED)
    foreach(_name IN LISTS _tests)
        if(NOT _name IN_LIST _classified)
            message(FATAL_ERROR "JCE test ${_name} has no domain/kind registration; call jce_register_test_directory()")
        endif()
    endforeach()
    get_property(_children DIRECTORY "${DIRECTORY_PATH}" PROPERTY SUBDIRECTORIES)
    foreach(_child IN LISTS _children)
        _jce_assert_test_metadata_directory("${_child}")
    endforeach()
endfunction()

function(jce_assert_test_metadata)
    _jce_assert_test_metadata_directory("${CMAKE_CURRENT_SOURCE_DIR}")
    _jce_assert_test_build_closure()
endfunction()
