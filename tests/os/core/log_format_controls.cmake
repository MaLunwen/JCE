# Complete actual logger and real native sink/IO, with one typed CRT error port.
if(EMSCRIPTEN)
    jce_test_suite_skipped("log-format" "requires native logger worker/IO controls")
    return()
endif()
set(_log_format_owner "${CMAKE_SOURCE_DIR}/engine/src/os/core/jce_log.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_log_format_owner}")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/log-format")
file(READ "${_log_format_owner}" _log_format_source)
set(_log_format_wire "if (required >= 0 && (size_t)required < capacity) return;")
string(REPLACE "${_log_format_wire}" "" _log_format_without "${_log_format_source}")
string(LENGTH "${_log_format_source}" _log_format_before)
string(LENGTH "${_log_format_without}" _log_format_after)
string(LENGTH "${_log_format_wire}" _log_format_width)
math(EXPR _log_format_removed "${_log_format_before} - ${_log_format_after}")
if(NOT _log_format_removed EQUAL _log_format_width)
    message(FATAL_ERROR "log-format control requires one exact actual formatter admission")
endif()
string(REPLACE "${_log_format_wire}" "if (required >= 0) return; /* old silent truncation */"
    _log_format_old "${_log_format_source}")
set(_log_format_old_path "${CMAKE_CURRENT_BINARY_DIR}/log-format/old_silent.c")
jce_test_write_if_changed("${_log_format_old_path}" "${_log_format_old}")
foreach(_log_format_variant IN ITEMS current old_silent)
    set(_log_format_name test_jce_log_format)
    set(_log_format_kind unit)
    set(_log_format_selected "${_log_format_owner}")
    if(_log_format_variant STREQUAL "old_silent")
        string(APPEND _log_format_name "_old_silent")
        set(_log_format_kind contract)
        set(_log_format_selected "${_log_format_old_path}")
    endif()
    jce_add_unit_test(${_log_format_name} KIND ${_log_format_kind}
        SOURCES test_jce_log_format.c LINK jce_core sdl::sdl zstd::libzstd_static
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src" "${CMAKE_SOURCE_DIR}/engine/src/os/core")
    target_compile_definitions(${_log_format_name} PRIVATE
        JCE_TEST_LOG_OWNER="${_log_format_selected}"
        JCE_TEST_LOG_FORMAT_PATH="${CMAKE_CURRENT_BINARY_DIR}/log-format/${_log_format_variant}.log")
    if(_log_format_kind STREQUAL "contract")
        set_tests_properties(${_log_format_name} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_log_format_key IN ITEMS owner source wire without before after width removed
        old old_path variant name kind selected)
    unset(_log_format_${_log_format_key})
endforeach()
unset(_log_format_key)
