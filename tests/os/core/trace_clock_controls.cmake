# Real SDL lifetime restart and full actual trace TU with deterministic clocks.
if(EMSCRIPTEN)
    jce_test_suite_skipped("trace-clock-restart" "requires native SDL lifetime restart")
    return()
endif()
set(_trace_clock_owner "${CMAKE_SOURCE_DIR}/engine/src/os/core/jce_trace.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_trace_clock_owner}")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/trace-clock")
foreach(_trace_clock_variant IN ITEMS current old_sdl_ticks)
    set(_trace_clock_name test_jce_trace_clock)
    set(_trace_clock_selected "${_trace_clock_owner}")
    set(_trace_clock_kind integration)
    if(_trace_clock_variant STREQUAL "old_sdl_ticks")
        string(APPEND _trace_clock_name "_old_sdl_ticks")
        set(_trace_clock_kind contract)
        file(READ "${_trace_clock_owner}" _trace_clock_source)
        set(_trace_clock_wire "    if (!jce_trace_clock_now_internal(&event.timestamp_ns)) return;")
        string(REPLACE "${_trace_clock_wire}" "" _trace_clock_without "${_trace_clock_source}")
        string(LENGTH "${_trace_clock_source}" _trace_clock_before)
        string(LENGTH "${_trace_clock_without}" _trace_clock_after)
        string(LENGTH "${_trace_clock_wire}" _trace_clock_width)
        math(EXPR _trace_clock_removed "${_trace_clock_before} - ${_trace_clock_after}")
        if(NOT _trace_clock_removed EQUAL _trace_clock_width)
            message(FATAL_ERROR "trace clock control requires exactly one timestamp owner wire")
        endif()
        string(REPLACE "${_trace_clock_wire}" "    event.timestamp_ns = jce_time_ticks_ns();"
            _trace_clock_source "${_trace_clock_source}")
        set(_trace_clock_selected "${CMAKE_CURRENT_BINARY_DIR}/trace-clock/old_sdl_ticks.c")
        jce_test_write_if_changed("${_trace_clock_selected}" "${_trace_clock_source}")
    endif()
    jce_add_unit_test(${_trace_clock_name} KIND ${_trace_clock_kind}
        SOURCES test_jce_trace_clock.c LINK jce_core sdl::sdl
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src" "${CMAKE_SOURCE_DIR}/engine/src/os/core")
    target_compile_definitions(${_trace_clock_name} PRIVATE
        JCE_TEST_TRACE_CLOCK_OWNER="${_trace_clock_selected}")
    if(_trace_clock_kind STREQUAL "contract")
        set_tests_properties(${_trace_clock_name} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_trace_clock_key IN ITEMS owner variant name selected kind source wire without
        before after width removed)
    unset(_trace_clock_${_trace_clock_key})
endforeach()
unset(_trace_clock_key)
