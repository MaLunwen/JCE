if(EMSCRIPTEN)
    jce_test_suite_skipped("thread-retirement" "requires a native running worker")
    return()
endif()
set(_thread_retire_owner "${CMAKE_SOURCE_DIR}/engine/src/os/core/jce_thread.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_thread_retire_owner}")
file(READ "${_thread_retire_owner}" _thread_retire_source)
set(_thread_retire_wire "    g_shared_closing = true;")
string(FIND "${_thread_retire_source}" "${_thread_retire_wire}" _thread_retire_first)
string(FIND "${_thread_retire_source}" "${_thread_retire_wire}" _thread_retire_last REVERSE)
if(_thread_retire_first LESS 0 OR NOT _thread_retire_first EQUAL _thread_retire_last)
    message(FATAL_ERROR "Thread retirement control requires one actual join-admission wire")
endif()
string(REPLACE "${_thread_retire_wire}"
    "    /* old: detached shared pool can be recreated during its native join */"
    _thread_retire_old "${_thread_retire_source}")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/thread-retirement")
set(_thread_retire_mutant "${CMAKE_CURRENT_BINARY_DIR}/thread-retirement/old_join_reopen.c")
jce_test_write_if_changed("${_thread_retire_mutant}" "${_thread_retire_old}")
foreach(_thread_retire_variant IN ITEMS current old_join_reopen)
    set(_thread_retire_name test_jce_thread_retirement)
    set(_thread_retire_kind integration)
    set(_thread_retire_selected "${_thread_retire_owner}")
    if(_thread_retire_variant STREQUAL "old_join_reopen")
        string(APPEND _thread_retire_name "_old_join_reopen")
        set(_thread_retire_kind contract)
        set(_thread_retire_selected "${_thread_retire_mutant}")
    endif()
    jce_add_unit_test(${_thread_retire_name} KIND ${_thread_retire_kind}
        SOURCES test_jce_thread_retirement.c LINK jce_core sdl::sdl enkits::enkits
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src" "${CMAKE_SOURCE_DIR}/engine/src/os/core")
    target_compile_definitions(${_thread_retire_name} PRIVATE
        JCE_TEST_THREAD_RETIREMENT_OWNER="${_thread_retire_selected}")
    set_tests_properties(${_thread_retire_name} PROPERTIES TIMEOUT 30)
    if(_thread_retire_kind STREQUAL "contract")
        set_tests_properties(${_thread_retire_name} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_thread_retire_key IN ITEMS owner source wire first last old mutant variant name kind selected)
    unset(_thread_retire_${_thread_retire_key})
endforeach()
unset(_thread_retire_key)
