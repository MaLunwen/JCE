# Real dedicated logger/capture workers and the shared Engine retirement order.
if(EMSCRIPTEN)
    jce_test_suite_skipped("diagnostics-retirement" "requires native dedicated workers")
    return()
endif()
set(_retire_sequence "${CMAKE_SOURCE_DIR}/engine/src/application/jce_engine_diagnostics_retirement.h")
set(_retire_log "${CMAKE_SOURCE_DIR}/engine/src/os/core/jce_log.c")
set(_retire_capture "${CMAKE_SOURCE_DIR}/engine/src/os/core/jce_trace_capture.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_retire_sequence}" "${_retire_log}" "${_retire_capture}")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/diagnostics-retirement")
foreach(_retire_variant IN ITEMS current missing_capture_join missing_log_join
        old_async_tail old_worker_available old_join_parent old_close_success)
    set(_retire_name test_jce_diagnostics_retirement)
    set(_retire_kind integration)
    set(_retire_selected_sequence "${_retire_sequence}")
    set(_retire_selected_log "${_retire_log}")
    set(_retire_extra_source)
    if(NOT _retire_variant STREQUAL "current")
        string(APPEND _retire_name "_${_retire_variant}")
        set(_retire_kind contract)
        set(_retire_count 1)
        if(_retire_variant STREQUAL "missing_capture_join")
            set(_retire_owner sequence)
            set(_retire_wire "    jce_trace_capture_quiesce(capture);")
            set(_retire_old "    (void)capture; /* omitted capture worker join */")
        elseif(_retire_variant STREQUAL "missing_log_join")
            set(_retire_owner sequence)
            set(_retire_wire "    JCE_ENGINE_TRACE_CALL(\"engine.log_quiesce\", jce_log_quiesce_internal());")
            set(_retire_old "    /* omitted logger worker join */")
        elseif(_retire_variant STREQUAL "old_async_tail")
            set(_retire_owner log)
            set(_retire_wire "if (g_ring && g_backend_thread) {")
            set(_retire_old "if (g_ring) {")
            set(_retire_count 2)
        elseif(_retire_variant STREQUAL "old_worker_available")
            set(_retire_owner capture)
            set(_retire_wire "const bool worker_available = capture->worker_available;")
            set(_retire_old "const bool worker_available = capture->worker != NULL;")
        elseif(_retire_variant STREQUAL "old_join_parent")
            set(_retire_owner capture)
            set(_retire_wire "jce_trace_wait_end(wait_id, wait_parent, \"trace.capture.join\",")
            set(_retire_old "jce_trace_wait_end(wait_id, 0, \"trace.capture.join\",")
        elseif(_retire_variant STREQUAL "old_close_success")
            set(_retire_owner log)
            set(_retire_wire "g_log_status.final_close = flushed && closed ? JCE_LOG_FINAL_CLOSE_API_OK")
            set(_retire_old "g_log_status.final_close = true ? JCE_LOG_FINAL_CLOSE_API_OK")
        else()
            message(FATAL_ERROR "Unknown diagnostic retirement variant: ${_retire_variant}")
        endif()
        file(READ "${_retire_${_retire_owner}}" _retire_source)
        string(REPLACE "${_retire_wire}" "" _retire_without "${_retire_source}")
        string(LENGTH "${_retire_source}" _retire_before)
        string(LENGTH "${_retire_without}" _retire_after)
        string(LENGTH "${_retire_wire}" _retire_width)
        math(EXPR _retire_expected "${_retire_count} * ${_retire_width}")
        math(EXPR _retire_removed "${_retire_before} - ${_retire_after}")
        if(NOT _retire_removed EQUAL _retire_expected)
            message(FATAL_ERROR "${_retire_name} requires ${_retire_count} exact owner wires")
        endif()
        string(REPLACE "${_retire_wire}" "${_retire_old}" _retire_source "${_retire_source}")
        set(_retire_output "${CMAKE_CURRENT_BINARY_DIR}/diagnostics-retirement/${_retire_variant}.c")
        jce_test_write_if_changed("${_retire_output}" "${_retire_source}")
        if(_retire_owner STREQUAL "capture")
            set(_retire_extra_source "${_retire_output}")
        else()
            set(_retire_selected_${_retire_owner} "${_retire_output}")
        endif()
    endif()
    jce_add_unit_test(${_retire_name} KIND ${_retire_kind}
        SOURCES test_jce_diagnostics_retirement.c ${_retire_extra_source}
        LINK jce_core sdl::sdl zstd::libzstd_static
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src"
            "${CMAKE_SOURCE_DIR}/engine/src/os/core"
            "${CMAKE_SOURCE_DIR}/engine/src/application")
    target_compile_definitions(${_retire_name} PRIVATE
        JCE_TEST_LOG_OWNER="${_retire_selected_log}"
        JCE_TEST_DIAGNOSTICS_RETIREMENT_OWNER="${_retire_selected_sequence}"
        JCE_TEST_DIAGNOSTICS_PREFIX="${CMAKE_CURRENT_BINARY_DIR}/diagnostics-retirement/${_retire_variant}")
    if(_retire_kind STREQUAL "contract")
        set_tests_properties(${_retire_name} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_retire_key IN ITEMS sequence log capture variant name kind selected_sequence
        selected_log extra_source owner wire old count source without before after
        width expected removed output)
    unset(_retire_${_retire_key})
endforeach()
unset(_retire_key)
