# Exact original numeric formatter/export body is a test-only byte oracle.
function(jce_trace_json_integer_controls)
    set(owner "${CMAKE_SOURCE_DIR}/engine/src/os/core/jce_trace.c")
    set(legacy "${CMAKE_CURRENT_SOURCE_DIR}/trace_json_integer_legacy.inc")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${owner}" "${legacy}")
    file(READ "${owner}" source)
    file(READ "${legacy}" old_export)
    string(FIND "${source}" "static bool trace_json_reserve(" begin)
    string(FIND "${source}" "uint32_t jce_trace_capture_generation(void)" end)
    string(FIND "${source}" "bool jce_trace_chrome_encode_batch_into(" batch_begin)
    string(FIND "${source}" "bool jce_trace_chrome_encode_batch(" batch_end)
    if(begin LESS 0 OR end LESS_EQUAL begin OR batch_begin LESS end OR batch_end LESS_EQUAL batch_begin)
        message(FATAL_ERROR "Integer codec owner boundaries changed")
    endif()
    math(EXPR length "${end} - ${begin}")
    string(SUBSTRING "${source}" ${begin} ${length} helpers)
    math(EXPR length "${batch_end} - ${batch_begin}")
    string(SUBSTRING "${source}" ${batch_begin} ${length} batch)
    set(current "${helpers}\n${batch}")
    string(FIND "${helpers}" "static bool trace_json_append_format(" fmt_begin)
    if(NOT fmt_begin LESS 0)
        string(FIND "${helpers}" "static bool trace_json_append_escaped(" fmt_end)
        math(EXPR length "${fmt_end} - ${fmt_begin}")
        string(SUBSTRING "${helpers}" ${fmt_begin} ${length} old_format)
        string(REPLACE "${old_format}" "" helpers "${helpers}")
    endif()
    string(FIND "${helpers}" "static bool trace_export_event(" export_begin)
    if(export_begin LESS 0)
        message(FATAL_ERROR "Integer codec export owner missing")
    endif()
    string(SUBSTRING "${helpers}" 0 ${export_begin} before_export)
    set(old "${before_export}\n${old_export}\n${batch}")
    set(dir "${CMAKE_CURRENT_BINARY_DIR}/trace-json-integer")
    foreach(mode IN ITEMS current old)
        set(path "${dir}/${mode}.inc")
        jce_test_write_if_changed("${path}" "${${mode}}")
        jce_test_write_if_changed("${dir}/${mode}_reference.c"
            "#include <SDL3/SDL.h>\n#include <string.h>\n#include \"os/core/jce_memory.h\"\n#include \"os/core/jce_trace_capture_internal.h\"\n#define jce_trace_chrome_encode_batch_into ${mode}_reference_encode_into\n#include \"${path}\"\n")
    endforeach()
    foreach(mode IN ITEMS current old)
        set(name test_jce_trace_json_integer)
        set(kind unit)
        if(mode STREQUAL "old")
            string(APPEND name _old_printf)
            set(kind contract)
        endif()
        jce_add_unit_test(${name} KIND ${kind}
            SOURCES test_jce_trace_json_span.c "${dir}/current_reference.c" "${dir}/old_reference.c"
            LINK jce_core sdl::sdl INCLUDES "${CMAKE_SOURCE_DIR}/engine/src")
        target_compile_definitions(${name} PRIVATE
            JCE_TEST_TRACE_JSON_CODEC_OWNER="${dir}/${mode}.inc")
        if(mode STREQUAL "old")
            set_tests_properties(${name} PROPERTIES WILL_FAIL TRUE)
        endif()
    endforeach()
endfunction()
jce_trace_json_integer_controls()
