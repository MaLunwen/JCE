# Complete actual renderer factory/destroy and scene decal drive/reset bodies.
set(_da_renderer "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_decals.c")
set(_da_scene "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene/jce_sr_environment.c")
set(_da_state "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene/jce_sr_internal.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_da_renderer}" "${_da_scene}" "${_da_state}")
file(READ "${_da_renderer}" _da_renderer_source)
file(READ "${_da_scene}" _da_scene_source)
file(READ "${_da_state}" _da_state_source)
string(FIND "${_da_state_source}" "bool             decals_authored_tried;" _da_field)
if(_da_field LESS 0)
    message(FATAL_ERROR "Decal retry fixture requires actual per-SR private retry field")
endif()
function(_jce_decal_between OUTPUT SOURCE BEGIN END)
    string(FIND "${SOURCE}" "${BEGIN}" _first)
    string(FIND "${SOURCE}" "${BEGIN}" _last REVERSE)
    string(FIND "${SOURCE}" "${END}" _stop)
    string(FIND "${SOURCE}" "${END}" _last_stop REVERSE)
    if(_first LESS 0 OR NOT _first EQUAL _last OR _stop LESS_EQUAL _first OR NOT _stop EQUAL _last_stop)
        message(FATAL_ERROR "Decal fixture requires complete unique ordered owner ${OUTPUT}")
    endif()
    math(EXPR _length "${_stop} - ${_first}")
    string(SUBSTRING "${SOURCE}" ${_first} ${_length} _body)
    set(${OUTPUT} "${_body}" PARENT_SCOPE)
endfunction()
_jce_decal_between(_da_pool "${_da_renderer_source}"
    "typedef struct {\n    jce_vec3   position;" "/* ---- spawn / update")
_jce_decal_between(_da_drive "${_da_scene_source}"
    "void sr_drive_decals(" "uint32_t sr_foliage_hash(")
_jce_decal_between(_da_reset "${_da_scene_source}"
    "void jce_scene_renderer_reset_entity_caches(" "static JceMesh *sr_fcluster_build_expanded_mesh(")
set(_da_output "${CMAKE_CURRENT_BINARY_DIR}/decal-admission-controls")
file(MAKE_DIRECTORY "${_da_output}")
foreach(_da_variant IN ITEMS current empty_gate missing_retry missing_profile)
    set(_da_pool_body "${_da_pool}")
    set(_da_drive_body "${_da_drive}")
    set(_da_kind unit)
    set(_da_target test_jce_decal_admission)
    if(_da_variant STREQUAL "empty_gate")
        string(REPLACE "if (has_authored && !sr->decals_authored && !sr->decals_authored_tried)"
            "if (!sr->decals_authored && !sr->decals_authored_tried)" _da_drive_body "${_da_drive_body}")
    elseif(_da_variant STREQUAL "missing_retry")
        string(REPLACE " && !sr->decals_authored_tried" "" _da_drive_body "${_da_drive_body}")
    elseif(_da_variant STREQUAL "missing_profile")
        string(REPLACE "if (jce_renderer_shader_profile_compatibility(&api, bgfx_get_renderer_type())) {"
            "if (jce_renderer_shader_profile_compatibility(&api, bgfx_get_renderer_type()) && false) {"
            _da_pool_body "${_da_pool_body}")
    endif()
    if(NOT _da_variant STREQUAL "current")
        if(_da_pool_body STREQUAL _da_pool AND _da_drive_body STREQUAL _da_drive)
            message(FATAL_ERROR "Decal complete-owner mutation did not change ${_da_variant}")
        endif()
        set(_da_kind contract)
        string(APPEND _da_target "_${_da_variant}")
    endif()
    set(_da_pool_path "${_da_output}/${_da_variant}-pool.inc.h")
    set(_da_drive_path "${_da_output}/${_da_variant}-drive.inc.h")
    set(_da_reset_path "${_da_output}/reset.inc.h")
    jce_test_write_if_changed("${_da_pool_path}" "${_da_pool_body}")
    jce_test_write_if_changed("${_da_drive_path}" "${_da_drive_body}")
    jce_test_write_if_changed("${_da_reset_path}" "${_da_reset}")
    jce_add_unit_test(${_da_target} KIND ${_da_kind}
        SOURCES test_jce_decal_admission.c LINK jce_core)
    target_include_directories(${_da_target} PRIVATE "${CMAKE_SOURCE_DIR}/engine/src"
        "$<TARGET_PROPERTY:bgfx::bgfx,INTERFACE_INCLUDE_DIRECTORIES>")
    target_compile_definitions(${_da_target} PRIVATE JCE_DIST=1
        JCE_TEST_DECAL_POOL_OWNER="${_da_pool_path}"
        JCE_TEST_DECAL_SCENE_OWNER="${_da_drive_path}"
        JCE_TEST_DECAL_RESET_OWNER="${_da_reset_path}")
    if(MSVC)
        target_compile_options(${_da_target} PRIVATE /Zc:preprocessor)
    endif()
    if(_da_kind STREQUAL "contract")
        set_tests_properties(${_da_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_da_variable IN ITEMS renderer scene state renderer_source scene_source state_source field
        pool drive reset output variant pool_body drive_body kind target pool_path drive_path reset_path)
    unset(_da_${_da_variable})
endforeach()
unset(_da_variable)
