# Actual PBR main prefix, with only its complete shadow dependency ported.
set(_pa_owner "${CMAKE_SOURCE_DIR}/engine/shaders/pbr/fs_pbr_main.sh")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_pa_owner}")
file(READ "${_pa_owner}" _pa_source)
set(_pa_main "void main()\n{\n")
set(_pa_material "    // --- Base color ---\n")
set(_pa_shadow "    // --- Shadow calculation ---\n")
set(_pa_normal "    // --- Normal ---\n")
foreach(_pa_anchor IN ITEMS main material shadow normal)
    string(FIND "${_pa_source}" "${_pa_${_pa_anchor}}" _pa_${_pa_anchor}_first)
    string(FIND "${_pa_source}" "${_pa_${_pa_anchor}}" _pa_${_pa_anchor}_last REVERSE)
    if(_pa_${_pa_anchor}_first LESS 0 OR
       NOT _pa_${_pa_anchor}_first EQUAL _pa_${_pa_anchor}_last)
        message(FATAL_ERROR "PBR alpha control needs one complete actual ${_pa_anchor} boundary")
    endif()
endforeach()
if(NOT (_pa_main_first LESS _pa_material_first AND
        _pa_material_first LESS _pa_shadow_first AND
        _pa_shadow_first LESS _pa_normal_first))
    message(FATAL_ERROR "PBR alpha control actual main boundaries changed order")
endif()
math(EXPR _pa_length "${_pa_material_first} - ${_pa_main_first}")
string(SUBSTRING "${_pa_source}" ${_pa_main_first} ${_pa_length} _pa_prefix)
math(EXPR _pa_length "${_pa_shadow_first} - ${_pa_material_first}")
string(SUBSTRING "${_pa_source}" ${_pa_material_first} ${_pa_length} _pa_material_body)
math(EXPR _pa_length "${_pa_normal_first} - ${_pa_shadow_first}")
string(SUBSTRING "${_pa_source}" ${_pa_shadow_first} ${_pa_length} _pa_shadow_body)
math(EXPR _pa_length "${_pa_normal_first} - ${_pa_main_first}")
string(SUBSTRING "${_pa_source}" ${_pa_main_first} ${_pa_length} _pa_actual)
set(_pa_port "    jce_test_shadow_dependency();\n\n")
string(REPLACE "${_pa_shadow_body}" "${_pa_port}" _pa_current "${_pa_actual}")
string(CONCAT _pa_old "${_pa_prefix}" "${_pa_port}" "${_pa_material_body}")
if(_pa_current STREQUAL _pa_old)
    message(FATAL_ERROR "PBR alpha old-order control did not move the actual material block")
endif()
foreach(_pa_variant IN ITEMS current old)
    # Syntax-only adapters. No alpha, sampling, fade or view policy is copied.
    set(_pa_body "${_pa_${_pa_variant}}")
    string(REPLACE "void main()" "void run()" _pa_body "${_pa_body}")
    foreach(_pa_swizzle IN ITEMS "u_uvTransform.xy" "u_uvTransform.zw"
            "gl_FragCoord.xy" "u_viewRect.zw" "texColor.rgb"
            "u_baseColorFactor.rgb" "v_tint.rgb")
        string(REPLACE "${_pa_swizzle}" "${_pa_swizzle}()" _pa_body "${_pa_body}")
    endforeach()
    string(REGEX REPLACE "([0-9]+\\.[0-9]+)" "\\1f" _pa_body "${_pa_body}")
    string(APPEND _pa_body "    jce_test_material_result(albedo, alpha);\n}\n")
    set(_pa_${_pa_variant}_path "${CMAKE_CURRENT_BINARY_DIR}/pbr-alpha-order/${_pa_variant}.inc.h")
    jce_test_write_if_changed("${_pa_${_pa_variant}_path}" "${_pa_body}")
endforeach()
foreach(_pa_variant IN ITEMS current old_order)
    set(_pa_target test_jce_pbr_alpha_order)
    set(_pa_selected "${_pa_current_path}")
    set(_pa_kind unit)
    if(_pa_variant STREQUAL "old_order")
        string(APPEND _pa_target "_old_order")
        set(_pa_selected "${_pa_old_path}")
        set(_pa_kind contract)
    endif()
    jce_add_cxx_test(${_pa_target} KIND ${_pa_kind}
        SOURCES test_jce_pbr_alpha_order.cpp)
    target_compile_features(${_pa_target} PRIVATE cxx_std_20)
    target_compile_definitions(${_pa_target} PRIVATE
        JCE_TEST_PBR_ALPHA_CURRENT="${_pa_selected}"
        JCE_TEST_PBR_ALPHA_REFERENCE="${_pa_old_path}")
    if(_pa_kind STREQUAL "contract")
        set_tests_properties(${_pa_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_pa_variable IN ITEMS owner source main material shadow normal anchor
        main_first main_last material_first material_last shadow_first shadow_last
        normal_first normal_last length prefix material_body shadow_body actual
        port current old variant body swizzle current_path old_path target selected kind)
    unset(_pa_${_pa_variable})
endforeach()
unset(_pa_variable)
