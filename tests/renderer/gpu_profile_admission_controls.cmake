# Complete GPU scene lifecycle and velocity acquisition owner controls.
set(_gp_gpu "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_gpu_scene.c")
set(_gp_velocity "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene/jce_sr_cull.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_gp_gpu}" "${_gp_velocity}")
file(READ "${_gp_gpu}" _gp_gpu_source)
file(READ "${_gp_velocity}" _gp_velocity_source)
function(_jce_gpu_profile_between OUTPUT SOURCE BEGIN END)
    string(FIND "${SOURCE}" "${BEGIN}" _first)
    string(FIND "${SOURCE}" "${BEGIN}" _last REVERSE)
    string(FIND "${SOURCE}" "${END}" _stop)
    string(FIND "${SOURCE}" "${END}" _last_stop REVERSE)
    if(_first LESS 0 OR NOT _first EQUAL _last OR _stop LESS_EQUAL _first OR NOT _stop EQUAL _last_stop)
        message(FATAL_ERROR "Profile fixture requires complete unique ordered owner ${OUTPUT}")
    endif()
    math(EXPR _length "${_stop} - ${_first}")
    string(SUBSTRING "${SOURCE}" ${_first} ${_length} _body)
    set(${OUTPUT} "${_body}" PARENT_SCOPE)
endfunction()
_jce_gpu_profile_between(_gp_layout "${_gp_gpu_source}" "struct JceGpuScene {"
    "static bgfx_shader_handle_t load_shader(")
_jce_gpu_profile_between(_gp_visible "${_gp_gpu_source}" "static void destroy_visible_buffer("
    "/* Choose a geometric capacity")
_jce_gpu_profile_between(_gp_owners "${_gp_gpu_source}" "JceGpuScene *jce_gpu_scene_create("
    "uint16_t jce_gpu_scene_visible_vb(")
_jce_gpu_profile_between(_gp_acquire "${_gp_velocity_source}"
    "static void sr_ensure_velocity_gbuffer_programs(" "void sr_draw_depth_prepass(")
set(_gp_gpu_gate "if (compatibility || !supports_compute) {")
set(_gp_velocity_gate "if (!jce_graphics_api_is_compatibility_gl_es(api.build_tier, api.backend)) {")
foreach(_gp_pair IN ITEMS gpu velocity)
    if(_gp_pair STREQUAL "gpu")
        set(_gp_body "${_gp_owners}")
    else()
        set(_gp_body "${_gp_acquire}")
    endif()
    string(FIND "${_gp_body}" "${_gp_${_gp_pair}_gate}" _gp_first)
    string(FIND "${_gp_body}" "${_gp_${_gp_pair}_gate}" _gp_last REVERSE)
    if(_gp_first LESS 0 OR NOT _gp_first EQUAL _gp_last)
        message(FATAL_ERROR "Profile fixture needs one actual ${_gp_pair} admission wire")
    endif()
endforeach()
set(_gp_wire "sr_ensure_velocity_gbuffer_programs(sr, want_vel);")
string(FIND "${_gp_velocity_source}" "${_gp_wire}" _gp_first)
string(FIND "${_gp_velocity_source}" "${_gp_wire}" _gp_last REVERSE)
if(_gp_first LESS 0 OR NOT _gp_first EQUAL _gp_last)
    message(FATAL_ERROR "Profile fixture needs the unique real prepass acquisition call")
endif()
set(_gp_output "${CMAKE_CURRENT_BINARY_DIR}/gpu-profile-admission-controls")
file(MAKE_DIRECTORY "${_gp_output}")
foreach(_gp_variant IN ITEMS current missing_gpu_profile missing_velocity_profile)
    set(_gp_create "${_gp_owners}")
    set(_gp_velocity_body "${_gp_acquire}")
    set(_gp_target test_jce_gpu_profile_admission)
    set(_gp_kind unit)
    if(_gp_variant STREQUAL "missing_gpu_profile")
        string(REPLACE "${_gp_gpu_gate}"
            "if (!supports_compute) {"
            _gp_create "${_gp_create}")
    elseif(_gp_variant STREQUAL "missing_velocity_profile")
        string(REPLACE "${_gp_velocity_gate}"
            "if (!jce_graphics_api_is_compatibility_gl_es(api.build_tier, api.backend) || true) {"
            _gp_velocity_body "${_gp_velocity_body}")
    endif()
    if(NOT _gp_variant STREQUAL "current")
        if(_gp_create STREQUAL _gp_owners AND _gp_velocity_body STREQUAL _gp_acquire)
            message(FATAL_ERROR "Complete-owner profile mutation did not change ${_gp_variant}")
        endif()
        string(APPEND _gp_target "_${_gp_variant}")
        set(_gp_kind contract)
    endif()
    set(_gp_gpu_path "${_gp_output}/${_gp_variant}-gpu.inc.h")
    set(_gp_velocity_path "${_gp_output}/${_gp_variant}-velocity.inc.h")
    jce_test_write_if_changed("${_gp_gpu_path}" "${_gp_layout}\n${_gp_visible}\n${_gp_create}")
    jce_test_write_if_changed("${_gp_velocity_path}" "${_gp_velocity_body}")
    jce_add_unit_test(${_gp_target} KIND ${_gp_kind}
        SOURCES test_jce_gpu_profile_admission.c LINK jce_core)
    target_include_directories(${_gp_target} PRIVATE "${CMAKE_SOURCE_DIR}/engine/src"
        "$<TARGET_PROPERTY:bgfx::bgfx,INTERFACE_INCLUDE_DIRECTORIES>")
    target_compile_definitions(${_gp_target} PRIVATE JCE_DIST=1
        JCE_TEST_GPU_PROFILE_OWNER="${_gp_gpu_path}"
        JCE_TEST_VELOCITY_PROFILE_OWNER="${_gp_velocity_path}")
    if(MSVC)
        target_compile_options(${_gp_target} PRIVATE /Zc:preprocessor)
    endif()
    if(_gp_kind STREQUAL "contract")
        set_tests_properties(${_gp_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_gp_variable IN ITEMS gpu velocity gpu_source velocity_source layout visible owners acquire
        gpu_gate velocity_gate pair body first last wire output variant create velocity_body target
        kind gpu_path velocity_path)
    unset(_gp_${_gp_variable})
endforeach()
unset(_gp_variable)
