# Exact shipping cookie owner with typed allocation/create/bind/destroy ports.
set(_cookie_owner "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_light_cookie_internal.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_cookie_owner}")
file(READ "${_cookie_owner}" _cookie_source)
set(_cookie_output "${CMAKE_CURRENT_BINARY_DIR}/cookie-owner-controls")
file(MAKE_DIRECTORY "${_cookie_output}")
foreach(_cookie_variant IN ITEMS current wrong_placeholder missing_compatibility)
    set(_cookie_body "${_cookie_source}")
    set(_cookie_kind unit)
    set(_cookie_target test_jce_light_cookie_texture)
    if(_cookie_variant STREQUAL "wrong_placeholder")
        string(REPLACE "bgfx_create_texture_2d(1, 1, false, 2,"
            "bgfx_create_texture_2d(1, 1, false, 1," _cookie_body "${_cookie_body}")
    elseif(_cookie_variant STREQUAL "missing_compatibility")
        string(REPLACE "if (compatibility) {" "if (compatibility && false) {"
            _cookie_body "${_cookie_body}")
    endif()
    if(NOT _cookie_variant STREQUAL "current")
        if(_cookie_body STREQUAL _cookie_source)
            message(FATAL_ERROR "Cookie complete-owner mutation did not change ${_cookie_variant}")
        endif()
        set(_cookie_kind contract)
        string(APPEND _cookie_target "_${_cookie_variant}")
    endif()
    set(_cookie_selected "${_cookie_output}/${_cookie_variant}.h")
    jce_test_write_if_changed("${_cookie_selected}" "${_cookie_body}")
    jce_add_unit_test(${_cookie_target} KIND ${_cookie_kind}
        SOURCES test_jce_light_cookie_texture.c LINK jce_core)
    target_include_directories(${_cookie_target} PRIVATE
        "${CMAKE_SOURCE_DIR}/engine/src"
        "$<TARGET_PROPERTY:bgfx::bgfx,INTERFACE_INCLUDE_DIRECTORIES>")
    target_compile_definitions(${_cookie_target} PRIVATE
        JCE_TEST_LIGHT_COOKIE_OWNER="${_cookie_selected}")
    if(MSVC)
        target_compile_options(${_cookie_target} PRIVATE /Zc:preprocessor)
    endif()
    if(_cookie_kind STREQUAL "contract")
        set_tests_properties(${_cookie_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_cookie_variable IN ITEMS owner source output variant body kind target selected)
    unset(_cookie_${_cookie_variable})
endforeach()
unset(_cookie_variable)
