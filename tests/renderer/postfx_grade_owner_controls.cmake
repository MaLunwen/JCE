# Actual composite grade owner, with typed memory/uniform/texture/log ports.
set(_grade_owner "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_postfx_grade_internal.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_grade_owner}")
file(READ "${_grade_owner}" _grade_source)
set(_grade_output "${CMAKE_CURRENT_BINARY_DIR}/postfx-grade-controls")
file(MAKE_DIRECTORY "${_grade_output}")
foreach(_grade_variant IN ITEMS current missing_compatibility borrowed_destroy)
    set(_grade_body "${_grade_source}")
    set(_grade_kind unit)
    set(_grade_target test_jce_postfx_grade_owner)
    if(_grade_variant STREQUAL "missing_compatibility")
        string(REPLACE "if (compatibility || !texture3d) {"
            "if ((compatibility && false) || !texture3d) {" _grade_body "${_grade_body}")
    elseif(_grade_variant STREQUAL "borrowed_destroy")
        string(REPLACE "const bgfx_texture_handle_t texture = owner->placeholder;"
            "const bgfx_texture_handle_t texture = owner->borrowed;" _grade_body "${_grade_body}")
    endif()
    if(NOT _grade_variant STREQUAL "current")
        if(_grade_body STREQUAL _grade_source)
            message(FATAL_ERROR "Grade complete-owner mutation did not change ${_grade_variant}")
        endif()
        set(_grade_kind contract)
        string(APPEND _grade_target "_${_grade_variant}")
    endif()
    set(_grade_selected "${_grade_output}/${_grade_variant}.h")
    jce_test_write_if_changed("${_grade_selected}" "${_grade_body}")
    jce_add_unit_test(${_grade_target} KIND ${_grade_kind}
        SOURCES test_jce_postfx_grade_owner.c LINK jce_core)
    target_include_directories(${_grade_target} PRIVATE
        "${CMAKE_SOURCE_DIR}/engine/src"
        "$<TARGET_PROPERTY:bgfx::bgfx,INTERFACE_INCLUDE_DIRECTORIES>")
    target_compile_definitions(${_grade_target} PRIVATE
        JCE_TEST_POSTFX_GRADE_OWNER="${_grade_selected}")
    if(MSVC)
        target_compile_options(${_grade_target} PRIVATE /Zc:preprocessor)
    endif()
    if(_grade_kind STREQUAL "contract")
        set_tests_properties(${_grade_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_grade_variable IN ITEMS owner source output variant body kind target selected)
    unset(_grade_${_grade_variable})
endforeach()
unset(_grade_variable)
