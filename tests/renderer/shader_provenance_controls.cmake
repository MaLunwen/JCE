# Complete actual shader loader/link owner plus real Core/Noop integration.
set(_shader_prov_owner "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_shaders.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_shader_prov_owner}")
file(READ "${_shader_prov_owner}" _shader_prov_source)
set(_shader_prov_dir "${CMAKE_CURRENT_BINARY_DIR}/shader-provenance")
file(MAKE_DIRECTORY "${_shader_prov_dir}")
function(_jce_shader_provenance_replace needle replacement expected)
    string(REPLACE "${needle}" "" _without "${_shader_prov_selected}")
    string(LENGTH "${_shader_prov_selected}" _before)
    string(LENGTH "${_without}" _after)
    string(LENGTH "${needle}" _width)
    math(EXPR _removed "${_before} - ${_after}")
    math(EXPR _required "${_width} * ${expected}")
    if(NOT _removed EQUAL _required)
        message(FATAL_ERROR "Shader provenance control requires exact actual owner wire count")
    endif()
    string(REPLACE "${needle}" "${replacement}" _selected "${_shader_prov_selected}")
    set(_shader_prov_selected "${_selected}" PARENT_SCOPE)
endfunction()
set(_shader_prov_variants current)
if(EMSCRIPTEN)
    jce_test_suite_skipped("shader-provenance-native-controls" "requires native Noop session/environment")
else()
    list(APPEND _shader_prov_variants missing_sha_word wrong_extent wrong_receipt
        missing_partial_record missing_gate old_capture_receipt)
endif()
foreach(_shader_prov_variant IN LISTS _shader_prov_variants)
    set(_shader_prov_selected "${_shader_prov_source}")
    set(_shader_prov_path "${_shader_prov_owner}")
    set(_shader_prov_target test_jce_shader_link_owned)
    set(_shader_prov_kind integration)
    if(NOT _shader_prov_variant STREQUAL "current")
        set(_shader_prov_target "test_jce_shader_provenance_${_shader_prov_variant}")
        set(_shader_prov_kind contract)
        if(_shader_prov_variant STREQUAL "missing_sha_word")
            _jce_shader_provenance_replace("\"shader.create.sha256.7\""
                "\"shader.create.missing.7\"" 1)
        elseif(_shader_prov_variant STREQUAL "wrong_extent")
            _jce_shader_provenance_replace("jce_sha256_internal(mem->data, size, digest)"
                "jce_sha256_internal(mem->data, size - 1u, digest)" 1)
        elseif(_shader_prov_variant STREQUAL "wrong_receipt")
            _jce_shader_provenance_replace("link_program_evidenced(vsh, fsh, &vs_evidence, &fs_evidence)"
                "link_program_evidenced(vsh, fsh, &vs_evidence, &vs_evidence)" 3)
        elseif(_shader_prov_variant STREQUAL "missing_partial_record")
            _jce_shader_provenance_replace("release_shader_evidenced(vsh, &vs_evidence);"
                "(void)release_shader_evidenced; bgfx_destroy_shader(vsh); /* Observation omitted. */" 3)
        elseif(_shader_prov_variant STREQUAL "missing_gate")
            _jce_shader_provenance_replace([=[    if (!jce_renderer_shader_provenance_policy_internal())
        return (JceTraceScope){0};]=]
                "    /* Ordinary missing default-off policy guard. */" 1)
        else()
            _jce_shader_provenance_replace(
                "    if (evidence->capture_generation != jce_trace_capture_generation()) return 2;"
                "    /* Ordinary stale-capture receipt accepted. */" 1)
        endif()
        set(_shader_prov_path "${_shader_prov_dir}/${_shader_prov_variant}.c")
        jce_test_write_if_changed("${_shader_prov_path}" "${_shader_prov_selected}")
    endif()
    set(_shader_prov_work "${_shader_prov_dir}/${_shader_prov_variant}-work")
    file(MAKE_DIRECTORY "${_shader_prov_work}/shaders")
    jce_add_unit_test(${_shader_prov_target} KIND ${_shader_prov_kind}
        SOURCES test_jce_shader_link_owned.c LINK jce_core jce_renderer jce_resource
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src" "${CMAKE_SOURCE_DIR}/engine/src/renderer")
    target_link_libraries(${_shader_prov_target} PRIVATE bgfx::bgfx sdl::sdl)
    target_compile_definitions(${_shader_prov_target} PRIVATE JCE_BUILDING_ENGINE=1
        JCE_TEST_SHADER_LINK_OWNER="${_shader_prov_path}"
        JCE_TEST_SHADER_OVERLAY_DIR="${_shader_prov_work}")
    if(MSVC)
        target_compile_options(${_shader_prov_target} PRIVATE /Zc:preprocessor)
    endif()
    set_tests_properties(${_shader_prov_target} PROPERTIES TIMEOUT 90)
    if(_shader_prov_kind STREQUAL "contract")
        set_tests_properties(${_shader_prov_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_shader_prov_key IN ITEMS owner source dir variants variant selected path target kind work)
    unset(_shader_prov_${_shader_prov_key})
endforeach()
unset(_shader_prov_key)
