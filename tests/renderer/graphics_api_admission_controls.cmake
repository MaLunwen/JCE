# Complete C99 API policy owner; backend ports do not create a graphics context.
set(_api_caps_source "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_renderer_caps.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_api_caps_source}")
file(READ "${_api_caps_source}" _api_caps_current)
foreach(_api_caps_variant IN ITEMS stable modern current compatibility old_range missing_floor old_vfetch)
    set(_api_caps_owner "${_api_caps_source}")
    set(_api_caps_tier 3)
    set(_api_caps_kind unit)
    if(_api_caps_variant STREQUAL "stable")
        set(_api_caps_tier 0)
    elseif(_api_caps_variant STREQUAL "modern")
        set(_api_caps_tier 1)
    elseif(_api_caps_variant STREQUAL "current")
        set(_api_caps_tier 2)
    elseif(NOT _api_caps_variant STREQUAL "compatibility")
        set(_api_caps_kind contract)
        if(_api_caps_variant STREQUAL "old_range")
            set(_api_caps_needle "if (tier == JCE_GRAPHICS_API_TIER_COMPATIBILITY)\n        row = JCE_GFX_PROVIDER_COMPATIBILITY_ORDINAL;")
            set(_api_caps_replacement "if (false && tier == JCE_GRAPHICS_API_TIER_COMPATIBILITY)\n        row = JCE_GFX_PROVIDER_COMPATIBILITY_ORDINAL;")
            set(_api_caps_count 1)
        elseif(_api_caps_variant STREQUAL "missing_floor")
            set(_api_caps_needle "return s_api_version_at_least(s_api_info.runtime_version,\n                                  s_api_info.minimum_version);")
            set(_api_caps_replacement "return s_api_version_at_least(s_api_info.runtime_version,\n                                  s_api_info.minimum_version) || true;")
            set(_api_caps_count 2)
        else()
            set(_api_caps_needle "return JCE_GFX_BUILD_TIER != JCE_GRAPHICS_API_TIER_COMPATIBILITY;")
            set(_api_caps_replacement "return true;")
            set(_api_caps_count 1)
        endif()
        string(REPLACE "${_api_caps_needle}" "" _api_caps_without "${_api_caps_current}")
        string(LENGTH "${_api_caps_current}" _api_caps_length)
        string(LENGTH "${_api_caps_without}" _api_caps_without_length)
        string(LENGTH "${_api_caps_needle}" _api_caps_needle_length)
        math(EXPR _api_caps_matches "(${_api_caps_length} - ${_api_caps_without_length}) / ${_api_caps_needle_length}")
        if(NOT _api_caps_matches EQUAL _api_caps_count)
            message(FATAL_ERROR "API tier ${_api_caps_variant} requires ${_api_caps_count} exact current-owner sites")
        endif()
        string(REPLACE "${_api_caps_needle}" "${_api_caps_replacement}" _api_caps_mutant "${_api_caps_current}")
        set(_api_caps_owner "${CMAKE_CURRENT_BINARY_DIR}/api_tier_${_api_caps_variant}.c")
        set(_api_caps_previous "")
        if(EXISTS "${_api_caps_owner}")
            file(READ "${_api_caps_owner}" _api_caps_previous)
        endif()
        if(NOT _api_caps_previous STREQUAL _api_caps_mutant)
            file(WRITE "${_api_caps_owner}" "${_api_caps_mutant}")
        endif()
    endif()
    set(_api_caps_target "test_jce_graphics_api_${_api_caps_variant}")
    jce_add_unit_test(${_api_caps_target} KIND ${_api_caps_kind}
        SOURCES test_jce_graphics_api_admission.c LINK jce_core
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src" "${CMAKE_SOURCE_DIR}/engine/src/renderer")
    target_include_directories(${_api_caps_target} PRIVATE
        "$<TARGET_PROPERTY:bgfx::bgfx,INTERFACE_INCLUDE_DIRECTORIES>"
        "$<TARGET_PROPERTY:sdl::sdl,INTERFACE_INCLUDE_DIRECTORIES>")
    target_compile_definitions(${_api_caps_target} PRIVATE JCE_BUILDING_ENGINE=1
        "JCE_TEST_API_TIER=${_api_caps_tier}"
        "JCE_TEST_API_CAPS_OWNER=\"${_api_caps_owner}\"")
    if(MSVC)
        target_compile_options(${_api_caps_target} PRIVATE /Zc:preprocessor)
    endif()
    if(_api_caps_kind STREQUAL "contract")
        set_tests_properties(${_api_caps_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
