set(_reset_trace_owner "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_renderer.c")
set(_reset_trace_helper "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_renderer_reset_trace_internal.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_reset_trace_owner}" "${_reset_trace_helper}")
file(READ "${_reset_trace_owner}" _reset_trace_source)
file(READ "${_reset_trace_helper}" _reset_trace_current)
set(_reset_trace_entries "")
foreach(_reset_trace_part IN ITEMS resize preferences)
    if(_reset_trace_part STREQUAL "resize")
        set(_reset_trace_begin "void jce_renderer_resize(")
        set(_reset_trace_end "/* -- Debug text")
    else()
        set(_reset_trace_begin "bool jce_renderer_get_vsync(")
        set(_reset_trace_end "void jce_renderer_set_backbuffer_capture(")
    endif()
    string(FIND "${_reset_trace_source}" "${_reset_trace_begin}" _reset_trace_first)
    string(FIND "${_reset_trace_source}" "${_reset_trace_begin}" _reset_trace_first_last REVERSE)
    string(FIND "${_reset_trace_source}" "${_reset_trace_end}" _reset_trace_last)
    string(FIND "${_reset_trace_source}" "${_reset_trace_end}" _reset_trace_last_last REVERSE)
    if(_reset_trace_first LESS 0 OR NOT _reset_trace_first EQUAL _reset_trace_first_last OR
       _reset_trace_last LESS_EQUAL _reset_trace_first OR NOT _reset_trace_last EQUAL _reset_trace_last_last)
        message(FATAL_ERROR "Reset trace fixture requires complete unique actual ${_reset_trace_part} entries")
    endif()
    math(EXPR _reset_trace_length "${_reset_trace_last} - ${_reset_trace_first}")
    string(SUBSTRING "${_reset_trace_source}" ${_reset_trace_first} ${_reset_trace_length} _reset_trace_body)
    string(APPEND _reset_trace_entries "${_reset_trace_body}\n")
endforeach()
string(REGEX MATCHALL "if [(]scope.id[)] [{]" _reset_trace_wires "${_reset_trace_current}")
list(LENGTH _reset_trace_wires _reset_trace_count)
if(NOT _reset_trace_count EQUAL 2)
    message(FATAL_ERROR "Reset trace control requires actual before/after detail admissions")
endif()
string(REPLACE "if (scope.id) {" "if (false) {" _reset_trace_old "${_reset_trace_current}")
set(_reset_trace_dir "${CMAKE_CURRENT_BINARY_DIR}/reset-trace-mutation")
file(MAKE_DIRECTORY "${_reset_trace_dir}")
set(_reset_trace_entries_path "${_reset_trace_dir}/jce_renderer_reset_entries.inc.h")
set(_reset_trace_old_path "${_reset_trace_dir}/jce_renderer_reset_old_missing_details.h")
set(_reset_trace_later_wire "    enabled = renderer_presentation_vsync_resolve(&r->launch_vsync, enabled);\n")
string(FIND "${_reset_trace_entries}" "${_reset_trace_later_wire}" _reset_trace_first)
string(FIND "${_reset_trace_entries}" "${_reset_trace_later_wire}" _reset_trace_last REVERSE)
if(_reset_trace_first LESS 0 OR NOT _reset_trace_first EQUAL _reset_trace_last)
    message(FATAL_ERROR "Presentation control requires the one actual setter constraint")
endif()
string(REPLACE "${_reset_trace_later_wire}" "" _reset_trace_old_hidden_mask "${_reset_trace_entries}")
set(_reset_trace_old_hidden_mask_path "${_reset_trace_dir}/jce_renderer_reset_old_hidden_mask.inc.h")
jce_test_write_if_changed("${_reset_trace_old_hidden_mask_path}" "${_reset_trace_old_hidden_mask}")
foreach(_reset_trace_part IN ITEMS entries old)
    set(_reset_trace_output "${_reset_trace_${_reset_trace_part}_path}")
    set(_reset_trace_content "${_reset_trace_${_reset_trace_part}}")
    unset(_reset_trace_previous)
    if(EXISTS "${_reset_trace_output}")
        file(READ "${_reset_trace_output}" _reset_trace_previous)
    endif()
    if(NOT _reset_trace_previous STREQUAL _reset_trace_content)
        file(WRITE "${_reset_trace_output}" "${_reset_trace_content}")
    endif()
endforeach()
set(_reset_launch_owner "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_renderer_launch_policy.inc.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_reset_launch_owner}")
file(READ "${_reset_launch_owner}" _reset_launch_source)
set(_reset_launch_wire "    return r->launch_vsync.value;")
string(FIND "${_reset_launch_source}" "${_reset_launch_wire}" _reset_launch_first)
string(FIND "${_reset_launch_source}" "${_reset_launch_wire}" _reset_launch_last REVERSE)
if(_reset_launch_first LESS 0 OR NOT _reset_launch_first EQUAL _reset_launch_last)
    message(FATAL_ERROR "Renderer launch control requires one actual forced Vsync resolution")
endif()
string(REPLACE "${_reset_launch_wire}" "    return requested; /* old: later project request wins */" _reset_launch_old "${_reset_launch_source}")
set(_reset_launch_old_path "${_reset_trace_dir}/jce_renderer_launch_old_override.inc.h")
jce_test_write_if_changed("${_reset_launch_old_path}" "${_reset_launch_old}")
foreach(_reset_trace_variant IN ITEMS current old_missing_details old_launch_override old_hidden_mask)
    if(_reset_trace_variant STREQUAL "old_hidden_mask" AND NOT JCE_PLATFORM_WINDOWS)
        continue()
    endif()
    set(_reset_trace_target test_jce_renderer_reset_trace)
    set(_reset_trace_kind unit)
    set(_reset_trace_selected "${_reset_trace_helper}")
    set(_reset_launch_selected "${_reset_launch_owner}")
    set(_reset_trace_entries_selected "${_reset_trace_entries_path}")
    if(_reset_trace_variant STREQUAL "old_missing_details")
        string(APPEND _reset_trace_target "_old_missing_details")
        set(_reset_trace_kind contract)
        set(_reset_trace_selected "${_reset_trace_old_path}")
    elseif(_reset_trace_variant STREQUAL "old_launch_override")
        string(APPEND _reset_trace_target "_old_launch_override")
        set(_reset_trace_kind contract)
        set(_reset_launch_selected "${_reset_launch_old_path}")
    elseif(_reset_trace_variant STREQUAL "old_hidden_mask")
        string(APPEND _reset_trace_target "_old_hidden_mask")
        set(_reset_trace_kind contract)
        set(_reset_trace_entries_selected "${_reset_trace_old_hidden_mask_path}")
    endif()
    jce_add_unit_test(${_reset_trace_target} KIND ${_reset_trace_kind}
        SOURCES test_jce_renderer_reset_trace.c LINK jce_core bgfx::bgfx
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src")
    if(MSVC)
        target_compile_options(${_reset_trace_target} PRIVATE /Zc:preprocessor)
    endif()
    target_compile_definitions(${_reset_trace_target} PRIVATE
        JCE_TEST_RESET_TRACE_HELPER="${_reset_trace_selected}"
        JCE_TEST_RENDERER_LAUNCH_POLICY="${_reset_launch_selected}"
        JCE_TEST_RESET_TRACE_ENTRIES="${_reset_trace_entries_selected}")
    if(NOT _reset_trace_variant STREQUAL "current")
        set_tests_properties(${_reset_trace_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_reset_trace_variable IN ITEMS owner helper source current entries part begin end first first_last
    last last_last length body wires count old dir entries_path old_path output content previous
    variant target kind selected later_wire old_hidden_mask old_hidden_mask_path entries_selected)
    unset(_reset_trace_${_reset_trace_variable})
endforeach()
unset(_reset_trace_variable)
foreach(_reset_launch_cleanup IN ITEMS owner source wire first last old old_path selected)
    unset(_reset_launch_${_reset_launch_cleanup})
endforeach()
unset(_reset_launch_cleanup)
