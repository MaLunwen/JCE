# Complete actual wrapper and snapshot admission with typed CPU providers.
set(_perf_snapshot_renderer "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_renderer.c")
set(_perf_snapshot_trace "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_renderer_trace.c")
foreach(_perf_snapshot_owner IN ITEMS renderer trace)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_perf_snapshot_${_perf_snapshot_owner}}")
    file(READ "${_perf_snapshot_${_perf_snapshot_owner}}" _perf_snapshot_${_perf_snapshot_owner}_source)
endforeach()
set(_perf_snapshot_begin "void jce_renderer_trace_snapshot(const JceRenderer *r)")
set(_perf_snapshot_end "bool jce_renderer_end_frame_impl(const JceRenderer *r)")
string(FIND "${_perf_snapshot_renderer_source}" "${_perf_snapshot_begin}" _perf_snapshot_first)
string(FIND "${_perf_snapshot_renderer_source}" "${_perf_snapshot_begin}" _perf_snapshot_last REVERSE)
string(FIND "${_perf_snapshot_renderer_source}" "${_perf_snapshot_end}" _perf_snapshot_stop)
string(FIND "${_perf_snapshot_renderer_source}" "${_perf_snapshot_end}" _perf_snapshot_stop_last REVERSE)
if(_perf_snapshot_first LESS 0 OR NOT _perf_snapshot_first EQUAL _perf_snapshot_last OR
   _perf_snapshot_stop LESS_EQUAL _perf_snapshot_first OR NOT _perf_snapshot_stop EQUAL _perf_snapshot_stop_last)
    message(FATAL_ERROR "PERF snapshot controls require unique complete actual snapshot boundaries")
endif()
math(EXPR _perf_snapshot_length "${_perf_snapshot_stop} - ${_perf_snapshot_first}")
string(SUBSTRING "${_perf_snapshot_renderer_source}" ${_perf_snapshot_first} ${_perf_snapshot_length} _perf_snapshot_body)
set(_perf_snapshot_wrapper_begin "void jce_renderer_end_frame(const JceRenderer *r)")
string(FIND "${_perf_snapshot_trace_source}" "${_perf_snapshot_wrapper_begin}" _perf_snapshot_first)
string(FIND "${_perf_snapshot_trace_source}" "${_perf_snapshot_wrapper_begin}" _perf_snapshot_last REVERSE)
if(_perf_snapshot_first LESS 0 OR NOT _perf_snapshot_first EQUAL _perf_snapshot_last)
    message(FATAL_ERROR "PERF snapshot controls require the actual complete final end_frame wrapper")
endif()
string(SUBSTRING "${_perf_snapshot_trace_source}" ${_perf_snapshot_first} -1 _perf_snapshot_wrapper)
set(_perf_snapshot_wire "    if (accepted) jce_renderer_trace_snapshot(r);")
string(FIND "${_perf_snapshot_wrapper}" "${_perf_snapshot_wire}" _perf_snapshot_first)
string(FIND "${_perf_snapshot_wrapper}" "${_perf_snapshot_wire}" _perf_snapshot_last REVERSE)
if(_perf_snapshot_first LESS 0 OR NOT _perf_snapshot_first EQUAL _perf_snapshot_last)
    message(FATAL_ERROR "PERF snapshot old-gate control requires one actual accepted dispatch")
endif()
string(REPLACE "${_perf_snapshot_wire}"
    "    if (accepted && scope.id) jce_renderer_trace_snapshot(r);"
    _perf_snapshot_old "${_perf_snapshot_wrapper}")
set(_perf_snapshot_dir "${CMAKE_CURRENT_BINARY_DIR}/perf-snapshot")
file(MAKE_DIRECTORY "${_perf_snapshot_dir}")
jce_test_write_if_changed("${_perf_snapshot_dir}/snapshot.inc.h" "${_perf_snapshot_body}")
foreach(_perf_snapshot_variant IN ITEMS current old_scope_gate)
    set(_perf_snapshot_target test_jce_renderer_perf_snapshot)
    set(_perf_snapshot_kind unit)
    set(_perf_snapshot_selected "${_perf_snapshot_wrapper}")
    if(_perf_snapshot_variant STREQUAL "old_scope_gate")
        string(APPEND _perf_snapshot_target "_old_scope_gate")
        set(_perf_snapshot_kind contract)
        set(_perf_snapshot_selected "${_perf_snapshot_old}")
    endif()
    jce_test_write_if_changed("${_perf_snapshot_dir}/${_perf_snapshot_variant}.inc.h" "${_perf_snapshot_selected}")
    jce_add_unit_test(${_perf_snapshot_target} KIND ${_perf_snapshot_kind}
        SOURCES test_jce_renderer_perf_snapshot.c LINK jce_core sdl::sdl bgfx::bgfx
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src")
    target_compile_definitions(${_perf_snapshot_target} PRIVATE
        JCE_TEST_PERF_SNAPSHOT_OWNER="${_perf_snapshot_dir}/snapshot.inc.h"
        JCE_TEST_PERF_END_FRAME_OWNER="${_perf_snapshot_dir}/${_perf_snapshot_variant}.inc.h")
    if(MSVC)
        target_compile_options(${_perf_snapshot_target} PRIVATE /Zc:preprocessor)
    endif()
    if(_perf_snapshot_kind STREQUAL "contract")
        set_tests_properties(${_perf_snapshot_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_perf_snapshot_var IN ITEMS renderer trace owner renderer_source trace_source begin end
    first last stop stop_last length body wrapper_begin wrapper wire old dir variant target kind selected)
    unset(_perf_snapshot_${_perf_snapshot_var})
endforeach()
unset(_perf_snapshot_var)
