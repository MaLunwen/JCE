# Complete actual builtin acquisition owners and invalid skinned submit.
set(_os_scene "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene")
set(_os_renderer "${CMAKE_SOURCE_DIR}/engine/src/renderer")
foreach(_os_part IN ITEMS pick gbuffer skinned)
    if(_os_part STREQUAL "pick")
        set(_os_path "${_os_scene}/jce_scene_pick.c")
    elseif(_os_part STREQUAL "gbuffer")
        set(_os_path "${_os_scene}/jce_sr_cull.c")
    else()
        set(_os_path "${_os_renderer}/jce_skinned_mesh.c")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_os_path}")
    file(READ "${_os_path}" _os_${_os_part}_source)
endforeach()
function(_jce_optional_between OUTPUT SOURCE BEGIN END)
    string(FIND "${SOURCE}" "${BEGIN}" _first)
    string(FIND "${SOURCE}" "${BEGIN}" _last REVERSE)
    string(FIND "${SOURCE}" "${END}" _stop)
    string(FIND "${SOURCE}" "${END}" _last_stop REVERSE)
    if(_first LESS 0 OR NOT _first EQUAL _last OR _stop LESS_EQUAL _first OR NOT _stop EQUAL _last_stop)
        message(FATAL_ERROR "Optional stock fixture needs complete unique ordered owner ${OUTPUT}")
    endif()
    math(EXPR _length "${_stop} - ${_first}")
    string(SUBSTRING "${SOURCE}" ${_first} ${_length} _body)
    set(${OUTPUT} "${_body}" PARENT_SCOPE)
endfunction()
_jce_optional_between(_os_pick "${_os_pick_source}" "static void pick_load_builtin_programs("
    "JceScenePickPass *jce_scene_pick_create(")
_jce_optional_between(_os_pick_model "${_os_pick_source}" "typedef struct PickModelId {"
    "bool jce_scene_pick_render(")
_jce_optional_between(_os_gbuffer "${_os_gbuffer_source}" "static void sr_ensure_normal_gbuffer_program("
    "static void sr_ensure_velocity_gbuffer_programs(")
_jce_optional_between(_os_skinned "${_os_skinned_source}" "void jce_skinned_mesh_submit_pick_id("
    "bool jce_skinned_mesh_is_skinned(")
foreach(_os_wire IN ITEMS "pick_load_builtin_programs(pass, desc)" "sr_ensure_normal_gbuffer_program(sr, want_normals)")
    if(_os_wire MATCHES "^pick")
        set(_os_wire_source "${_os_pick_source}")
    else()
        set(_os_wire_source "${_os_gbuffer_source}")
    endif()
    string(FIND "${_os_wire_source}" "${_os_wire}" _os_first)
    string(FIND "${_os_wire_source}" "${_os_wire}" _os_last REVERSE)
    if(_os_first LESS 0 OR NOT _os_first EQUAL _os_last)
        message(FATAL_ERROR "Optional stock fixture requires one actual production acquisition wire")
    endif()
endforeach()
set(_os_output "${CMAKE_CURRENT_BINARY_DIR}/optional-stock-controls")
file(MAKE_DIRECTORY "${_os_output}")
foreach(_os_variant IN ITEMS current missing_pick_profile missing_gbuffer_profile stale_pick_pose)
    set(_os_pick_body "${_os_pick}")
    set(_os_gbuffer_body "${_os_gbuffer}")
    set(_os_pick_model_body "${_os_pick_model}")
    set(_os_target test_jce_optional_stock_admission)
    set(_os_kind unit)
    if(_os_variant STREQUAL "missing_pick_profile")
        string(REPLACE "if (!compatibility)" "if (!compatibility || true)" _os_pick_body "${_os_pick_body}")
    elseif(_os_variant STREQUAL "missing_gbuffer_profile")
        string(REPLACE "if (!jce_graphics_api_is_compatibility_gl_es(api.build_tier, api.backend)) {"
            "if (!jce_graphics_api_is_compatibility_gl_es(api.build_tier, api.backend) || true) {"
            _os_gbuffer_body "${_os_gbuffer_body}")
    endif()
    if(_os_variant STREQUAL "stale_pick_pose")
        string(REPLACE "if (anim && anim->model != asset)" "if (anim)"
            _os_pick_model_body "${_os_pick_model_body}")
    endif()
    if(NOT _os_variant STREQUAL "current")
        if(_os_pick_body STREQUAL _os_pick AND _os_gbuffer_body STREQUAL _os_gbuffer
                AND _os_pick_model_body STREQUAL _os_pick_model)
            message(FATAL_ERROR "Optional complete-owner mutation did not change ${_os_variant}")
        endif()
        set(_os_kind contract)
        string(APPEND _os_target "_${_os_variant}")
    endif()
    set(_os_pick_path "${_os_output}/${_os_variant}-pick.inc.h")
    set(_os_gbuffer_path "${_os_output}/${_os_variant}-gbuffer.inc.h")
    set(_os_pick_model_path "${_os_output}/${_os_variant}-pick-model.inc.h")
    set(_os_skinned_path "${_os_output}/skinned.inc.h")
    jce_test_write_if_changed("${_os_pick_path}" "${_os_pick_body}")
    jce_test_write_if_changed("${_os_gbuffer_path}" "${_os_gbuffer_body}")
    jce_test_write_if_changed("${_os_pick_model_path}" "${_os_pick_model_body}")
    jce_test_write_if_changed("${_os_skinned_path}" "${_os_skinned}")
    jce_add_unit_test(${_os_target} KIND ${_os_kind} SOURCES test_jce_optional_stock_admission.c LINK jce_core)
    target_include_directories(${_os_target} PRIVATE "${CMAKE_SOURCE_DIR}/engine/src"
        "$<TARGET_PROPERTY:bgfx::bgfx,INTERFACE_INCLUDE_DIRECTORIES>")
    target_compile_definitions(${_os_target} PRIVATE JCE_DIST=1
        JCE_TEST_OPTIONAL_PICK_OWNER="${_os_pick_path}"
        JCE_TEST_OPTIONAL_GBUFFER_OWNER="${_os_gbuffer_path}"
        JCE_TEST_OPTIONAL_PICK_MODEL_OWNER="${_os_pick_model_path}"
        JCE_TEST_OPTIONAL_SKINNED_SUBMIT_OWNER="${_os_skinned_path}")
    if(MSVC)
        target_compile_options(${_os_target} PRIVATE /Zc:preprocessor)
    endif()
    if(_os_kind STREQUAL "contract")
        set_tests_properties(${_os_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_os_variable IN ITEMS scene renderer part path pick_source gbuffer_source skinned_source pick gbuffer skinned
        wire wire_source first last output variant pick_body gbuffer_body target kind pick_path gbuffer_path skinned_path
        pick_model pick_model_body pick_model_path)
    unset(_os_${_os_variable})
endforeach()
unset(_os_variable)
