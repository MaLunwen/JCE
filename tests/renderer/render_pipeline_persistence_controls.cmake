# Actual RP serializer and complete native host owner; only one publication
# wire changes in the old-direct ordinary assertion control.
function(_jce_register_render_pipeline_persistence_controls)
    set(_owner "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_render_pipeline.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_owner}")
    file(READ "${_owner}" _source)
    set(_wire "bool ok = jce_fs_host_write_all_atomic(host_path, json_str, len);")
    string(FIND "${_source}" "${_wire}" _first)
    string(FIND "${_source}" "${_wire}" _last REVERSE)
    if(_first LESS 0 OR NOT _first EQUAL _last)
        message(FATAL_ERROR "RP persistence requires one actual atomic publication wire")
    endif()
    foreach(_variant IN ITEMS current old_direct)
        set(_target test_jce_render_pipeline_persistence)
        set(_kind integration)
        set(_input "${_owner}")
        if(_variant STREQUAL "old_direct")
            string(REPLACE "${_wire}"
                "bool ok = jce_fs_host_write_all(host_path, json_str, len);"
                _mutated "${_source}")
            if(_mutated STREQUAL _source)
                message(FATAL_ERROR "RP old-direct control did not change its owner")
            endif()
            set(_input "${CMAKE_CURRENT_BINARY_DIR}/rp-persistence/old_direct.c")
            jce_test_write_if_changed("${_input}" "${_mutated}")
            file(READ "${_input}" _written)
            if(NOT _written STREQUAL _mutated)
                message(FATAL_ERROR "RP old-direct compiler input differs from selected owner")
            endif()
            string(APPEND _target "_old_direct")
            set(_kind contract)
        endif()
        jce_add_unit_test(${_target} KIND ${_kind}
            SOURCES test_jce_render_pipeline_persistence.c "${_input}"
            LINK JCE sdl::sdl INCLUDES "${CMAKE_SOURCE_DIR}/engine/src")
        set(_work "${CMAKE_CURRENT_BINARY_DIR}/rp-persistence/${_variant}")
        file(MAKE_DIRECTORY "${_work}")
        set_tests_properties(${_target} PROPERTIES WORKING_DIRECTORY "${_work}")
        if(_kind STREQUAL "contract")
            set_tests_properties(${_target} PROPERTIES WILL_FAIL TRUE)
        endif()
    endforeach()
endfunction()
_jce_register_render_pipeline_persistence_controls()
