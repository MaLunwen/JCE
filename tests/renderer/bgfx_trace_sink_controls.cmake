# Complete callback/vtbl owner; only the explicit INFO sink wire is mutated.
set(_bts_owner "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_renderer_bgfx_callback.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_bts_owner}")
file(READ "${_bts_owner}" _bts_source)
set(_bts_wire "jce_log_write(JCE_LOG_LEVEL_INFO, \"bgfx\", __FILE__, __LINE__,")
string(REPLACE "${_bts_wire}" "" _bts_without "${_bts_source}")
string(LENGTH "${_bts_source}" _bts_length)
string(LENGTH "${_bts_without}" _bts_without_length)
string(LENGTH "${_bts_wire}" _bts_wire_length)
math(EXPR _bts_count "(${_bts_length} - ${_bts_without_length}) / ${_bts_wire_length}")
if(NOT _bts_count EQUAL 2)
    message(FATAL_ERROR "Trace sink control requires the two exact actual explicit INFO sink calls")
endif()
set(_bts_output "${CMAKE_CURRENT_BINARY_DIR}/bgfx-trace-sink-controls")
file(MAKE_DIRECTORY "${_bts_output}")
foreach(_bts_variant IN ITEMS current old_log_info)
    set(_bts_body "${_bts_source}")
    set(_bts_target test_jce_bgfx_trace_sink)
    set(_bts_kind unit)
    if(_bts_variant STREQUAL "old_log_info")
        string(REPLACE "${_bts_wire}" "LOG_INFO(\"bgfx\"," _bts_body "${_bts_body}")
        if(_bts_body STREQUAL _bts_source)
            message(FATAL_ERROR "Trace sink full-owner old macro control did not mutate")
        endif()
        string(APPEND _bts_target "_old_log_info")
        set(_bts_kind contract)
    endif()
    set(_bts_selected "${_bts_output}/${_bts_variant}.inc.c")
    jce_test_write_if_changed("${_bts_selected}" "${_bts_body}")
    jce_add_unit_test(${_bts_target} KIND ${_bts_kind} SOURCES test_jce_bgfx_trace_sink.c
        LINK jce_core SDL3_image::SDL3_image bgfx::bgfx
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src" "${CMAKE_SOURCE_DIR}/engine/src/renderer")
    target_compile_definitions(${_bts_target} PRIVATE JCE_DIST=1
        JCE_BGFX_TRACE_SINK_OWNER="${_bts_selected}")
    if(MSVC)
        target_compile_options(${_bts_target} PRIVATE /Zc:preprocessor)
    endif()
    if(_bts_kind STREQUAL "contract")
        set_tests_properties(${_bts_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_bts_variable IN ITEMS owner source wire without length without_length wire_length
        count output variant body target kind selected)
    unset(_bts_${_bts_variable})
endforeach()
unset(_bts_variable)
