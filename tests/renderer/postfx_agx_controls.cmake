# Complete actual composite tonemap functions, executed through typed CPU ports.
# This does not compile a GPU shader or certify native pixels.
function(_jce_postfx_agx_controls)
    set(owner "${CMAKE_SOURCE_DIR}/engine/shaders/postfx/fs_composite.sc")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${owner}")
    file(READ "${owner}" source)

    foreach(part IN ITEMS operators combine)
        if(part STREQUAL "operators")
            set(begin "vec3 acesFilm(vec3 x)")
            set(end "/* The scene sample, with per-pixel motion blur folded in.")
        else()
            set(begin "vec3 combineTonemap(vec2 uv)")
            set(end "void main()")
        endif()
        string(FIND "${source}" "${begin}" first)
        string(FIND "${source}" "${begin}" first_last REVERSE)
        string(FIND "${source}" "${end}" last)
        string(FIND "${source}" "${end}" last_last REVERSE)
        if(first LESS 0 OR NOT first EQUAL first_last OR
           NOT last EQUAL last_last OR NOT last GREATER first)
            message(FATAL_ERROR "AgX controls require unique complete ${part} boundaries")
        endif()
        math(EXPR length "${last} - ${first}")
        string(SUBSTRING "${source}" ${first} ${length} ${part})
    endforeach()
    set(current "${operators}\n${combine}")
    set(wire "    val = pow(max(val, vec3_splat(0.0)), vec3_splat(2.2));\n")
    string(FIND "${current}" "${wire}" first)
    string(FIND "${current}" "${wire}" last REVERSE)
    if(first LESS 0 OR NOT first EQUAL last)
        message(FATAL_ERROR "AgX old control requires one actual output transfer")
    endif()
    # Restores only the historical missing-transfer bug. All other tonemap,
    # exposure, bloom and final output-gamma statements remain actual source.
    string(REPLACE "${wire}" "" old "${current}")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/postfx-agx")
    foreach(variant IN ITEMS current old)
        set(adapted "${${variant}}")
        # Syntax only: typed vector swizzle and float literals, no copied curve.
        string(REPLACE ").rgb" ").rgb()" adapted "${adapted}")
        string(REGEX REPLACE "([0-9]+\\.[0-9]+)" "\\1f" adapted "${adapted}")
        set(${variant}_path "${CMAKE_CURRENT_BINARY_DIR}/postfx-agx/${variant}.inc.h")
        jce_test_write_if_changed("${${variant}_path}" "${adapted}")
    endforeach()
    foreach(variant IN ITEMS current old_missing_eotf)
        set(target test_jce_postfx_agx)
        set(kind unit)
        set(selected "${current_path}")
        if(variant STREQUAL "old_missing_eotf")
            string(APPEND target "_old_missing_eotf")
            set(kind contract)
            set(selected "${old_path}")
        endif()
        jce_add_cxx_test(${target} KIND ${kind}
            SOURCES test_jce_postfx_agx.cpp)
        target_compile_definitions(${target} PRIVATE
            JCE_TEST_POSTFX_TONEMAP_OWNER="${selected}"
            JCE_TEST_POSTFX_TONEMAP_OLD="${old_path}")
        if(kind STREQUAL "contract")
            set_tests_properties(${target} PROPERTIES WILL_FAIL TRUE)
        endif()
    endforeach()
endfunction()
_jce_postfx_agx_controls()
