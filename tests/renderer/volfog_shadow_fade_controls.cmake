set(_vf_owner "${CMAKE_SOURCE_DIR}/engine/shaders/volfog/fs_volfog.sc")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_vf_owner}")
file(READ "${_vf_owner}" _vf_source)
set(_vf_begin "float volfog_shadow_depth(")
set(_vf_end "/* Henyey-Greenstein phase function.")
foreach(_vf_anchor IN ITEMS begin end)
    string(FIND "${_vf_source}" "${_vf_${_vf_anchor}}" _vf_${_vf_anchor}_first)
    string(FIND "${_vf_source}" "${_vf_${_vf_anchor}}" _vf_${_vf_anchor}_last REVERSE)
    if(_vf_${_vf_anchor}_first LESS 0 OR NOT _vf_${_vf_anchor}_first EQUAL _vf_${_vf_anchor}_last)
        message(FATAL_ERROR "Fog CPU control needs one complete actual ${_vf_anchor} boundary")
    endif()
endforeach()
if(_vf_end_first LESS_EQUAL _vf_begin_first)
    message(FATAL_ERROR "Fog CPU control helper order changed")
endif()
math(EXPR _vf_length "${_vf_end_first} - ${_vf_begin_first}")
string(SUBSTRING "${_vf_source}" ${_vf_begin_first} ${_vf_length} _vf_helper)
set(_vf_guard "\tif (count >= 1.0 && count <= 4.0 && shadow_far > 0.0 &&\n\t    fade_start < shadow_far && view_z >= shadow_far)\n\t\treturn 1.0;\n")
set(_vf_consumer "float vis = volfog_sunlight(sample_ws, nearp + t * view_z_scale);")
foreach(_vf_wire IN ITEMS guard consumer)
    string(FIND "${_vf_source}" "${_vf_${_vf_wire}}" _vf_first)
    string(FIND "${_vf_source}" "${_vf_${_vf_wire}}" _vf_last REVERSE)
    if(_vf_first LESS 0 OR NOT _vf_first EQUAL _vf_last)
        message(FATAL_ERROR "Fog CPU control needs one actual ${_vf_wire} wire")
    endif()
endforeach()
string(REPLACE "${_vf_guard}" "" _vf_old "${_vf_helper}")
set(_vf_current "${_vf_helper}")
foreach(_vf_variant IN ITEMS current old)
    # Only shader-language syntax adapters, never a copied visibility formula.
    # C++ decimal constants need f suffixes to retain shader float arithmetic.
    string(REPLACE "clip.xyz" "clip.xyz()" _vf_body "${_vf_${_vf_variant}}")
    string(REPLACE "ndc.xy" "ndc.xy()" _vf_body "${_vf_body}")
    string(REGEX REPLACE "([0-9]+\\.[0-9]+)" "\\1f" _vf_body "${_vf_body}")
    set(_vf_${_vf_variant}_path "${CMAKE_CURRENT_BINARY_DIR}/volfog-shadow-fade/${_vf_variant}.inc.h")
    jce_test_write_if_changed("${_vf_${_vf_variant}_path}" "${_vf_body}")
endforeach()
foreach(_vf_variant IN ITEMS current glsl old_no_early_out)
    set(_vf_target test_jce_volfog_shadow_fade)
    set(_vf_selected "${_vf_current_path}")
    set(_vf_language 0)
    set(_vf_kind unit)
    if(_vf_variant STREQUAL "glsl")
        string(APPEND _vf_target "_glsl")
        set(_vf_language 1)
    elseif(_vf_variant STREQUAL "old_no_early_out")
        string(APPEND _vf_target "_old_no_early_out")
        set(_vf_selected "${_vf_old_path}")
        set(_vf_kind contract)
    endif()
    jce_add_cxx_test(${_vf_target} KIND ${_vf_kind}
        SOURCES test_jce_volfog_shadow_fade.cpp)
    target_compile_definitions(${_vf_target} PRIVATE
        BGFX_SHADER_LANGUAGE_GLSL=${_vf_language}
        JCE_TEST_VFOG_CURRENT="${_vf_selected}"
        JCE_TEST_VFOG_REFERENCE="${_vf_old_path}")
    if(_vf_kind STREQUAL "contract")
        set_tests_properties(${_vf_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_vf_variable IN ITEMS owner source begin end anchor begin_first begin_last end_first end_last length helper guard consumer wire first last old current variant body current_path old_path target selected language kind)
    unset(_vf_${_vf_variable})
endforeach()
unset(_vf_variable)
