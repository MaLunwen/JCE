set(_bgfx_attempt_renderer "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_renderer.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_bgfx_attempt_renderer}")
file(READ "${_bgfx_attempt_renderer}" _bgfx_attempt_source)
string(FIND "${_bgfx_attempt_source}" "static bool init_backend_attempt(" _bgfx_attempt_begin)
string(FIND "${_bgfx_attempt_source}" "/* Platform-preferred bgfx fallback chain." _bgfx_attempt_end)
if(_bgfx_attempt_begin LESS 0 OR _bgfx_attempt_end LESS_EQUAL _bgfx_attempt_begin)
    message(FATAL_ERROR "Profiler fixture requires the complete actual backend attempt")
endif()
math(EXPR _bgfx_attempt_length "${_bgfx_attempt_end} - ${_bgfx_attempt_begin}")
string(SUBSTRING "${_bgfx_attempt_source}" ${_bgfx_attempt_begin} ${_bgfx_attempt_length} _bgfx_attempt_body)
string(FIND "${_bgfx_attempt_source}" "JceRenderer *jce_renderer_create_headless_impl(void)" _bgfx_attempt_begin)
string(FIND "${_bgfx_attempt_source}" "    r->headless    = true;" _bgfx_attempt_end)
if(_bgfx_attempt_begin LESS 0 OR _bgfx_attempt_end LESS_EQUAL _bgfx_attempt_begin)
    message(FATAL_ERROR "Profiler fixture requires the actual headless init/allocation prefix")
endif()
math(EXPR _bgfx_attempt_length "${_bgfx_attempt_end} - ${_bgfx_attempt_begin}")
string(SUBSTRING "${_bgfx_attempt_source}" ${_bgfx_attempt_begin} ${_bgfx_attempt_length} _bgfx_attempt_headless)
string(FIND "${_bgfx_attempt_source}" "    /* Vertex layout: Position (float3) + Color0 (UINT8x4, normalized). */" _bgfx_attempt_begin)
if(_bgfx_attempt_begin LESS 0)
    message(FATAL_ERROR "Profiler fixture requires the actual window allocation prefix")
endif()
string(SUBSTRING "${_bgfx_attempt_source}" ${_bgfx_attempt_begin} -1 _bgfx_attempt_allocation)
string(FIND "${_bgfx_attempt_allocation}" "    r->reset_flags = reset_flags;" _bgfx_attempt_end)
if(_bgfx_attempt_end LESS 0)
    message(FATAL_ERROR "Profiler fixture requires the actual window allocation cleanup")
endif()
string(SUBSTRING "${_bgfx_attempt_allocation}" 0 ${_bgfx_attempt_end} _bgfx_attempt_allocation)
set(_bgfx_attempt_publication "    r->reset_flags = reset_flags;\n    r->launch_vsync = presentation;\n")
string(FIND "${_bgfx_attempt_source}" "${_bgfx_attempt_publication}" _bgfx_attempt_first)
string(FIND "${_bgfx_attempt_source}" "${_bgfx_attempt_publication}" _bgfx_attempt_last REVERSE)
if(_bgfx_attempt_first LESS 0 OR NOT _bgfx_attempt_first EQUAL _bgfx_attempt_last)
    message(FATAL_ERROR "Presentation fixture requires the actual adjacent initial flags/policy publication")
endif()
string(LENGTH "${_bgfx_attempt_publication}" _bgfx_attempt_length)
string(SUBSTRING "${_bgfx_attempt_source}" ${_bgfx_attempt_first} ${_bgfx_attempt_length} _bgfx_attempt_publication)
string(FIND "${_bgfx_attempt_source}" "JceRenderer *jce_renderer_create_impl(" _bgfx_attempt_begin)
string(FIND "${_bgfx_attempt_source}" "    /* The ladder builds its context" _bgfx_attempt_end)
if(_bgfx_attempt_begin LESS 0 OR _bgfx_attempt_end LESS_EQUAL _bgfx_attempt_begin)
    message(FATAL_ERROR "Launch fixture requires the complete actual pre-acquisition admission prefix")
endif()
math(EXPR _bgfx_attempt_length "${_bgfx_attempt_end} - ${_bgfx_attempt_begin}")
string(SUBSTRING "${_bgfx_attempt_source}" ${_bgfx_attempt_begin} ${_bgfx_attempt_length} _bgfx_attempt_prefix)
string(APPEND _bgfx_attempt_prefix "    fixture_observe_launch_snapshot(&launch);\n    return (JceRenderer *)win;\n}\n")
string(FIND "${_bgfx_attempt_source}" "JceRenderer *jce_renderer_create_fallback_impl(" _bgfx_attempt_begin)
string(SUBSTRING "${_bgfx_attempt_source}" ${_bgfx_attempt_begin} -1 _bgfx_attempt_fallback)
string(FIND "${_bgfx_attempt_fallback}" "    JceRenderer *r = (JceRenderer *)JCE_CALLOC" _bgfx_attempt_end)
if(_bgfx_attempt_begin LESS 0 OR _bgfx_attempt_end LESS 0)
    message(FATAL_ERROR "Launch fixture requires the complete actual software pre-allocation prefix")
endif()
string(SUBSTRING "${_bgfx_attempt_fallback}" 0 ${_bgfx_attempt_end} _bgfx_attempt_fallback)
string(APPEND _bgfx_attempt_fallback "    return (JceRenderer *)win;\n}\n")
set(_bgfx_attempt_current "${_bgfx_attempt_fallback}\n${_bgfx_attempt_prefix}\n${_bgfx_attempt_body}\n${_bgfx_attempt_headless}    return r;\n}\nstatic JceRenderer *fixture_window_allocation(void)\n{\n${_bgfx_attempt_allocation}    return r;\n}\nstatic void fixture_publish_presentation(JceRenderer *r, uint32_t reset_flags, JceRendererLaunchVsync presentation)\n{\n${_bgfx_attempt_publication}}\n")
set(_bgfx_attempt_initial_wire "    init.resolution.reset  = renderer_presentation_vsync_refresh(&candidate, type, window, reset_flags);")
string(FIND "${_bgfx_attempt_current}" "${_bgfx_attempt_initial_wire}" _bgfx_attempt_first)
string(FIND "${_bgfx_attempt_current}" "${_bgfx_attempt_initial_wire}" _bgfx_attempt_last REVERSE)
if(_bgfx_attempt_first LESS 0 OR NOT _bgfx_attempt_first EQUAL _bgfx_attempt_last)
    message(FATAL_ERROR "Presentation control requires the one actual initial mask call")
endif()
string(REPLACE "${_bgfx_attempt_initial_wire}" "    init.resolution.reset  = reset_flags; /* old: ignores hidden presentation */"
    _bgfx_attempt_old_initial_mask "${_bgfx_attempt_current}")
set(_bgfx_attempt_launch_wire "    renderer_launch_diagnostics_apply(launch, &init);\n")
string(FIND "${_bgfx_attempt_current}" "${_bgfx_attempt_launch_wire}" _bgfx_attempt_first)
string(FIND "${_bgfx_attempt_current}" "${_bgfx_attempt_launch_wire}" _bgfx_attempt_last REVERSE)
if(_bgfx_attempt_first LESS 0 OR NOT _bgfx_attempt_first EQUAL _bgfx_attempt_last)
    message(FATAL_ERROR "Launch control requires the one actual diagnostic forwarding wire")
endif()
string(REPLACE "${_bgfx_attempt_launch_wire}" "" _bgfx_attempt_old_launch_wire "${_bgfx_attempt_current}")
set(_bgfx_attempt_old "${_bgfx_attempt_current}")
foreach(_bgfx_attempt_reason IN ITEMS INIT_FAILED API_REFUSED ALLOCATION_FAILED)
    set(_bgfx_attempt_wire "        jce_rcb_cpu_profiler_attempt_end(JCE_BGFX_CPU_ATTEMPT_${_bgfx_attempt_reason});\n")
    # The window API tail is outside an if block and has four-space indentation.
    string(REPLACE "${_bgfx_attempt_wire}" "" _bgfx_attempt_old "${_bgfx_attempt_old}")
    string(REPLACE "    jce_rcb_cpu_profiler_attempt_end(JCE_BGFX_CPU_ATTEMPT_${_bgfx_attempt_reason});\n" ""
        _bgfx_attempt_old "${_bgfx_attempt_old}")
endforeach()
if(_bgfx_attempt_current STREQUAL _bgfx_attempt_old)
    message(FATAL_ERROR "Profiler attempt control must omit actual terminal wires")
endif()
string(REGEX MATCHALL "jce_rcb_cpu_profiler_attempt_end\\(" _bgfx_attempt_wires "${_bgfx_attempt_current}")
list(LENGTH _bgfx_attempt_wires _bgfx_attempt_count)
if(NOT _bgfx_attempt_count EQUAL 6)
    message(FATAL_ERROR "Profiler attempt fixture requires six actual terminal wires")
endif()
set(_bgfx_attempt_dir "${CMAKE_CURRENT_BINARY_DIR}/bgfx-profiler-attempts")
file(MAKE_DIRECTORY "${_bgfx_attempt_dir}")
set(_bgfx_attempt_xp "${_bgfx_attempt_current}")
foreach(_bgfx_attempt_variant IN ITEMS current xp old old_initial_mask old_launch_wire)
    if(NOT JCE_PLATFORM_WINDOWS AND
        (_bgfx_attempt_variant STREQUAL "xp" OR _bgfx_attempt_variant STREQUAL "old_initial_mask"))
        continue()
    endif()
    set(_bgfx_attempt_output "${_bgfx_attempt_dir}/${_bgfx_attempt_variant}.inc.h")
    unset(_bgfx_attempt_previous)
    if(EXISTS "${_bgfx_attempt_output}")
        file(READ "${_bgfx_attempt_output}" _bgfx_attempt_previous)
    endif()
    if(NOT _bgfx_attempt_previous STREQUAL _bgfx_attempt_${_bgfx_attempt_variant})
        file(WRITE "${_bgfx_attempt_output}" "${_bgfx_attempt_${_bgfx_attempt_variant}}")
    endif()
    set(_bgfx_attempt_target test_jce_bgfx_profiler_attempts)
    set(_bgfx_attempt_kind unit)
    if(_bgfx_attempt_variant STREQUAL "xp")
        set(_bgfx_attempt_target test_jce_renderer_xp_backend_attempts)
    elseif(_bgfx_attempt_variant STREQUAL "old")
        set(_bgfx_attempt_target test_jce_bgfx_profiler_attempts_old_missing_terminal)
        set(_bgfx_attempt_kind contract)
    elseif(_bgfx_attempt_variant STREQUAL "old_initial_mask")
        set(_bgfx_attempt_target test_jce_bgfx_profiler_attempts_old_initial_mask)
        set(_bgfx_attempt_kind contract)
    elseif(_bgfx_attempt_variant STREQUAL "old_launch_wire")
        set(_bgfx_attempt_target test_jce_bgfx_profiler_attempts_old_launch_wire)
        set(_bgfx_attempt_kind contract)
    endif()
    jce_add_unit_test(${_bgfx_attempt_target} KIND ${_bgfx_attempt_kind}
        SOURCES test_jce_bgfx_profiler_attempts.c
        LINK jce_core SDL3_image::SDL3_image bgfx::bgfx
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src")
    target_compile_definitions(${_bgfx_attempt_target} PRIVATE
        JCE_BGFX_PROFILER_ATTEMPT_OWNER="${_bgfx_attempt_output}")
    if(_bgfx_attempt_variant STREQUAL "xp")
        target_compile_definitions(${_bgfx_attempt_target} PRIVATE JCE_TEST_BGFX_XP_ATTEMPT=1)
    endif()
    if(MSVC)
        target_compile_options(${_bgfx_attempt_target} PRIVATE /Zc:preprocessor)
    endif()
    if(_bgfx_attempt_kind STREQUAL "contract")
        set_tests_properties(${_bgfx_attempt_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_bgfx_attempt_variable IN ITEMS renderer source begin end length body prefix fallback headless allocation current xp old
    reason wire wires count dir variant output previous target kind publication first last initial_wire old_initial_mask launch_wire old_launch_wire)
    unset(_bgfx_attempt_${_bgfx_attempt_variable})
endforeach()
unset(_bgfx_attempt_variable)
