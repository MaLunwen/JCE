# Actual shared shader helper and both complete dynamic-atlas consumers through
# typed CPU ports. No shader compiler, graphics device, or performance claim.
function(_jce_csm_dynamic_filter_controls)
    set(shader_dir "${CMAKE_SOURCE_DIR}/engine/shaders/pbr")
    foreach(name IN ITEMS csm_filter csm_shadow fs_pbr_decl)
        set(path "${shader_dir}/${name}.sh")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
        file(READ "${path}" ${name})
    endforeach()
    foreach(part IN ITEMS helper common pbr)
        if(part STREQUAL "helper")
            set(source "${csm_filter}")
            set(begin "float csm_dynamic_pcf(")
            set(end "float csm_pcf_filter(")
        elseif(part STREQUAL "common")
            set(source "${csm_shadow}")
            set(begin "float csm_dyn_min(")
            set(end "float toShadowDepth(")
        else()
            set(source "${fs_pbr_decl}")
            set(begin "    // Dual shadow maps: min()")
            set(end "vec3 safe_normalize_vec3(")
        endif()
        string(FIND "${source}" "${begin}" first)
        string(FIND "${source}" "${begin}" first_last REVERSE)
        string(FIND "${source}" "${end}" last)
        string(FIND "${source}" "${end}" last_last REVERSE)
        if(first LESS 0 OR NOT first EQUAL first_last OR
           NOT last EQUAL last_last OR NOT last GREATER first)
            message(FATAL_ERROR "Dynamic CSM controls require unique complete ${part} boundaries")
        endif()
        math(EXPR length "${last} - ${first}")
        string(SUBSTRING "${source}" ${first} ${length} ${part})
    endforeach()
    # Observe only the preceding static result and already projected receiver.
    # The complete actual PBR dynamic block, including return/closure, is kept.
    set(pbr "float csm_dyn_pbr(float s, int cascade, vec2 csm_uv, float csm_z, float depth_bias)\n{\n${pbr}")
    set(current "${helper}\n${common}\n${pbr}")
    set(old "${current}")
    # This whole-owner negative restores the historical equal point-PCF weights;
    # it deliberately keeps the same reads, clamp, quality gate and consumers.
    foreach(wire IN ITEMS
        "vec2 w0 = 0.5 * left * left;"
        "vec2 w1 = 0.75 - phase * phase;"
        "vec2 w2 = 0.5 * right * right;")
        string(FIND "${old}" "${wire}" first)
        string(FIND "${old}" "${wire}" last REVERSE)
        if(first LESS 0 OR NOT first EQUAL last)
            message(FATAL_ERROR "Dynamic CSM old control requires one actual weight statement")
        endif()
        string(SUBSTRING "${wire}" 0 7 lhs)
        string(REPLACE "${wire}" "${lhs} = vec2_splat(1.0 / 3.0);" old "${old}")
    endforeach()
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/csm-dynamic-filter")
    foreach(variant IN ITEMS current old)
        # Float literals are the only syntax adapter; no algorithm is copied.
        string(REGEX REPLACE "([0-9]+\\.[0-9]+)" "\\1f" adapted "${${variant}}")
        set(${variant}_path "${CMAKE_CURRENT_BINARY_DIR}/csm-dynamic-filter/${variant}.inc.h")
        jce_test_write_if_changed("${${variant}_path}" "${adapted}")
    endforeach()
    foreach(gl IN ITEMS 0 1)
        foreach(variant IN ITEMS current old_box_weights)
            set(target "test_jce_csm_dynamic_filter_gl${gl}")
            set(kind unit)
            set(selected "${current_path}")
            if(variant STREQUAL "old_box_weights")
                string(APPEND target "_old_box_weights")
                set(kind contract)
                set(selected "${old_path}")
            endif()
            jce_add_cxx_test(${target} KIND ${kind}
                SOURCES test_jce_csm_dynamic_filter.cpp)
            target_compile_definitions(${target} PRIVATE
                BGFX_SHADER_LANGUAGE_GLSL=${gl}
                JCE_TEST_CSM_DYNAMIC_OWNER="${selected}")
            if(kind STREQUAL "contract")
                set_tests_properties(${target} PROPERTIES WILL_FAIL TRUE)
            endif()
        endforeach()
    endforeach()
endfunction()
_jce_csm_dynamic_filter_controls()
