set(_pbr_custom_owner "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_pbr_material.c")
set(_pbr_custom_trace "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_pbr_custom_trace_internal.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_pbr_custom_owner}" "${_pbr_custom_trace}")
file(READ "${_pbr_custom_owner}" _pbr_custom_source)
string(FIND "${_pbr_custom_source}" "static void safe_copy(" _pbr_custom_begin)
string(FIND "${_pbr_custom_source}" "void jce_pbr_material_shutdown(void)" _pbr_custom_end)
if(_pbr_custom_begin LESS 0 OR _pbr_custom_end LESS_EQUAL _pbr_custom_begin)
    message(FATAL_ERROR "Custom shader fixture requires the complete actual path/cache/read/link owner")
endif()
math(EXPR _pbr_custom_length "${_pbr_custom_end} - ${_pbr_custom_begin}")
string(SUBSTRING "${_pbr_custom_source}" ${_pbr_custom_begin} ${_pbr_custom_length} _pbr_custom_current)
set(_pbr_custom_old_missing_blob "${_pbr_custom_current}")
foreach(_pbr_custom_stage IN ITEMS vs fs)
    set(_pbr_custom_wire "    pbr_custom_blob_trace_publish(${_pbr_custom_stage}_scope, &${_pbr_custom_stage}_detail, ${_pbr_custom_stage}_rel, ${_pbr_custom_stage}_path);")
    string(FIND "${_pbr_custom_current}" "${_pbr_custom_wire}" _pbr_custom_first)
    string(FIND "${_pbr_custom_current}" "${_pbr_custom_wire}" _pbr_custom_last REVERSE)
    if(_pbr_custom_first LESS 0 OR NOT _pbr_custom_first EQUAL _pbr_custom_last)
        message(FATAL_ERROR "Custom shader control requires each exact blob publication wire")
    endif()
    string(REPLACE "${_pbr_custom_wire}" "    /* Historical missing blob publication. */"
        _pbr_custom_old_missing_blob "${_pbr_custom_old_missing_blob}")
endforeach()
set(_pbr_custom_budget "        pbr_custom_program_trace_publish(load_scope, false, false, false, PBR_CUSTOM_PROGRAM_CACHE_BUDGET);")
set(_pbr_custom_finish "    pbr_custom_program_trace_publish(load_scope, create_attempted, prog != UINT16_MAX, cache_admitted,\n        prog != UINT16_MAX ? PBR_CUSTOM_PROGRAM_OK : create_attempted ? PBR_CUSTOM_PROGRAM_CREATE_FAILED_UNKNOWN : PBR_CUSTOM_PROGRAM_BLOB_FAILED);")
set(_pbr_custom_old_missing_program "${_pbr_custom_current}")
foreach(_pbr_custom_kind IN ITEMS budget finish)
    set(_pbr_custom_wire "${_pbr_custom_${_pbr_custom_kind}}")
    string(FIND "${_pbr_custom_current}" "${_pbr_custom_wire}" _pbr_custom_first)
    string(FIND "${_pbr_custom_current}" "${_pbr_custom_wire}" _pbr_custom_last REVERSE)
    if(_pbr_custom_first LESS 0 OR NOT _pbr_custom_first EQUAL _pbr_custom_last)
        message(FATAL_ERROR "Custom shader control requires each exact program publication wire")
    endif()
    string(REPLACE "${_pbr_custom_wire}" "    /* Historical missing program publication. */"
        _pbr_custom_old_missing_program "${_pbr_custom_old_missing_program}")
endforeach()
set(_pbr_custom_dir "${CMAKE_CURRENT_BINARY_DIR}/pbr-custom-trace")
file(MAKE_DIRECTORY "${_pbr_custom_dir}")
foreach(_pbr_custom_variant IN ITEMS current old_missing_blob old_missing_program)
    set(_pbr_custom_path "${_pbr_custom_dir}/${_pbr_custom_variant}.inc.h")
    unset(_pbr_custom_previous)
    if(EXISTS "${_pbr_custom_path}")
        file(READ "${_pbr_custom_path}" _pbr_custom_previous)
    endif()
    if(NOT _pbr_custom_previous STREQUAL _pbr_custom_${_pbr_custom_variant})
        file(WRITE "${_pbr_custom_path}" "${_pbr_custom_${_pbr_custom_variant}}")
    endif()
    set(_pbr_custom_target test_jce_pbr_custom_trace)
    set(_pbr_custom_test_kind unit)
    if(NOT _pbr_custom_variant STREQUAL "current")
        set(_pbr_custom_target "test_jce_pbr_custom_trace_${_pbr_custom_variant}")
        set(_pbr_custom_test_kind contract)
    endif()
    jce_add_unit_test(${_pbr_custom_target} KIND ${_pbr_custom_test_kind}
        SOURCES test_jce_pbr_custom_trace.c LINK jce_core jce_resource
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src")
    target_compile_definitions(${_pbr_custom_target} PRIVATE
        "JCE_TEST_PBR_CUSTOM_OWNER=\"${_pbr_custom_path}\"")
    if(NOT _pbr_custom_variant STREQUAL "current")
        set_tests_properties(${_pbr_custom_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_pbr_custom_variable IN ITEMS owner trace source begin end length current old_missing_blob stage wire
    first last budget finish old_missing_program kind dir variant path previous target test_kind)
    unset(_pbr_custom_${_pbr_custom_variable})
endforeach()
unset(_pbr_custom_variable)
