set(_taa_owner "${CMAKE_SOURCE_DIR}/engine/src/renderer/jce_postfx.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_taa_owner}")
file(READ "${_taa_owner}" _taa_source)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/postfx-taa-owner")
foreach(_case IN ITEMS current old_history_gate old_transfer missing_rollback
        missing_output_metadata requested_output_extent borrowed_owned
        missing_output_retirement reject_output_zero missing_output_pair_guard)
    set(_source "${_taa_source}")
    set(_target test_jce_postfx_taa_ownership)
    set(_kind integration)
    if(_case STREQUAL "old_history_gate")
        set(_wire "static void destroy_taa_fbos(JcePostFXPipeline *p)\n{")
        set(_replacement "${_wire}\n    if (!p->taa_fbos_valid) return;")
    elseif(_case STREQUAL "old_transfer")
        set(_wire "bgfx_frame_buffer_handle_t framebuffer =\n        bgfx_create_frame_buffer_from_attachment(1, &at, false);\n    if (framebuffer.idx == UINT16_MAX) {")
        set(_replacement "bgfx_frame_buffer_handle_t framebuffer =\n        bgfx_create_frame_buffer_from_attachment(1, &at, true);\n    if (framebuffer.idx == UINT16_MAX) {")
    elseif(_case STREQUAL "missing_output_metadata")
        set(_wire "    p->fbo_width[i] = fw;")
        set(_replacement "    /* Ordinary control: omit admitted width. */")
    elseif(_case STREQUAL "requested_output_extent")
        set(_wire "    target->width = pipeline->fbo_width[slot];")
        set(_replacement "    target->width = pipeline->width;")
    elseif(_case STREQUAL "borrowed_owned")
        set(_wire "        target->kind = JCE_POSTFX_OUTPUT_BORROWED;")
        set(_replacement "        target->kind = JCE_POSTFX_OUTPUT_OWNED;")
    elseif(_case STREQUAL "missing_output_retirement")
        set(_wire "        p->fbo[i].idx = p->fbo_tex[i].idx = UINT16_MAX;\n        p->fbo_width[i] = p->fbo_height[i] = 0;")
        set(_replacement "        p->fbo[i].idx = p->fbo_tex[i].idx = UINT16_MAX;")
    elseif(_case STREQUAL "reject_output_zero")
        set(_wire "    if (!pipeline || pipeline->output_tex.idx == UINT16_MAX) return false;")
        set(_replacement "    if (!pipeline || pipeline->output_tex.idx == 0 || pipeline->output_tex.idx == UINT16_MAX) return false;")
    elseif(_case STREQUAL "missing_output_pair_guard")
        set(_wire "        pipeline->output_tex.idx != pipeline->fbo_tex[slot].idx ||")
        set(_replacement "        false ||")
    elseif(_case STREQUAL "missing_rollback")
        set(_wire "if (framebuffer.idx == UINT16_MAX) {\n        bgfx_destroy_texture(texture);")
        set(_replacement "if (framebuffer.idx == UINT16_MAX) {\n        /* ordinary control: omit retained caller texture release */")
    endif()
    if(NOT _case STREQUAL "current")
        string(FIND "${_source}" "${_wire}" _offset)
        if(_offset LESS 0)
            message(FATAL_ERROR "TAA ownership ${_case} requires its actual owner wire")
        endif()
        string(LENGTH "${_wire}" _length)
        math(EXPR _after "${_offset} + ${_length}")
        string(SUBSTRING "${_source}" ${_after} -1 _tail)
        string(FIND "${_tail}" "${_wire}" _duplicate)
        if(NOT _duplicate LESS 0)
            message(FATAL_ERROR "TAA ownership ${_case} must change exactly one wire")
        endif()
        string(REPLACE "${_wire}" "${_replacement}" _source "${_source}")
        string(APPEND _target "_${_case}")
        set(_kind contract)
    endif()
    set(_path "${CMAKE_CURRENT_BINARY_DIR}/postfx-taa-owner/${_case}.c")
    jce_test_write_if_changed("${_path}" "${_source}")
    jce_add_unit_test(${_target} KIND ${_kind}
        SOURCES test_jce_postfx_taa_ownership.c
        LINK jce_core jce_renderer jce_resource bgfx::bgfx
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src" "${CMAKE_SOURCE_DIR}/engine/src/renderer")
    target_compile_definitions(${_target} PRIVATE JCE_TEST_POSTFX_OWNER="${_path}")
    if(MSVC)
        target_compile_options(${_target} PRIVATE /Zc:preprocessor)
    endif()
    if(NOT _case STREQUAL "current")
        set_tests_properties(${_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
