set(_grass_gate_draw_path "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene/jce_sr_draw.c")
set(_grass_gate_owner_path "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene/jce_sr_grass_gate.c")
set(_grass_gate_prepare_path "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene/jce_sr_grass_prepare.c")
set(_grass_gate_phase_path "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene/jce_sr_colour_special_internal.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_grass_gate_draw_path}" "${_grass_gate_owner_path}" "${_grass_gate_prepare_path}"
    "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene/jce_sr_grass_gate_internal.h" "${_grass_gate_phase_path}")
file(READ "${_grass_gate_draw_path}" _grass_gate_draw)
file(READ "${_grass_gate_owner_path}" _grass_gate_owner)
file(READ "${_grass_gate_prepare_path}" _grass_gate_prepare)
file(READ "${_grass_gate_phase_path}" _grass_gate_phase)
function(_jce_grass_gate_region SOURCE BEGIN END OUT)
    string(FIND "${SOURCE}" "${BEGIN}" _first)
    string(FIND "${SOURCE}" "${BEGIN}" _last REVERSE)
    string(FIND "${SOURCE}" "${END}" _end)
    if(_first LESS 0 OR NOT _first EQUAL _last OR _end LESS_EQUAL _first)
        message(FATAL_ERROR "Grass gate fixture requires exact complete actual region: ${BEGIN}")
    endif()
    math(EXPR _length "${_end} - ${_first}")
    string(SUBSTRING "${SOURCE}" ${_first} ${_length} _body)
    set(${OUT} "${_body}" PARENT_SCOPE)
endfunction()
_jce_grass_gate_region("${_grass_gate_draw}" "#if defined(JCE_TRACY_ENABLED) && (JCE_TRACY_ENABLED + 0 == 1)"
    "/* ── Per-entity LOD hysteresis state" _grass_gate_zones)
string(FIND "${_grass_gate_draw}" "void sr_draw_entities(" _grass_gate_draw_start)
if(_grass_gate_draw_start LESS 0)
    message(FATAL_ERROR "Grass gate fixture requires the actual colour draw function")
endif()
string(SUBSTRING "${_grass_gate_draw}" ${_grass_gate_draw_start} -1 _grass_gate_draw)
_jce_grass_gate_region("${_grass_gate_draw}" "    SR_ZONE_BEGIN(_z_pre, \"SceneDraw::Prepare\");"
    "    uint64_t _t0_pre =" _grass_gate_entry)
set(_grass_gate_pre_end "    SR_ZONE_END(_z_pre);\n")
set(_grass_gate_pre_end_boundary "${_grass_gate_pre_end}    SR_ZONE_BEGIN(_z_loop,")
string(FIND "${_grass_gate_draw}" "${_grass_gate_pre_end_boundary}" _grass_gate_pre_end_position)
if(_grass_gate_pre_end_position LESS 0)
    message(FATAL_ERROR "Grass gate fixture requires the actual normal Prepare-zone close")
endif()
_jce_grass_gate_region("${_grass_gate_draw}" "    SrGrassGatePass grass_gate_pass;"
    "    /* Water phase:" _grass_gate_begin)
_jce_grass_gate_region("${_grass_gate_draw}" "    if (list->count == 0) {"
    "    /* Gather lights. */" _grass_gate_empty)
_jce_grass_gate_region("${_grass_gate_draw}"
    "            if (cfg->draw_opaque && jce_scene_has_grass_field(scene, e)) {"
    "        } /* end if(!kc_prim):" _grass_gate_branch)
_jce_grass_gate_region("${_grass_gate_prepare}" "bool sr_grass_field_admitted("
    "static float sr_grass_density_scale(" _grass_gate_admission)
string(FIND "${_grass_gate_owner}" "void sr_grass_draw_colour_request(" _grass_gate_owner_start)
if(_grass_gate_owner_start LESS 0)
    message(FATAL_ERROR "Grass gate fixture requires the complete moved actual colour request")
endif()
string(SUBSTRING "${_grass_gate_owner}" ${_grass_gate_owner_start} -1 _grass_gate_owner)
set(_grass_gate_owners "${_grass_gate_admission}\n${_grass_gate_owner}")
set(_grass_gate_publish "    sr_grass_gate_pass_publish(&sr->grass_gate_trace, grass_gate_pass_ptr,\n        sr, view_id, sr->grass_resource_generation);")
string(FIND "${_grass_gate_draw}" "    /* Delayed special stages:" _grass_gate_tail_start)
if(_grass_gate_tail_start LESS 0)
    message(FATAL_ERROR "Grass gate fixture requires actual delayed submission owner")
endif()
string(SUBSTRING "${_grass_gate_draw}" ${_grass_gate_tail_start} -1 _grass_gate_tail)
_jce_grass_gate_region("${_grass_gate_tail}" "    sr_colour_special_submit_opaque("
    "${_grass_gate_publish}" _grass_gate_submit)
set(_grass_gate_empty_publish "        sr_grass_gate_pass_publish(&sr->grass_gate_trace, grass_gate_pass_ptr,\n            sr, view_id, sr->grass_resource_generation);")
foreach(_grass_gate_kind IN ITEMS publish empty_publish)
    set(_grass_gate_wire "${_grass_gate_${_grass_gate_kind}}")
    string(FIND "${_grass_gate_draw}" "${_grass_gate_wire}" _grass_gate_first)
    string(FIND "${_grass_gate_draw}" "${_grass_gate_wire}" _grass_gate_last REVERSE)
    if(_grass_gate_first LESS 0 OR NOT _grass_gate_first EQUAL _grass_gate_last)
        message(FATAL_ERROR "Grass gate fixture requires both exact actual publication wires")
    endif()
endforeach()
set(_grass_gate_dir "${CMAKE_CURRENT_BINARY_DIR}/grass-early-gate")
file(MAKE_DIRECTORY "${_grass_gate_dir}")
foreach(_grass_gate_variant IN ITEMS current missing_publication old_history_mask missing_empty_close)
    set(_grass_gate_current_publish "${_grass_gate_publish}")
    set(_grass_gate_current_empty "${_grass_gate_empty}")
    if(_grass_gate_variant STREQUAL "missing_publication")
        set(_grass_gate_current_publish "    (void)grass_gate_pass_ptr; /* Historical omitted publication. */")
        string(REPLACE "${_grass_gate_empty_publish}" "        (void)grass_gate_pass_ptr;"
            _grass_gate_current_empty "${_grass_gate_empty}")
    elseif(_grass_gate_variant STREQUAL "old_history_mask")
        set(_grass_gate_current_publish "    if (!sr->grass_gate_reported_reasons) {\n${_grass_gate_publish}\n    }")
        string(REPLACE "${_grass_gate_empty_publish}"
            "        if (!sr->grass_gate_reported_reasons) {\n${_grass_gate_empty_publish}\n        }"
            _grass_gate_current_empty "${_grass_gate_empty}")
    elseif(_grass_gate_variant STREQUAL "missing_empty_close")
        set(_grass_gate_empty_close "        SR_ZONE_END(_z_pre);\n")
        string(FIND "${_grass_gate_current_empty}" "${_grass_gate_empty_close}" _grass_gate_close_first)
        string(FIND "${_grass_gate_current_empty}" "${_grass_gate_empty_close}" _grass_gate_close_last REVERSE)
        if(_grass_gate_close_first LESS 0 OR NOT _grass_gate_close_first EQUAL _grass_gate_close_last)
            message(FATAL_ERROR "Empty Prepare-zone control requires one actual early-return close")
        endif()
        string(REPLACE "${_grass_gate_empty_close}" "        /* Former missing Prepare-zone close. */\n"
            _grass_gate_current_empty "${_grass_gate_current_empty}")
    endif()
    foreach(_grass_gate_part IN ITEMS owners begin branch submit phase zones entry pre_end)
        set(_grass_gate_${_grass_gate_part}_content "${_grass_gate_${_grass_gate_part}}")
    endforeach()
    set(_grass_gate_empty_content "${_grass_gate_current_empty}")
    set(_grass_gate_publish_content "${_grass_gate_current_publish}")
    foreach(_grass_gate_part IN ITEMS owners begin branch submit phase zones entry pre_end empty publish)
        set(_grass_gate_path "${_grass_gate_dir}/${_grass_gate_variant}_${_grass_gate_part}.inc.h")
        unset(_grass_gate_previous)
        if(EXISTS "${_grass_gate_path}")
            file(READ "${_grass_gate_path}" _grass_gate_previous)
        endif()
        if(NOT _grass_gate_previous STREQUAL _grass_gate_${_grass_gate_part}_content)
            file(WRITE "${_grass_gate_path}" "${_grass_gate_${_grass_gate_part}_content}")
        endif()
    endforeach()
    set(_grass_gate_target test_jce_grass_early_gate_trace)
    set(_grass_gate_test_kind unit)
    if(NOT _grass_gate_variant STREQUAL "current")
        set(_grass_gate_target "test_jce_grass_early_gate_trace_${_grass_gate_variant}")
        set(_grass_gate_test_kind contract)
    endif()
    jce_add_unit_test(${_grass_gate_target} KIND ${_grass_gate_test_kind}
        SOURCES test_jce_grass_early_gate_trace.c LINK jce_core
        INCLUDES "${CMAKE_SOURCE_DIR}/engine/src")
    foreach(_grass_gate_part IN ITEMS owners begin branch submit phase zones entry pre_end empty publish)
        string(TOUPPER "${_grass_gate_part}" _grass_gate_define)
        target_compile_definitions(${_grass_gate_target} PRIVATE
            "JCE_TEST_GRASS_GATE_${_grass_gate_define}=\"${_grass_gate_dir}/${_grass_gate_variant}_${_grass_gate_part}.inc.h\"")
    endforeach()
    if(NOT _grass_gate_variant STREQUAL "current")
        set_tests_properties(${_grass_gate_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_grass_gate_var IN ITEMS draw_path owner_path prepare_path phase_path draw owner prepare phase draw_start begin empty branch
    zones entry pre_end pre_end_boundary pre_end_position empty_close close_first close_last
    tail_start tail submit admission owner_start owners publish empty_publish kind wire first last dir variant current_publish current_empty
    part owners_content begin_content branch_content submit_content phase_content zones_content entry_content pre_end_content empty_content publish_content path previous target test_kind define)
    unset(_grass_gate_${_grass_gate_var})
endforeach()
unset(_grass_gate_var)
