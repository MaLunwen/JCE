# Actual sky admission/geometry prefix, uniform witness and submit owner.
function(_jce_add_sky_admission_controls)
    set(_main_path "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene/jce_scene_renderer.c")
    set(_sky_path "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene/jce_sr_environment.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_main_path}" "${_sky_path}")
    file(READ "${_main_path}" _main)
    file(READ "${_sky_path}" _sky)
    function(_sky_region SOURCE BEGIN END OUT)
        string(FIND "${SOURCE}" "${BEGIN}" _first)
        string(FIND "${SOURCE}" "${BEGIN}" _last REVERSE)
        string(FIND "${SOURCE}" "${END}" _end)
        if(_first LESS 0 OR NOT _first EQUAL _last OR _end LESS_EQUAL _first)
            message(FATAL_ERROR "Sky control requires unique actual region: ${BEGIN}")
        endif()
        math(EXPR _length "${_end}-${_first}")
        string(SUBSTRING "${SOURCE}" ${_first} ${_length} _body)
        set(${OUT} "${_body}" PARENT_SCOPE)
    endfunction()
    string(FIND "${_sky}" "static JceTraceScope sr_sky_trace_begin(" _current)
    set(_helpers "")
    if(_current LESS 0)
        _sky_region("${_main}" "    bool sky_drawn = false;" "    /* Editor overlay hook:" _gate)
        set(_gate "static bool run_pass(JceSceneRenderer *sr,uint16_t view_id_base,const JceSceneRenderConfig *cfg,int authored_mode) {\n(void)authored_mode;\n${_gate}\nreturn sky_drawn;\n}\n")
        set(_signature "void sr_draw_sky_gradient(JceSceneRenderer *sr, uint16_t view_id)")
        set(_variants current)
    else()
        _sky_region("${_sky}" "/* The existing device DIAG latch" "static SrSkySubmitResult sr_draw_sky_gradient(" _helpers)
        _sky_region("${_sky}" "bool sr_draw_sky_pass(" "/* ── Cloth pass" _gate)
        string(APPEND _gate "static bool run_pass(JceSceneRenderer *sr,uint16_t view,const JceSceneRenderConfig *cfg,int authored_mode) { return sr_draw_sky_pass(sr,NULL,NULL,view,cfg,authored_mode,false,(bgfx_texture_handle_t){UINT16_MAX}); }\n")
        set(_signature "static SrSkySubmitResult sr_draw_sky_gradient(")
        set(_unused_scene "    (void)scene; (void)camera; (void)cfg; (void)physical_fallback; (void)cloud_temporal; (void)cloud_depth;")
        set(_variants current missing_publication false_success wrong_uniform false_gpu wrong_physical_program)
        string(FIND "${_main}" "    const bool sky_drawn = sr_draw_sky_pass(sr, scene, camera, view_id_base, cfg,\n        scene_rendering ? scene_rendering->sky_mode : -1, admit_cloud_temporal, cloud_depth);" _wire)
        if(_wire LESS 0)
            message(FATAL_ERROR "Sky diagnostic must be wired to the actual render gate")
        endif()
    endif()
    _sky_region("${_sky}" "${_signature}" "    float sky_colors[12] =" _prefix)
    _sky_region("${_sky}" "    bgfx_set_uniform(sr->u_sky_params,  sky_params, 1);" "    /* ── Sky stylisation grade" _uniform)
    set(_atmosphere "    /* PHYSICAL sky reads")
    if(_sky MATCHES "sr_sky_bind_atmosphere")
        set(_atmosphere "    if (!sr->sky_legacy_gl21) {\n        sr_sky_bind_atmosphere(sr);")
    endif()
    _sky_region("${_sky}" "    bgfx_set_transient_vertex_buffer(0, &tvb, 0, 4);" "${_atmosphere}" _binding)
    set(_submit "    bgfx_submit(view_id, sr->prog_sky, 0, BGFX_DISCARD_ALL);")
    if(_current GREATER_EQUAL 0)
        set(_submit "    bgfx_submit(view_id, program, 0, BGFX_DISCARD_ALL);")
    endif()
    string(FIND "${_sky}" "${_submit}" _tail_begin)
    if(_tail_begin LESS 0)
        message(FATAL_ERROR "Sky diagnostic must include the selected program submit")
    endif()
    string(SUBSTRING "${_sky}" ${_tail_begin} -1 _tail)
    string(FIND "${_tail}" "\n}" _tail_end)
    math(EXPR _tail_length "${_tail_end}+3")
    string(SUBSTRING "${_tail}" 0 ${_tail_length} _tail)
    set(_dir "${CMAKE_CURRENT_BINARY_DIR}/sky-admission")
    file(MAKE_DIRECTORY "${_dir}")
    foreach(_variant IN LISTS _variants)
        set(_h "${_helpers}")
        set(_g "${_gate}")
        set(_p "${_prefix}")
        if(_variant STREQUAL missing_publication)
            string(REPLACE "    sr_sky_trace_end(sky_trace, sky_result);" "    (void)sky_result;" _g "${_g}")
        elseif(_variant STREQUAL false_success)
            string(REPLACE "return SR_SKY_PROGRAM_SENTINEL_INVALID;" "return SR_SKY_SUBMIT_RETURNED;" _p "${_p}")
        elseif(_variant STREQUAL wrong_uniform)
            string(REPLACE "memcpy(&bits, &value, sizeof(bits));" "bits = 0; (void)value;" _h "${_h}")
        elseif(_variant STREQUAL false_gpu)
            string(REPLACE "SKY_COUNT(\"gpu_completion_known\", 0);" "SKY_COUNT(\"gpu_completion_known\", 1);" _h "${_h}")
        elseif(_variant STREQUAL wrong_physical_program)
            string(REPLACE "? sr->prog_sky_physical_compat : sr->prog_sky;"
                "? sr->prog_sky : sr->prog_sky;" _g "${_g}")
        endif()
        set(_draw "${_p}\n${_unused_scene}\n    float sky_colors[12], sky_params[4];\n    memcpy(sky_colors,payload_colors,sizeof sky_colors);\n    memcpy(sky_params,payload_params,sizeof sky_params);\n${_uniform}\n${_binding}\n${_tail}\n")
        foreach(_part IN ITEMS helpers draw gate)
            set(_text "${_h}")
            if(_part STREQUAL draw)
                set(_text "${_draw}")
            elseif(_part STREQUAL gate)
                set(_text "${_g}")
            endif()
            set(_path "${_dir}/${_variant}_${_part}.inc.h")
            jce_test_write_if_changed("${_path}" "${_text}")
        endforeach()
        set(_target test_jce_sky_admission_trace)
        set(_kind unit)
        if(NOT _variant STREQUAL current)
            set(_target "${_target}_${_variant}")
            set(_kind contract)
        endif()
        jce_add_unit_test(${_target} KIND ${_kind}
            SOURCES test_jce_sky_admission_trace.c LINK jce_core bgfx::bgfx
            INCLUDES "${CMAKE_SOURCE_DIR}/engine/src")
        if(MSVC)
            target_compile_options(${_target} PRIVATE /Zc:preprocessor)
        endif()
        foreach(_part IN ITEMS helpers draw gate)
            string(TOUPPER "${_part}" _define)
            target_compile_definitions(${_target} PRIVATE "JCE_TEST_SKY_${_define}=\"${_dir}/${_variant}_${_part}.inc.h\"")
        endforeach()
        if(NOT _variant STREQUAL current)
            set_tests_properties(${_target} PROPERTIES WILL_FAIL TRUE)
        endif()
    endforeach()
endfunction()
_jce_add_sky_admission_controls()
