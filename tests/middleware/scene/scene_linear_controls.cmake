# Actual complete wrapper + one shader-flag assignment; no mirrored C body.
set(_scene_linear_source_path "${CMAKE_SOURCE_DIR}/engine/src/middleware/scene/jce_scene_renderer.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_scene_linear_source_path}")
file(READ "${_scene_linear_source_path}" _scene_linear_source)
function(_jce_scene_linear_range output begin end)
    string(FIND "${_scene_linear_source}" "${begin}" _first)
    string(FIND "${_scene_linear_source}" "${begin}" _first_last REVERSE)
    string(FIND "${_scene_linear_source}" "${end}" _last)
    string(FIND "${_scene_linear_source}" "${end}" _last_last REVERSE)
    if(_first LESS 0 OR NOT _first EQUAL _first_last OR
       _last LESS_EQUAL _first OR NOT _last EQUAL _last_last)
        message(FATAL_ERROR "Linear-render controls require unique actual owner anchors")
    endif()
    math(EXPR _length "${_last}-${_first}")
    string(SUBSTRING "${_scene_linear_source}" ${_first} ${_length} _body)
    set(${output} "${_body}" PARENT_SCOPE)
endfunction()
function(_jce_scene_linear_replace output needle replacement)
    string(FIND "${${output}}" "${needle}" _first)
    string(FIND "${${output}}" "${needle}" _last REVERSE)
    if(_first LESS 0 OR NOT _first EQUAL _last)
        message(FATAL_ERROR "Linear-render mutation requires one actual wire: ${needle}")
    endif()
    string(REPLACE "${needle}" "${replacement}" _body "${${output}}")
    set(${output} "${_body}" PARENT_SCOPE)
endfunction()
_jce_scene_linear_range(_scene_linear_wrapper
    "uint16_t jce_scene_renderer_render_linear("
    "uint16_t jce_scene_renderer_render(JceSceneRenderer *sr,")
_jce_scene_linear_range(_scene_linear_derived
    "    sr->postfx_tonemap_active =\n        sr->force_linear_output ||"
    "    /* Shadow filter tier + toon gate")
set(_scene_linear_old_force "${_scene_linear_derived}")
_jce_scene_linear_replace(_scene_linear_old_force
    "        sr->force_linear_output ||\n" "")
set(_scene_linear_missing_restore "${_scene_linear_wrapper}")
_jce_scene_linear_replace(_scene_linear_missing_restore
    "    sr->force_linear_output = previous_force;\n    sr->postfx_tonemap_active = previous_tonemap;"
    "    (void)previous_force; (void)previous_tonemap; /* missing scope restoration */")
set(_scene_linear_dir "${CMAKE_CURRENT_BINARY_DIR}/scene-linear")
file(MAKE_DIRECTORY "${_scene_linear_dir}")
foreach(_scene_linear_variant IN ITEMS current old_force missing_restore)
    set(_scene_linear_target test_jce_scene_render_linear)
    set(_scene_linear_kind unit)
    if(NOT _scene_linear_variant STREQUAL "current")
        string(APPEND _scene_linear_target "_${_scene_linear_variant}")
        set(_scene_linear_kind contract)
    endif()
    foreach(_scene_linear_part IN ITEMS wrapper derived)
        set(_scene_linear_content "${_scene_linear_${_scene_linear_part}}")
        if(_scene_linear_variant STREQUAL "old_force" AND _scene_linear_part STREQUAL "derived")
            set(_scene_linear_content "${_scene_linear_old_force}")
        elseif(_scene_linear_variant STREQUAL "missing_restore" AND _scene_linear_part STREQUAL "wrapper")
            set(_scene_linear_content "${_scene_linear_missing_restore}")
        endif()
        set(_scene_linear_output "${_scene_linear_dir}/${_scene_linear_variant}_${_scene_linear_part}.inc.h")
        unset(_scene_linear_previous)
        if(EXISTS "${_scene_linear_output}")
            file(READ "${_scene_linear_output}" _scene_linear_previous)
        endif()
        if(NOT _scene_linear_previous STREQUAL _scene_linear_content)
            file(WRITE "${_scene_linear_output}" "${_scene_linear_content}")
        endif()
    endforeach()
    jce_add_unit_test(${_scene_linear_target} KIND ${_scene_linear_kind}
        SOURCES test_jce_scene_render_linear.c LINK jce_core)
    target_compile_definitions(${_scene_linear_target} PRIVATE
        JCE_TEST_SCENE_LINEAR_WRAPPER_OWNER="${_scene_linear_dir}/${_scene_linear_variant}_wrapper.inc.h"
        JCE_TEST_SCENE_LINEAR_DERIVED_OWNER="${_scene_linear_dir}/${_scene_linear_variant}_derived.inc.h")
    if(NOT _scene_linear_variant STREQUAL "current")
        set_tests_properties(${_scene_linear_target} PROPERTIES WILL_FAIL TRUE)
    endif()
endforeach()
foreach(_scene_linear_variable IN ITEMS source_path source wrapper derived old_force missing_restore
    dir variant target kind part content output previous)
    unset(_scene_linear_${_scene_linear_variable})
endforeach()
unset(_scene_linear_variable)
