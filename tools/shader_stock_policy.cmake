# Built-in stock cook policy. This is not a consumer shader-name allowlist.
include_guard(GLOBAL)

function(_jce_shader_stock_require_type json expected)
    string(JSON _actual ERROR_VARIABLE _error TYPE "${json}" ${ARGN})
    if(_error OR NOT _actual STREQUAL "${expected}")
        string(JOIN "." _field ${ARGN})
        message(FATAL_ERROR "Shader stock catalogue: ${_field} must be ${expected}")
    endif()
endfunction()

function(_jce_shader_stock_catalog_digest out_sha256)
    if(DEFINED JCE_SHADER_STOCK_CATALOG)
        if(NOT IS_ABSOLUTE "${JCE_SHADER_STOCK_CATALOG}")
            message(FATAL_ERROR "JCE_SHADER_STOCK_CATALOG must be an explicit absolute file path")
        endif()
        set(_catalog "${JCE_SHADER_STOCK_CATALOG}")
    else()
        get_filename_component(_catalog
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../engine/shaders/stock_profiles.json" ABSOLUTE)
    endif()
    if(NOT EXISTS "${_catalog}" OR IS_DIRECTORY "${_catalog}")
        message(FATAL_ERROR "Shader stock catalogue is missing: ${_catalog}")
    endif()
    file(SIZE "${_catalog}" _bytes)
    if(_bytes LESS 1 OR _bytes GREATER 1048576)
        message(FATAL_ERROR "Shader stock catalogue exceeds its 1 MiB read budget")
    endif()
    file(SHA256 "${_catalog}" _sha256)
    file(READ "${_catalog}" _json)
    string(SHA256 _read_sha256 "${_json}")
    if(NOT _read_sha256 STREQUAL _sha256)
        message(FATAL_ERROR "Shader stock catalogue changed during observation")
    endif()
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_catalog}")
    endif()
    get_property(_validated GLOBAL PROPERTY "JCE_SHADER_STOCK_VALIDATED_${_sha256}")
    if(NOT _validated)
        _jce_shader_stock_require_type("${_json}" OBJECT)
        _jce_shader_stock_require_type("${_json}" NUMBER schema)
        string(JSON _schema GET "${_json}" schema)
        if(NOT _schema STREQUAL "1")
            message(FATAL_ERROR "Shader stock catalogue schema must be 1")
        endif()
        _jce_shader_stock_require_type("${_json}" STRING source_authority)
        string(JSON _authority GET "${_json}" source_authority)
        if(NOT _authority STREQUAL "contracts/shader-keywords.json")
            message(FATAL_ERROR "Shader stock catalogue source_authority is invalid")
        endif()
        _jce_shader_stock_require_type("${_json}" OBJECT profiles)
        string(JSON _profile_count LENGTH "${_json}" profiles)
        if(NOT _profile_count EQUAL 2)
            message(FATAL_ERROR "Shader stock catalogue requires full and compatibility profiles")
        endif()
        foreach(_profile IN ITEMS full compatibility)
            _jce_shader_stock_require_type("${_json}" OBJECT profiles ${_profile} cook)
            string(JSON _cook_count LENGTH "${_json}" profiles ${_profile} cook)
            if(NOT _cook_count EQUAL 4)
                message(FATAL_ERROR "Shader stock catalogue cook requires unrestricted/vertex/fragment/compute")
            endif()
            _jce_shader_stock_require_type("${_json}" BOOLEAN profiles ${_profile} cook unrestricted)
            string(JSON _unrestricted GET "${_json}" profiles ${_profile} cook unrestricted)
            if((_profile STREQUAL "full" AND NOT _unrestricted) OR
               (_profile STREQUAL "compatibility" AND _unrestricted))
                message(FATAL_ERROR "Shader stock catalogue unrestricted policy is invalid")
            endif()
            foreach(_stage IN ITEMS vertex fragment compute)
                _jce_shader_stock_require_type("${_json}" ARRAY profiles ${_profile} cook ${_stage})
                string(JSON _length LENGTH "${_json}" profiles ${_profile} cook ${_stage})
                if((_profile STREQUAL "full" OR _stage STREQUAL "compute") AND NOT _length EQUAL 0)
                    message(FATAL_ERROR "Shader stock catalogue full/compute arrays must be empty")
                endif()
                if(_profile STREQUAL "compatibility" AND NOT _stage STREQUAL "compute" AND _length EQUAL 0)
                    message(FATAL_ERROR "Shader stock catalogue compatibility graphics arrays must be nonempty")
                endif()
                if(_stage STREQUAL "vertex")
                    set(_prefix vs)
                elseif(_stage STREQUAL "fragment")
                    set(_prefix fs)
                else()
                    set(_prefix cs)
                endif()
                set(_names)
                if(_length GREATER 0)
                    math(EXPR _last "${_length} - 1")
                    foreach(_index RANGE 0 ${_last})
                        _jce_shader_stock_require_type("${_json}" STRING profiles ${_profile} cook ${_stage} ${_index})
                        string(JSON _name GET "${_json}" profiles ${_profile} cook ${_stage} ${_index})
                        if(NOT _name MATCHES "^${_prefix}_[a-z0-9_]+$" OR _name IN_LIST _names)
                            message(FATAL_ERROR "Shader stock catalogue has invalid/duplicate ${_stage} name")
                        endif()
                        list(APPEND _names "${_name}")
                    endforeach()
                endif()
                if(_profile STREQUAL "compatibility")
                    set_property(GLOBAL PROPERTY "JCE_SHADER_STOCK_${_sha256}_${_stage}" "${_names}")
                endif()
            endforeach()
        endforeach()
        set_property(GLOBAL PROPERTY "JCE_SHADER_STOCK_VALIDATED_${_sha256}" TRUE)
    endif()
    set(${out_sha256} "${_sha256}" PARENT_SCOPE)
endfunction()

# OFF retains the existing full output owner without catalogue I/O or a digest.
function(jce_shader_stock_policy_identity out_profile out_sha256)
    if(JCE_SHADER_COMPATIBILITY)
        _jce_shader_stock_catalog_digest(_sha256)
        set(${out_profile} compatibility PARENT_SCOPE)
        set(${out_sha256} "${_sha256}" PARENT_SCOPE)
    else()
        set(${out_profile} full PARENT_SCOPE)
        set(${out_sha256} "" PARENT_SCOPE)
    endif()
endfunction()

# Caller opts in only for built-in STOCK; generic consumer sources stay unrestricted.
function(jce_shader_stock_admit out_bool stem type suffix)
    if(NOT type STREQUAL "vertex" AND NOT type STREQUAL "fragment" AND NOT type STREQUAL "compute")
        message(FATAL_ERROR "Shader stock admission requires vertex, fragment or compute")
    endif()
    if(stem MATCHES "^(fs_sky_physical_compat|(vs|fs)_water_physical)$" AND
       (NOT JCE_SHADER_COMPATIBILITY OR NOT suffix STREQUAL "glsl"))
        set(${out_bool} FALSE PARENT_SCOPE)
        return()
    endif()
    if(JCE_SHADER_COMPATIBILITY AND (suffix STREQUAL "glsl" OR suffix STREQUAL "essl" OR suffix STREQUAL "essl1"))
        # These optional families were added for desktop GL 2.1. Existing
        # compatibility GLES packages retain their own admission.
        if(NOT suffix STREQUAL "glsl" AND
           stem MATCHES "^(vs|fs)_(water|foliage|foliage_shadow|foliage_cards|foliage_cards_shadow|particle|particle_expanded|grass|grass_expanded|grass_shadow)$")
            set(${out_bool} FALSE PARENT_SCOPE)
            return()
        endif()
        _jce_shader_stock_catalog_digest(_sha256)
        get_property(_names GLOBAL PROPERTY "JCE_SHADER_STOCK_${_sha256}_${type}")
        if(stem IN_LIST _names)
            set(${out_bool} TRUE PARENT_SCOPE)
        else()
            set(${out_bool} FALSE PARENT_SCOPE)
        endif()
    else()
        set(${out_bool} TRUE PARENT_SCOPE)
    endif()
endfunction()
