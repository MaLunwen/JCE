<rml>
<head><title>Debug HUD</title><style>
body {
    width: 100%;
    height: 100%;
    margin: 0;
    font-family: "JCE";
    font-size: 14dp;
    color: #f0f0f0;
}

#hud-panel {
    position: absolute;
    left: 8dp;
    top: 8dp;
    width: 360dp;
    max-width: 96%;
    padding: 6dp 8dp 6dp 8dp;
    background-color: #00000099;
    border-radius: 4dp;
}

.stat-row {
    width: 100%;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
}

.label {
    display: inline-block;
    width: 110dp;
    font-size: 14dp;
    white-space: nowrap;
}

.value {
    display: inline-block;
    width: 234dp;
    font-size: 14dp;
    color: #f0f0f0;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
}

.detail {
    width: 100%;
    padding: 0 0 4dp 0;
    font-size: 12dp;
    color: #aaaaaa;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
}

.gpu  { color: #2ecc71; }
.cpu  { color: #3498db; }
.vram { color: #9b59b6; }
.ram  { color: #e91e63; }
.api  { color: #e74c3c; }

#perf-row {
    width: 100%;
    margin-top: 4dp;
    white-space: nowrap;
}

#fps {
    display: inline-block;
    width: 110dp;
    font-size: 18dp;
    color: #f39c12;
    white-space: nowrap;
}

#frametime {
    display: inline-block;
    width: 234dp;
    font-size: 18dp;
    text-align: right;
    color: #f0f0f0;
    white-space: nowrap;
}

#frametime-row {
    width: 100%;
    margin-top: 2dp;
    white-space: nowrap;
}

#frametime-label {
    display: inline-block;
    width: 110dp;
    font-size: 12dp;
    color: #f39c12;
    white-space: nowrap;
}

#frametime-ms {
    display: inline-block;
    width: 234dp;
    font-size: 12dp;
    text-align: right;
    color: #f0f0f0;
    white-space: nowrap;
}

#frametime-graph {
    display: block;
    width: 344dp;
    height: 50dp;
    margin-top: 3dp;
    background-color: #00000088;
    border-width: 1dp;
    border-color: #ffffff18;
}

#extra-status {
    width: 100%;
    margin-top: 4dp;
    font-size: 12dp;
    color: #f1c40f;
    white-space: nowrap;
    overflow: hidden;
}

#shortcut-hints {
    position: absolute;
    left: 8dp;
    bottom: 8dp;
    font-size: 12dp;
    color: #cfc8ba;
    background-color: #00000088;
    padding: 4dp 8dp;
    border-radius: 4dp;
}
</style></head>
<body>
<div id="hud-panel">
  <div class="stat-row"><span class="label gpu">GPU</span><span id="gpu-value" class="value">&mdash;</span></div>
  <div class="stat-row"><span class="label cpu">CPU</span><span id="cpu-value" class="value">&mdash;</span></div>
  <div class="stat-row"><span class="label vram">VRAM</span><span id="vram-value" class="value">&mdash;</span></div>
  <div class="stat-row"><span class="label ram">RAM</span><span id="ram-value" class="value">&mdash;</span></div>
  <div class="stat-row"><span class="label api">API</span><span id="api-value" class="value">&mdash;</span></div>
  <div id="api-detail" class="detail">&mdash;</div>
  <div id="perf-row"><span id="fps">&mdash;</span><span id="frametime">&mdash;</span></div>
  <div id="frametime-row"><span id="frametime-label">Frametime</span><span id="frametime-ms">&mdash;</span></div>
  <div id="frametime-graph"></div>
  <div id="extra-status"></div>
</div>
<div id="shortcut-hints"></div>
</body>
</rml>
