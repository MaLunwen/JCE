/* input.jcejs -- MODULE 2 of 7: INPUT, in JavaScript.
 *
 * Reads the keyboard and writes intent.  It never moves anything: turning
 * is the snake module's job at a tick boundary, which is what makes "at
 * most one direction change per logic tick" (spec 15) true by construction
 * rather than by trying to debounce here.
 *
 * THE VERTICAL AXIS IS THE DANGEROUS PART.  The camera looks straight down
 * with screen-up = -Z (derived in tools/gen_scene.py), so:
 *
 *      UP decreases cz.        DOWN increases cz.
 *
 * This was wrong once and no automated check caught it, because every check
 * that existed was symmetric: the editor and the runtime invert together,
 * and two identically-wrong pictures compare equal. A person noticed. The
 * test that can see it now is in verify.py and it asserts an ABSOLUTE
 * direction -- press UP, require z to DECREASE -- not agreement between two
 * runs of the same code.
 *
 * NO REVERSE is enforced here as a courtesy (so a press that would reverse
 * is not even recorded) AND again in snake.lua against the direction
 * actually in effect. The second one is the one that matters: this one sees
 * the last direction it WROTE, which during a fast double-tap is not yet
 * the direction the snake is travelling.
 */

/* Keycodes, as .jirc records them. */
const K = {
    UP: 82, W: 26, DOWN: 81, S: 22, LEFT: 80, A: 4, RIGHT: 79, D: 7,
    ENTER: 40, SPACE: 44, ESC: 41, P: 19, Q: 20,
};

const INTENT_START = 1;
const INTENT_PAUSE = 2;
const INTENT_MENU = 4;

const M = {};

M.on_start = function () {
    /* find_by_name's shape is "first_and_count", and EVERY language spells
     * the pair differently: JS hands back an ARRAY [first, count], Python a
     * tuple, Java a FindByNameResult with .first, C# a .First, C an out
     * array plus a return count.  Passing the pair itself where an entity
     * belongs does not throw here -- get_position simply answers null, this
     * module returns early every frame, and the game sits in the menu
     * forever with no error in the log.  Three of the seven modules were
     * written with the wrong spelling on the first pass. */
    this.dir_e = jce.find_by_name("Direction")[0];
    this.pend_e = jce.find_by_name("Pending")[0];
    this.state_e = jce.find_by_name("GameState")[0];
    /* Edge detection: these keys act once per press, not once per frame. */
    this.wasStart = false;
    this.wasPause = false;
    this.wasMenu = false;
    /* No jce.log here: `log` is one of the eight HAND-WRITTEN bindings, so
     * each backend writes it by hand and this one has none.  Calling it
     * throws "TypeError: not a function" and on_start dies -- which cost a
     * whole run, because the failure names a line number and not the fact
     * that the binding does not exist in this language.  This module proves
     * it ran by what it writes to Pending, not by printing. */
};

M.on_update = function (dt) {
    const pend = jce.get_position(this.pend_e);
    const dir = jce.get_position(this.dir_e);
    if (!pend || !dir) { return; }

    let pdx = pend[0], intent = pend[1], pdz = pend[2];
    const dx = dir[0], dz = dir[2];

    let nx = 0, nz = 0;
    if (jce.is_key_down(K.UP) || jce.is_key_down(K.W)) { nz = -1; }
    else if (jce.is_key_down(K.DOWN) || jce.is_key_down(K.S)) { nz = 1; }
    else if (jce.is_key_down(K.LEFT) || jce.is_key_down(K.A)) { nx = -1; }
    else if (jce.is_key_down(K.RIGHT) || jce.is_key_down(K.D)) { nx = 1; }

    if (nx !== 0 || nz !== 0) {
        /* Refuse an exact reversal. A snake of length 4 that reverses eats
         * its own neck on the very next tick, which reads as a random death
         * rather than as a rule. */
        if (!(nx === -dx && nz === -dz)) { pdx = nx; pdz = nz; }
    }

    /* ENTER / SPACE: start from the menu, restart after a game over. */
    const startNow = jce.is_key_down(K.ENTER) || jce.is_key_down(K.SPACE);
    if (startNow && !this.wasStart) { intent = intent | INTENT_START; }
    this.wasStart = startNow;

    /* ESC / P: pause toggle (spec 7). */
    const pauseNow = jce.is_key_down(K.ESC) || jce.is_key_down(K.P);
    if (pauseNow && !this.wasPause) { intent = intent | INTENT_PAUSE; }
    this.wasPause = pauseNow;

    /* Q: back to the menu from a pause (spec 7).  The HUD names this
     * key, so something has to read it -- a hint that advertises a key
     * nothing handles is a lie the player discovers by pressing it. */
    const menuNow = jce.is_key_down(K.Q);
    if (menuNow && !this.wasMenu) { intent = intent | INTENT_MENU; }
    this.wasMenu = menuNow;

    jce.set_position(this.pend_e, pdx, intent, pdz);
};

return M;
