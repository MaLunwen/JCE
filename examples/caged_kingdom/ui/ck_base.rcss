/* ck_base.rcss — Shared styles for Caged Kingdom UI.
 *
 * Debug HUD and settings panel styles are provided by the engine.
 * This file only contains game-specific styles (pause menu, etc.).
 */

body {
    font-family: "Caveat";
    font-size: 28dp;
    color: white;
}

/* ================================================================
   Utility classes
   ================================================================ */

.center {
    text-align: center;
    width: 100%;
}

.title {
    font-size: 52dp;
    font-weight: bold;
}

.subtitle {
    font-size: 20dp;
    color: #888888;
}

/* Colour helpers */
.green  { color: #64ff64; }
.red    { color: #ff6464; }
.gray   { color: #808080; }
.white  { color: #ffffff; }
.yellow { color: #ffff64; }

.selected { color: #64ff64; }

/* ================================================================
   Overlay background (pause)
   ================================================================ */

.overlay-bg {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #00000080;
}

/* ================================================================
   Pause menu
   ================================================================ */

#pause-panel {
    position: absolute;
    left: 50%;
    top: 30%;
    margin-left: -180dp;
    width: 360dp;
    padding: 32dp 40dp;
    background-color: #1a1a2eE0;
    border-radius: 10dp;
    text-align: center;
}

#pause-title {
    font-size: 48dp;
    font-weight: bold;
    margin-bottom: 28dp;
}

.menu-item {
    font-size: 34dp;
    padding: 8dp 0;
    cursor: pointer;
}

.menu-item:hover {
    color: #64ff64;
}

#hint {
    margin-top: 20dp;
    font-size: 16dp;
    color: #666666;
}