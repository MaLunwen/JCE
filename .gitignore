scripts/android/app/src/main/jniLibs/
scripts/android/app/src/main/assets/

scripts/android/app/src/main/res/*
!scripts/android/app/src/main/res/drawable-nodpi/
!scripts/android/app/src/main/res/values/


build_standalone/
dist/

