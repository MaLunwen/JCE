    {
      "name": "windows-x64-asan",
      "displayName": "Desktop Windows x64 AddressSanitizer",
      "description": "Release + symbols + AddressSanitizer (catches use-after-free, OOB, leaks)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop/windows-x64-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "JCE_ENABLE_CPPCHECK": "OFF",
        "JCE_BUILD_VARIANT": "asan",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/desktop/windows-x64-conan/build/Release/generators/conan_toolchain.cmake",
        "CMAKE_C_FLAGS_RELEASE": "/MD /O1 /Ob1 /Zi /DNDEBUG /fsanitize=address /Oy- /FS /D_DISABLE_STRING_ANNOTATION=1 /D_DISABLE_VECTOR_ANNOTATION=1",
        "CMAKE_CXX_FLAGS_RELEASE": "/MD /O1 /Ob1 /Zi /DNDEBUG /fsanitize=address /Oy- /FS /D_DISABLE_STRING_ANNOTATION=1 /D_DISABLE_VECTOR_ANNOTATION=1",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/DEBUG:FULL /INCREMENTAL:NO",
