      "displayName": "Desktop Windows x64 Debug (full PDB, no inlining)",
      "description": "Debug build with full PDB, /MDd CRT, optimised for VS 2026 diagnostics",
      "inherits": "_desktop-base",
      "binaryDir": "${sourceDir}/build/desktop/windows-x64-debug",
      "toolset": {
        "value": "v143",
        "strategy": "external"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JCE_BUILD_VARIANT": "debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/desktop/windows-x64-conan/build/Debug/generators/conan_toolchain.cmake",
        "CMAKE_C_FLAGS_DEBUG": "/MDd /Zi /Ob0 /Od /RTC1 /DDEBUG /D_DEBUG /FS",
        "CMAKE_CXX_FLAGS_DEBUG": "/MDd /Zi /Ob0 /Od /RTC1 /DDEBUG /D_DEBUG /FS",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "/DEBUG:FULL /INCREMENTAL:NO",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "/DEBUG:FULL /INCREMENTAL:NO",
        "CMAKE_MODULE_LINKER_FLAGS_DEBUG": "/DEBUG:FULL /INCREMENTAL:NO"
      }
