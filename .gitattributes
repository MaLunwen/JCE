# Owned text uses LF on disk and in Git; BAT/CMD use CRLF on disk.
# Explicit attributes override a developer's core.autocrlf setting.
* text=auto eol=lf

# cmd.exe is the one consumer that genuinely wants CRLF: a batch file with
# LF-only endings can mis-parse labels and `goto` targets.
*.[bB][aA][tT] text eol=crlf
*.[cC][mM][dD] text eol=crlf

# Never rewritten, never diffed as text.  Git's NUL heuristic already catches
# most of these; naming them keeps a stray text-looking asset out of the sweep.
