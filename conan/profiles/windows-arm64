[settings]
os=Windows
arch=armv8
compiler=msvc
compiler.version=194
compiler.cppstd=17
compiler.runtime=dynamic
compiler.runtime_type=Release
build_type=Release

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
# Suppress /WX (treat-warnings-as-errors) when building Conan deps from source.
# Some packages (e.g. ozz-animation) have ARM64-specific warnings that would
# otherwise abort the build on MSVC ARM64 cross-compilation.
tools.build:cflags=["/WX-", "/D_WIN32_WINNT=0x0A00"]
tools.build:cxxflags=["/WX-", "/D_WIN32_WINNT=0x0A00"]
# zeromq POLLER/IPC fix is handled by hook_zeromq_arm64_fix.py
