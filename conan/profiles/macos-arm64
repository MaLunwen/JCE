include(base)

[settings]
os=Macos
os.version=11.0
arch=armv8
compiler=apple-clang
compiler.version=15
compiler.libcxx=libc++
compiler.cppstd=17

[conf]
tools.cmake.cmaketoolchain:extra_variables={"CMAKE_POLICY_VERSION_MINIMUM": "3.5"}
tools.build:cflags=["-mmacosx-version-min=11.0"]
tools.build:cxxflags=["-mmacosx-version-min=11.0"]
tools.build:sharedlinkflags=["-mmacosx-version-min=11.0"]
tools.build:exelinkflags=["-mmacosx-version-min=11.0"]
