include(base)

[settings]
os=Macos
os.version=10.15
arch=x86_64
compiler=apple-clang
compiler.version=14
compiler.libcxx=libc++
compiler.cppstd=20

[conf]
tools.cmake.cmaketoolchain:extra_variables={"CMAKE_POLICY_VERSION_MINIMUM": "3.5"}
tools.build:cflags=["-mmacosx-version-min=10.15"]
tools.build:cxxflags=["-mmacosx-version-min=10.15"]
tools.build:sharedlinkflags=["-mmacosx-version-min=10.15"]
tools.build:exelinkflags=["-mmacosx-version-min=10.15"]
