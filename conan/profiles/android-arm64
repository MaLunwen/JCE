[settings]
os=Android
os.api_level=24
arch=armv8
compiler=clang
compiler.version=17
compiler.libcxx=c++_shared
compiler.cppstd=17
build_type=Release

[options]
# Cross-compiling from Windows: autotools packages (xz_utils, glib, bzip2) cannot build.
# Disable dependency chains that pull them in.
freetype/*:with_bzip2=False
harfbuzz/*:with_glib=False
sdl_image/*:with_libtiff=False

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.android:ndk_path=${ANDROID_NDK_HOME}
